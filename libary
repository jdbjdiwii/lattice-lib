		end
		local inputType = input.UserInputType
		if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then
			return
		end
		local pointer = self._input:GetPointerPosition(input)
		if InputManager.Contains(controls, pointer) then
			return
		end
		self:_BeginMove(input)
	end))

	local line = Util.Create("Frame", {
		Name = "TopBarLine",
		Size = UDim2.new(1, 0, 0, 1),
		Position = UDim2.fromOffset(0, height),
		Visible = height > 0,
		ZIndex = 4,
		Parent = body,
	})
	scope:Bind(line, "BackgroundColor3", "Divider")
	scope:Bind(line, "BackgroundTransparency", "BorderTransparency")
end

function Window._CreateControlButton(
	self: any,
	icon: string,
	tooltip: (() -> string)?,
	callback: () -> (),
	order: number
): (TextButton, Maid.Maid)
	local scope: Theme.Scope = self._scope
	local maid = Maid.new()
	self._maid:Add(maid)
	local button = Util.Create("TextButton", {
		Name = icon .. "Button",
		Size = UDim2.fromOffset(28, 28),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		ZIndex = 5,
		Parent = self._controls,
	})
	Widgets.Corner(scope, button)
	local visual, recolor = Icons.Visual(icon, {
		Size = 16,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 5,
		Parent = button,
	})
	visual.ZIndex = 5
	local state = Enum.GuiState.Idle
	local function render(animate: boolean)
		local t = scope:View()
		local active = state == Enum.GuiState.Hover or state == Enum.GuiState.Press
		local goals = {
			BackgroundColor3 = if state == Enum.GuiState.Press then t.Active else t.Hover,
			BackgroundTransparency = if active then 0 else 1,
		}
		if animate then
			Animator.Play(button, goals, { Scope = scope, DurationScale = 0.6 })
		else
			Animator.Set(button, goals)
		end
		recolor(if active then t.Text else t.MutedText)
	end
	maid:Add(InputManager.TrackState(button, function(newState)
		if newState ~= state then
			state = newState
			render(true)
		end
	end))
	maid:Add(scope:Observe(function()
		render(false)
	end))
	maid:Add(button.Activated:Connect(callback))
	if tooltip then
		maid:Add(self._tooltips:Attach(button, tooltip))
	end
	-- Maids clean up newest-first: unbind before the button is destroyed.
	maid:Add(button)
	maid:Add(function()
		scope:Unbind(button)
	end)
	return button, maid
end

