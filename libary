-- Box
--------------------------------------------------------------------------------

function Dropdown._Build(self: any)
	local scope: Theme.Scope = self._scope
	local root = self:_CreateRoot()
	Util.List(root, { Padding = UDim.new(0, 6) })

	local header = Util.Create("Frame", {
		Name = "Header",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		ZIndex = 2,
		Parent = root,
	})
	Util.List(header, { FillDirection = Enum.FillDirection.Horizontal })
	self:_BuildTextBlock(header, 1)

	local box, _, stroke = Widgets.Surface(scope, {
		Background = "InputBackground",
		Properties = {
			Name = "Box",
			Size = UDim2.new(1, 0, 0, 30),
			LayoutOrder = 2,
			ZIndex = 2,
			Selectable = true,
			Parent = root,
		},
	}, "TextButton")
	scope:Bind(box, "Size", function(t)
		return UDim2.new(1, 0, 0, t.ControlHeight)
	end)
	Util.Padding(box, 0, 8, 0, 10)
	Util.List(box, {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
	})
	self._boxStroke = stroke
	self._selectedLabel = Widgets.Label(scope, {
		Color = false,
		Properties = {
			Name = "Selected",
			Size = UDim2.new(0, 0, 0, 18),
			LayoutOrder = 1,
			ZIndex = 2,
			Parent = box,
		},
	})
	Util.Fill(self._selectedLabel)
	self._chevron = Icons.Create("ChevronDown", { Size = 14, LayoutOrder = 2, ZIndex = 2, Parent = box })
	self._box = box

	self._maid:Add(box.Activated:Connect(function()
		if self._open then
			self:Close()
		else
			self:Open()
		end
	end))
	self._maid:Add(InputManager.TrackState(box, function(state)
		local hovered = state == Enum.GuiState.Hover or state == Enum.GuiState.Press
		if hovered ~= self._hovered then
			self._hovered = hovered
			self:_RenderBox(true)
		end
	end))
	self._maid:Add(scope:Observe(function()
		self:_Render(false)
	end))
end

function Dropdown._DisplayText(self: any): (string, boolean)
	if self.Multi then
		local labels = {}
		for _, value in self.Value do
			local option = self:_FindOption(value)
			table.insert(labels, if option then option.Label else tostring(value))
		end
		if #labels == 0 then
			return self.Placeholder, true
		end
		return table.concat(labels, ", "), false
	end
	if self.Value == nil then
		return self.Placeholder, true
	end
	local option = self:_FindOption(self.Value)
	return if option then option.Label else tostring(self.Value), false
end

function Dropdown._RenderBox(self: any, animate: boolean)
	local t = self._scope:View()
	local text, placeholder = self:_DisplayText()
	self._selectedLabel.Text = text
	self._selectedLabel.TextColor3 = if self.Disabled
		then t.DisabledText
		elseif placeholder then t.PlaceholderText
		else t.Text
	local strokeColor = if self.Disabled
		then t.Border
		elseif self._open then t.InputFocusBorder
		elseif self._hovered then t.Border:Lerp(t.Text, 0.15)
		else t.Border
	local background = if self.Disabled then t.Disabled else t.InputBackground
	local options = { Scope = self._scope, DurationScale = 0.8 }
	if animate then
		Animator.Play(self._boxStroke, { Color = strokeColor }, options)
		Animator.Play(self._box, { BackgroundColor3 = background }, options)
		Animator.Play(self._chevron.Frame, { Rotation = if self._open then 180 else 0 }, { Scope = self._scope })
	else
		Animator.Set(self._boxStroke, { Color = strokeColor })
		Animator.Set(self._box, { BackgroundColor3 = background })
		Animator.Set(self._chevron.Frame, { Rotation = if self._open then 180 else 0 })
	end
	self._chevron:SetColor(if self.Disabled then t.DisabledText elseif self._open then t.Text else t.MutedText)
end

function Dropdown._Render(self: any, animate: boolean)
	self:_RenderBox(animate)
	self:_RenderItems()
end

function Dropdown._OnDisabledChanged(self: any, disabled: boolean)
	self._box.Interactable = not disabled
	self._box.Selectable = not disabled
	if disabled then
		self:Close()
	end
end

