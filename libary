local Tokens: { [string]: TokenSpec } = {}
local TokenOrder: { string } = {}

for _, entry in TOKEN_LIST do
	Tokens[entry[1]] = { Type = entry[2], Default = entry[3], Description = entry[4] }
	table.insert(TokenOrder, entry[1])
end

Theme.Tokens = Tokens
Theme.TokenOrder = TokenOrder
Theme.Presets = Themes

--[[
	Registers an additional token, typically for a custom component.
	`default` may be a value or a function of the theme view.
]]
function Theme.RegisterToken(name: string, valueType: string, default: any, description: string?)
	if Tokens[name] then
		Log.warn('Theme token "%s" is already registered', name)
		return
	end
	Tokens[name] = { Type = valueType, Default = default, Description = description }
	table.insert(TokenOrder, name)
end

-- Returns `base` with a different weight, e.g. Theme.Font(t.Font, Enum.FontWeight.SemiBold).
local fontCache: { [string]: Font } = {}
function Theme.Font(base: Font, weight: Enum.FontWeight, style: Enum.FontStyle?): Font
	local key = base.Family .. "|" .. weight.Name .. "|" .. (style or base.Style).Name
	local cached: Font? = fontCache[key]
	if cached == nil then
		local created = Font.new(base.Family, weight, style or base.Style)
		fontCache[key] = created
		return created
	end
	return cached
end

-- Converts user input into the token's value type. Returns ok, value.
local function coerce(spec: TokenSpec, value: any): (boolean, any)
	if type(value) == "function" then
		return true, value
	end
	local kind = spec.Type
	if kind == "Color3" then
		local color = Util.ToColor3(value)
		return color ~= nil, color
	elseif kind == "number" then
		return type(value) == "number" and value == value, value
	elseif kind == "boolean" then
		return type(value) == "boolean", value
	elseif kind == "string" then
		return type(value) == "string", value
	elseif kind == "Font" then
		if typeof(value) == "Font" then
			return true, value
		elseif typeof(value) == "EnumItem" and (value :: EnumItem).EnumType == Enum.Font then
			return true, Font.fromEnum(value :: any)
		elseif type(value) == "string" and value ~= "" then
			if string.find(value, "^rbxasset") then
				return true, Font.new(value)
			end
			return true, Font.new("rbxasset://fonts/families/" .. value .. ".json")
		end
		return false, nil
	elseif string.sub(kind, 1, 5) == "Enum." then
		local enumName = string.sub(kind, 6)
		local enum = (Enum :: any)[enumName]
		if typeof(value) == "EnumItem" and (value :: EnumItem).EnumType == enum then
			return true, value
		elseif type(value) == "string" then
			local ok, item = pcall(function()
				return enum[value]
			end)
			if ok and typeof(item) == "EnumItem" then
				return true, item
			end
		end
		return false, nil
	end
	return typeof(value) == kind, value
end

--------------------------------------------------------------------------------
-- Scope
--------------------------------------------------------------------------------

local Scope = {}
Scope.__index = Scope

type Binding = { Instance: Instance, Property: string, Source: string | Resolver }

type Scope = typeof(setmetatable(
	{} :: {
		_parent: any,
		_overrides: { [string]: any },
		_cache: { [string]: any },
		_children: { [any]: boolean },
		_bindings: { Binding },
		_observers: { (View) -> () },
		_resolving: { [string]: boolean },
		_destroyed: boolean,
		_view: View,
	},
	Scope
))

local function newScope(parent: Scope?): Scope
	local self: any = setmetatable({
		_parent = parent,
		_overrides = {},
		_cache = {},
		_children = {},
		_bindings = {},
		_observers = {},
		_resolving = {},
		_destroyed = false,
	}, Scope)
	self._view = setmetatable({}, {
		__index = function(_, token)
			return self:Get(token)
		end,
		__newindex = function()
			error("Theme views are read-only; use SetTheme to change tokens", 2)
		end,
	})
	if parent then
		parent._children[self] = true
	end
	return self
end

function Theme.newRoot(): Scope
	return newScope(nil)
end

-- Creates a child scope that inherits every token from this one.
function Scope.Extend(self: Scope): Scope
	return newScope(self)
end

-- Resolves a token in this scope.
function Scope.Get(self: Scope, token: string): any
	local cached = self._cache[token]
	if cached ~= nil then
		return cached
	end

	local spec = Tokens[token]
	if spec == nil then
		Log.warn('Unknown theme token "%s"', token)
		return nil
	end

	local value: any = nil
	local scope: any = self
	while scope do
		local override = scope._overrides[token]
		if override ~= nil then
			value = override
			break
		end
		scope = scope._parent
	end
	if value == nil then
		value = spec.Default
	end

	if type(value) == "function" then
		if self._resolving[token] then
			error(string.format('theme token "%s" depends on itself', token), 0)
		end
		self._resolving[token] = true
		local ok, result = pcall(value, self._view)
		self._resolving[token] = nil
		if ok and result ~= nil then
			value = result
		else
			Log.warn('Theme token "%s" failed to resolve (%s); using its default', token, tostring(result))
			value = spec.Default
			if type(value) == "function" then
				value = value(self._view)
			end
		end
	end

	self._cache[token] = value
	return value
end

-- A read-only table view of this scope: view.Accent, view.CornerRadius...
function Scope.View(self: Scope): View
	return self._view
end

--[[
	Applies token overrides to this scope and refreshes everything that depends
	on it. Values are validated; invalid entries are reported and skipped.
	When `replace` is true, existing overrides are cleared first.
]]
function Scope.Set(self: Scope, overrides: { [string]: any }, replace: boolean?)
	if type(overrides) ~= "table" then
		Log.warn("SetTheme expects a table of tokens, got %s", typeof(overrides))
		return
	end
	if replace then
		table.clear(self._overrides)
	end
	for token, value in overrides do
		local spec = Tokens[token]
		if spec == nil then
			local suggestion = Options.Suggest(tostring(token), Tokens)
			if suggestion then
				Log.warn('Unknown theme token "%s" (did you mean "%s"?)', tostring(token), suggestion)
			else
				Log.warn('Unknown theme token "%s"', tostring(token))
			end
			continue
		end
		local ok, coerced = coerce(spec, value)
		if ok then
			self._overrides[token] = coerced
		else
			Log.warn('Theme token "%s" expects %s, got %s', token, spec.Type, typeof(value))
		end
	end
	self:Refresh()
end

-- Removes overrides from this scope (all of them when `tokens` is nil).
function Scope.Reset(self: Scope, tokens: { string }?)
	if tokens then
		for _, token in tokens do
			self._overrides[token] = nil
		end
	else
		table.clear(self._overrides)
	end
	self:Refresh()
end

function Scope.GetOverrides(self: Scope): { [string]: any }
	return table.clone(self._overrides)
end

local function apply(scope: Scope, binding: Binding)
	local source = binding.Source
	local value
	if type(source) == "function" then
		value = source(scope._view)
	else
		value = scope:Get(source)
	end
	if value ~= nil then
		(binding.Instance :: any)[binding.Property] = value
	end
end

--[[
	Binds an instance property to a token (or a function of the theme view).
	The property is set immediately and again whenever the theme changes.
]]
function Scope.Bind(self: Scope, instance: Instance, property: string, source: string | Resolver)
	local binding = { Instance = instance, Property = property, Source = source }
	table.insert(self._bindings, binding)
	apply(self, binding)
end

-- Binds several properties of one instance: scope:BindMany(label, { TextColor3 = "Text" }).
function Scope.BindMany(self: Scope, instance: Instance, map: { [string]: string | Resolver })
	for property, source in map do
		self:Bind(instance, property, source)
	end
end

-- Drops every binding that targets `instance` (or a descendant of it).
function Scope.Unbind(self: Scope, instance: Instance)
	local bindings = self._bindings
	for index = #bindings, 1, -1 do
		local target = bindings[index].Instance
		if target == instance or target:IsDescendantOf(instance) then
			table.remove(bindings, index)
		end
	end
end

--[[
	Registers a callback that runs on every theme refresh. Used for visuals
	that depend on both the theme and component state (e.g. a toggle's track
	colour). Returns a function that removes the observer.
]]
function Scope.Observe(self: Scope, callback: (View) -> (), runNow: boolean?): () -> ()
	table.insert(self._observers, callback)
	if runNow ~= false then
		callback(self._view)
	end
	return function()
		local index = table.find(self._observers, callback)
		if index then
			table.remove(self._observers, index)
		end
	end
end

-- Re-resolves tokens and re-applies bindings here and in all descendant scopes.
function Scope.Refresh(self: Scope)
	if self._destroyed then
		return
	end
	table.clear(self._cache)
	for _, binding in self._bindings do
		apply(self, binding)
	end
	for _, observer: any in table.clone(self._observers) do
		local ok, err = pcall(observer, self._view)
		if not ok then
			Log.handlerError(err, "theme observer")
		end
	end
	for child in self._children do
		child:Refresh()
	end
end

-- Snapshot of every resolved token in this scope.
function Scope.Resolve(self: Scope): { [string]: any }
	local result = {}
	for _, token in TokenOrder do
		result[token] = self:Get(token)
	end
	return result
end

function Scope.Destroy(self: Scope)
	if self._destroyed then
		return
	end
	self._destroyed = true
	if self._parent then
		self._parent._children[self] = nil
	end
	for child in table.clone(self._children) do
		child:Destroy()
	end
	table.clear(self._children)
	table.clear(self._bindings)
	table.clear(self._observers)
	table.clear(self._cache)
end

Theme.Scope = Scope

return Theme
end

-- ThemeSection ----------------------------------------------------------------
definitions["ThemeSection"] = function(...)
--[[
	ThemeSection

	A ready-made section for editing the global theme live, built only from the
	public API:

	    Lattice:CreateThemeSection(SettingsTab, { Side = "Left" })

	It contains a preset picker, colour pickers for the main palette, shape and
	typography sliders, and animation controls. Its controls have flags, so
	the theme is saved and restored with configs.
]]

local Log = import("Log")
local Options = import("Options")
local Util = import("Util")

local ThemeSection = {}

local SCHEMA: Options.Schema = {
	Name = { Type = "string", Default = "Appearance" },
	Description = { Type = "string", Default = "Customise colours, shape and motion." },
	Side = { Type = "string|number" },
	Colors = { Type = "table" },
}

local DEFAULT_COLORS = { "Accent", "Background", "Secondary", "Tertiary", "Text", "MutedText", "Border" }

-- "MutedText" -> "Muted text"
local function humanize(token: string): string
	local spaced = string.gsub(token, "(%l)(%u)", "%1 %2")
	return string.sub(spaced, 1, 1) .. string.lower(string.sub(spaced, 2))
end

function ThemeSection.Build(library: any, tab: any, rawOptions: any): any
	if type(tab) ~= "table" or type(tab.CreateSection) ~= "function" then
		Log.warn("CreateThemeSection expects a tab")
		return nil
	end
	local options = Options.Resolve("CreateThemeSection", rawOptions, SCHEMA)
	local colors = options.Colors or DEFAULT_COLORS
	local theme = library:GetTheme()

	local section = tab:CreateSection({
		Name = options.Name,
		Description = options.Description,
		Side = options.Side,
	})

	-- Coalesce rapid changes (e.g. dragging a colour) into one refresh per frame.
	local pending: { [string]: any } = {}
	local scheduled = false
	local function queue(token: string, value: any)
		pending[token] = value
		if scheduled then
			return
		end
		scheduled = true
		task.defer(function()
			scheduled = false
			local batch = pending
			pending = {}
			library:SetTheme(batch)
		end)
	end

	local pickers: { [string]: any } = {}
	local sliders: { [string]: any } = {}
	local animations

	-- Shows the current theme without running callbacks. Controls that already
	-- match are left alone, so a colour being dragged keeps its hue.
	local function sync()
		local current = library:GetTheme()
		for token, picker in pickers do
			if Util.ToHex(picker:GetValue()) ~= Util.ToHex(current[token]) then
				picker:SetValue(current[token], true)
			end
		end
		for token, slider in sliders do
			slider:SetValue(current[token], true)
		end
		animations:SetValue(current.AnimationsEnabled, true)
	end

	local preset = section:AddDropdown({
		Name = "Preset",
		Values = library:GetThemes(),
		Default = "Default",
		Flag = "Lattice/Theme/Preset",
		Callback = function(name: string)
			library:SetTheme(name)
			sync()
		end,
	})

	for _, token in colors do
		if theme[token] == nil or typeof(theme[token]) ~= "Color3" then
			Log.warn('CreateThemeSection: "%s" is not a colour token', tostring(token))
			continue
		end
		pickers[token] = section:AddColorPicker({
			Name = humanize(token),
			Default = theme[token],
			Flag = "Lattice/Theme/" .. token,
			Callback = function(color: Color3)
				queue(token, color)
			end,
		})
	end

	local function slider(token: string, name: string, min: number, max: number, rounding: number, suffix: string?)
		sliders[token] = section:AddSlider({
			Name = name,
			Min = min,
			Max = max,
			Rounding = rounding,
			Default = theme[token],
			Suffix = suffix or "",
			Flag = "Lattice/Theme/" .. token,
			Callback = function(value: number)
				queue(token, value)
			end,
		})
	end

	slider("CornerRadius", "Corner radius", 0, 14, 0, "px")
	slider("TextSize", "Text size", 11, 18, 0, "px")
	slider("BackgroundTransparency", "Window transparency", 0, 0.6, 2)

	animations = section:AddToggle({
		Name = "Animations",
		Default = theme.AnimationsEnabled,
		Flag = "Lattice/Theme/AnimationsEnabled",
		Callback = function(enabled: boolean)
			library:SetAnimation({ Enabled = enabled })
		end,
	})
	slider("AnimationDuration", "Animation speed", 0.05, 0.5, 2, "s")

	section:AddButton({
		Name = "Reset theme",
		Callback = function()
			library:ResetTheme()
			preset:SetValue("Default", true)
			sync()
		end,
	})

	-- Theme changes made elsewhere (SetTheme from scripts) show up here too.
	local connection = library.ThemeChanged:Connect(function()
		if not scheduled then
			sync()
		end
	end)
	section.Destroying:Connect(function()
		connection:Disconnect()
	end)

	return section
end

return ThemeSection
end

