function ColorPicker._BuildPanel(self: any)
	if self._panelHolder then
		return
	end
	local scope: Theme.Scope = self._scope
	local maid = Maid.new()
	self._maid:Add(maid)

	local holder = Util.Create("Frame", {
		Name = "ColorPickerPanel",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(PANEL_WIDTH, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		ZIndex = 20,
	})
	maid:Add(holder)
	maid:Add(function()
		scope:Unbind(holder)
	end)
	local _, setShadow = Widgets.Shadow(scope, holder, "WindowCornerRadius", 20)
	self._setPanelShadow = setShadow

	local panel = Util.Create("CanvasGroup", {
		Name = "Panel",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		GroupTransparency = 1,
		ZIndex = 21,
		Parent = holder,
	})
	scope:Bind(panel, "BackgroundColor3", "DropdownBackground")
	Widgets.Corner(scope, panel, "WindowCornerRadius")
	Util.Padding(panel, 10)
	Util.List(panel, { Padding = UDim.new(0, 8) })
	self._panel = panel

	local border = Util.Create("Frame", {
		Name = "Border",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 22,
		Parent = holder,
	})
	Widgets.Corner(scope, border, "WindowCornerRadius")
	self._panelBorder = Util.Create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Transparency = 1,
		Parent = border,
	})
	scope:Bind(self._panelBorder, "Color", "Border")
	scope:Bind(self._panelBorder, "Thickness", "StrokeThickness")

	Widgets.Label(scope, {
		Text = self.Name,
		Style = "Small",
		Weight = Enum.FontWeight.Medium,
		Color = "MutedText",
		Properties = {
			Name = "Title",
			Size = UDim2.new(1, 0, 0, 14),
			LayoutOrder = 1,
			ZIndex = 21,
			Parent = panel,
		},
	})

	-- Saturation / value area and hue strip.
	local row = Util.Create("Frame", {
		Name = "Picker",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, AREA_HEIGHT),
		LayoutOrder = 2,
		ZIndex = 21,
		Parent = panel,
	})
	Util.List(row, { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) })

	local area = Util.Create("TextButton", {
		Name = "SaturationValue",
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundTransparency = 0,
		LayoutOrder = 1,
		ZIndex = 21,
		Parent = row,
	})
	Util.Fill(area)
	Util.Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = area })
	local white = Util.Create("Frame", {
		Name = "Saturation",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 21,
		Parent = area,
	})
	Util.Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = white })
	Util.Create("UIGradient", {
		Transparency = NumberSequence.new(0, 1),
		Parent = white,
	})
	local black = Util.Create("Frame", {
		Name = "Value",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		ZIndex = 22,
		Parent = area,
	})
	Util.Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = black })
	Util.Create("UIGradient", {
		Transparency = NumberSequence.new(1, 0),
		Rotation = 90,
		Parent = black,
	})
	local cursor = Util.Create("Frame", {
		Name = "Cursor",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundTransparency = 1,
		ZIndex = 23,
		Parent = area,
	})
	Util.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = cursor })
	Util.Create("UIStroke", {
		Color = Color3.new(1, 1, 1),
		Thickness = 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = cursor,
	})
	self._area = area
	self._areaCursor = cursor

	local hue = Util.Create("TextButton", {
		Name = "Hue",
		Size = UDim2.new(0, STRIP_WIDTH, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0,
		LayoutOrder = 2,
		ZIndex = 21,
		Parent = row,
	})
	Util.Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = hue })
	Util.Create("UIGradient", { Color = hueSequence(), Rotation = 90, Parent = hue })
	local hueCursor = Util.Create("Frame", {
		Name = "Cursor",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(1, 4, 0, 4),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 23,
		Parent = hue,
	})
	Util.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = hueCursor })
	Util.Create("UIStroke", {
		Color = Color3.new(0, 0, 0),
		Transparency = 0.6,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = hueCursor,
	})
	self._hueStrip = hue
	self._hueCursor = hueCursor

	-- Transparency strip.
	if self.HasTransparency then
		local alpha = Util.Create("TextButton", {
			Name = "Transparency",
			Size = UDim2.new(1, 0, 0, ALPHA_HEIGHT),
			BackgroundTransparency = 1,
			LayoutOrder = 3,
			ZIndex = 21,
			Parent = panel,
		})
		buildChecker(alpha, 26, 2, 21)
		local colorStrip = Util.Create("Frame", {
			Name = "Color",
			Size = UDim2.fromScale(1, 1),
			ZIndex = 22,
			Parent = alpha,
		})
		Util.Create("UIGradient", { Transparency = NumberSequence.new(1, 0), Parent = colorStrip })
		local alphaCursor = Util.Create("Frame", {
			Name = "Cursor",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.new(0, 4, 1, 4),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 23,
			Parent = alpha,
		})
		Util.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = alphaCursor })
		Util.Create("UIStroke", {
			Color = Color3.new(0, 0, 0),
			Transparency = 0.6,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = alphaCursor,
		})
		self._alphaStrip = alpha
		self._alphaColor = colorStrip
		self._alphaCursor = alphaCursor
		maid:Add(alpha.InputBegan:Connect(function(input: InputObject)
			self:_DragStrip(input, alpha, function(fraction: number)
				self:_ApplyHSV(self._h, self._s, self._v, 1 - fraction, false)
			end, true)
		end))
	end

	-- Hex and RGB fields.
	local fields = Util.Create("Frame", {
		Name = "Fields",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, FIELD_HEIGHT),
		LayoutOrder = 4,
		ZIndex = 21,
		Parent = panel,
	})
	Util.List(fields, {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
	})
	local function field(name: string, order: number, width: number?): TextBox
		local box, _, _ = Widgets.Surface(scope, {
			Background = "InputBackground",
			Properties = {
				Name = name,
				Size = UDim2.new(0, width or 0, 1, 0),
				LayoutOrder = order,
				ZIndex = 21,
				Parent = fields,
			},
		})
		if width == nil then
			Util.Fill(box)
		end
		Util.Padding(box, 0, 6, 0, 6)
		local text = Widgets.Label(scope, {
			Style = "Small",
			Properties = {
				Name = "Text",
				Size = UDim2.fromScale(1, 1),
				TextXAlignment = Enum.TextXAlignment.Center,
				ClearTextOnFocus = false,
				ZIndex = 21,
				Parent = box,
			},
		}, "TextBox")
		return text
	end
	local hexBox = field("Hex", 1, nil)
	local redBox = field("R", 2, 38)
	local greenBox = field("G", 3, 38)
	local blueBox = field("B", 4, 38)
	self._hexBox, self._rgbBoxes = hexBox, { redBox, greenBox, blueBox }

	maid:Add(hexBox.FocusLost:Connect(function()
		local color = Util.ToColor3(hexBox.Text)
		if color then
			self:SetValue(color)
		end
		self:_RenderFields()
	end))
	for index, box in self._rgbBoxes do
		maid:Add(box.FocusLost:Connect(function()
			local number = tonumber(box.Text)
			if number then
				local r, g, b = self:GetRGB()
				local channels = { r, g, b }
				channels[index] = math.clamp(math.floor(number + 0.5), 0, 255)
				self:SetValueRGB(channels[1], channels[2], channels[3])
			end
			self:_RenderFields()
		end))
	end

	maid:Add(area.InputBegan:Connect(function(input: InputObject)
		self:_DragArea(input)
	end))
	maid:Add(hue.InputBegan:Connect(function(input: InputObject)
		self:_DragStrip(input, hue, function(fraction: number)
			self:_ApplyHSV(fraction, self._s, self._v, nil, false)
		end, false)
	end))

	self._panelHolder = holder
	self:_RenderPanel()
end

function ColorPicker._DragArea(self: any, input: InputObject)
	local inputType = input.UserInputType
	if
		self.Disabled
		or not self._open
		or (inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch)
	then
		return
	end
	local area: GuiObject = self._area
	local function update(position: Vector2)
		local size = area.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 then
			return
		end
		local relative = position - area.AbsolutePosition
		local saturation = math.clamp(relative.X / size.X, 0, 1)
		local value = 1 - math.clamp(relative.Y / size.Y, 0, 1)
		self:_ApplyHSV(self._h, saturation, value, nil, false)
	end
	local manager = self._context.Input
	if manager:BeginDrag(input, { Move = update }) then
		update(manager:GetPointerPosition(input))
	end
end

function ColorPicker._DragStrip(
	self: any,
	input: InputObject,
	strip: GuiObject,
	apply: (number) -> (),
	horizontal: boolean
)
	local inputType = input.UserInputType
	if
		self.Disabled
		or not self._open
		or (inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch)
	then
		return
	end
	local function update(position: Vector2)
		local size = strip.AbsoluteSize
		local relative = position - strip.AbsolutePosition
		local fraction = if horizontal
			then math.clamp(relative.X / math.max(size.X, 1), 0, 1)
			else math.clamp(relative.Y / math.max(size.Y, 1), 0, 1)
		apply(fraction)
	end
	local manager = self._context.Input
	if manager:BeginDrag(input, { Move = update }) then
		update(manager:GetPointerPosition(input))
	end
end

function ColorPicker._RenderFields(self: any)
	if self._hexBox == nil then
		return
	end
	if not self._hexBox:IsFocused() then
		self._hexBox.Text = "#" .. self:GetHex()
	end
	local channels = { self:GetRGB() }
	for index, box in self._rgbBoxes do
		if not box:IsFocused() then
			box.Text = tostring(channels[index])
		end
	end
end

function ColorPicker._RenderPanel(self: any)
	if self._panelHolder == nil then
		return
	end
	self._area.BackgroundColor3 = Color3.fromHSV(self._h, 1, 1)
	self._areaCursor.Position = UDim2.fromScale(self._s, 1 - self._v)
	local cursorStroke = self._areaCursor:FindFirstChildOfClass("UIStroke")
	if cursorStroke then
		cursorStroke.Color = if self._v > 0.55 and self._s < 0.45 then Color3.new(0, 0, 0) else Color3.new(1, 1, 1)
	end
	self._hueCursor.Position = UDim2.fromScale(0.5, self._h)
	if self._alphaStrip then
		self._alphaColor.BackgroundColor3 = self.Value
		self._alphaCursor.Position = UDim2.fromScale(1 - self.Transparency, 0.5)
	end
	self:_RenderFields()
end

function ColorPicker._Render(self: any, animate: boolean)
	self:_RenderSwatch(animate)
	self:_RenderPanel()
end

function ColorPicker.Open(self: any)
	if self._open or self.Disabled or self._destroyed then
		return
	end
	self:_BuildPanel()
	self._open = true
	self:_SetFieldsInteractable(true)
	self:_RenderPanel()
	local panel: CanvasGroup = self._panel
	self._context.Popups:Open({
		Frame = self._panelHolder,
		Anchor = self._swatch,
		Placement = "Below",
		Align = "End",
		Gap = 6,
		Owner = self,
		OnClose = function()
			self:_OnPanelClosed()
		end,
	})
	panel.Position = UDim2.fromOffset(0, -4)
	Animator.Play(panel, { GroupTransparency = 0, Position = UDim2.new() }, { Scope = self._scope })
	Animator.Play(self._panelBorder, { Transparency = self._scope:Get("BorderTransparency") }, { Scope = self._scope })
	self._setPanelShadow(1, true)
	self:_RenderSwatch(true)
end

function ColorPicker._SetFieldsInteractable(self: any, interactable: boolean)
	for _, box in { self._hexBox, table.unpack(self._rgbBoxes or {}) } do
		if box then
			if not interactable and box:IsFocused() then
				box:ReleaseFocus()
			end
			box.Interactable = interactable
		end
	end
end

function ColorPicker._OnPanelClosed(self: any)
	self._open = false
	local holder: Frame = self._panelHolder
	-- The panel fades out but no longer reacts to input.
	self:_SetFieldsInteractable(false)
	self._setPanelShadow(0, true)
	Animator.Play(self._panelBorder, { Transparency = 1 }, { Scope = self._scope, DurationScale = 0.7 })
	Animator.Play(self._panel, { GroupTransparency = 1 }, {
		Scope = self._scope,
		DurationScale = 0.7,
		OnComplete = function()
			if not self._open then
				holder.Visible = false
			end
		end,
	})
	if not self._destroyed then
		self:_RenderSwatch(true)
	end
end

function ColorPicker.Close(self: any)
	if self._open then
		self._context.Popups:Close(self)
	end
end

function ColorPicker.IsOpen(self: any): boolean
	return self._open
end

function ColorPicker._OnDisabledChanged(self: any, disabled: boolean)
	self._swatch.Interactable = not disabled
	self._swatch.Selectable = not disabled
	if disabled then
		self:Close()
	end
end

return ColorPicker
end

-- Config ----------------------------------------------------------------------
definitions["Config"] = function(...)
--[[
	Config

	Optional save/load of component values. It knows nothing about visuals: it
	talks to components only through their Serialize/Deserialize methods and to
	storage only through an adapter (see ConfigStorage).

	    Lattice.Config:Save("Default")              -- returns ok, err
	    Lattice.Config:Load("Default")
	    Lattice.Config:List()                       -- { "Default", ... }
	    Lattice.Config:Delete("Default")
	    Lattice.Config:SetAutoload("Default")       -- remembered in storage
	    Lattice.Config:LoadAutoload()
	    Lattice.Config:SetAutoSave("Default")       -- save shortly after any change
	    Lattice.Config:SetFolder("MyScript")        -- where config files go

	Every value component (Toggle, Slider, Dropdown, Input, Keybind,
	ColorPicker) is saved under its Flag. Components without an explicit Flag
	get one from their location, e.g. "Main/Settings/Enabled". Pass
	Save = false to exclude a component. Explicit flags are recommended for
	configs that must survive renaming tabs or sections.

	Data is stored as JSON: { "Version": 1, "Flags": { [flag]: value } }.
	In an executor with file functions, configs are files in the workspace
	folder ("Lattice" by default); elsewhere they last for the session.
]]

local HttpService = game:GetService("HttpService")

local Log = import("Log")
local Signal = import("Signal")

local ConfigStorage = import("ConfigStorage")

local Config = {}
Config.__index = Config

local FORMAT_VERSION = 1
local AUTOLOAD_KEY = "__autoload"
local AUTOSAVE_DELAY = 1
local MAX_NAME_LENGTH = 50

-- Normalises and validates a config name. Returns ok, name-or-error.
function Config.ValidateName(name: any): (boolean, string)
	if type(name) ~= "string" then
		return false, "Config name must be a string"
	end
	local trimmed = string.match(name, "^%s*(.-)%s*$") or ""
	if trimmed == "" then
		return false, "Config name cannot be empty"
	end
	if #trimmed > MAX_NAME_LENGTH then
		return false, string.format("Config name must be at most %d characters", MAX_NAME_LENGTH)
	end
	if string.sub(trimmed, 1, 2) == "__" then
		return false, 'Config names cannot start with "__"'
	end
	if string.find(trimmed, "[^%w%s%-_%.%(%)]") then
		return false, "Config names may only contain letters, numbers, spaces and - _ . ( )"
	end
	return true, trimmed
end

function Config.new(library: any)
	local self = setmetatable({
		Storage = ConfigStorage,
		Saved = Signal.new("Config.Saved"),
		Loaded = Signal.new("Config.Loaded"),
		_library = library,
		_storage = if ConfigStorage.HasFiles() then ConfigStorage.Files() else ConfigStorage.Memory(),
		_autosave = nil :: string?,
		_autosavePending = false,
		_autosaveThread = nil :: thread?,
		_applying = false,
	}, Config)
	return self
end

--[[
	Replaces the storage adapter. Accepts any table implementing
	Read/Write/Delete/List (see ConfigStorage).
]]
function Config.SetStorage(self: any, adapter: any)
	if not ConfigStorage.IsAdapter(adapter) then
		Log.warn("Config:SetStorage expects an adapter with Read, Write, Delete and List methods")
		return
	end
	self._storage = adapter
end

function Config.GetStorage(self: any): any
	return self._storage
end

--[[
	Keeps config files in `folder` (inside the executor's workspace folder),
	for example "MyScript" or "MyScript/" .. game.PlaceId. Without file
	functions configs stay in memory and this does nothing.
]]
function Config.SetFolder(self: any, folder: string)
	if type(folder) ~= "string" or string.match(folder, "^[%s/\\]*$") then
		Log.warn("Config:SetFolder expects a folder name")
		return
	end
	if string.find(folder, "%.%.") then
		Log.warn('Config:SetFolder: ".." is not allowed in folder names')
		return
	end
	self._folder = folder
	if ConfigStorage.HasFiles() then
		self._storage = ConfigStorage.Files(folder)
	end
end

-- The folder set with SetFolder (or the default, "Lattice").
function Config.GetFolder(self: any): string
	return self._folder or "Lattice"
end

--------------------------------------------------------------------------------
-- Snapshots
--------------------------------------------------------------------------------

local function isSaved(component: any): boolean
	local class = getmetatable(component)
	return type(class) == "table"
		and class.Serializable == true
		and component.Options.Save ~= false
		and not component._destroyed
end

-- Current values of every saved component, keyed by flag.
function Config.Snapshot(self: any): { [string]: any }
	local values = {}
	for flag, component in self._library.Flags do
		if isSaved(component) then
			local ok, value = pcall(component.Serialize, component)
			if ok and value ~= nil then
				values[flag] = value
			elseif not ok then
				Log.warn('Config: could not serialise "%s": %s', flag, tostring(value))
			end
		end
	end
	return values
end

--[[
	Applies a snapshot. Unknown flags are ignored and invalid values are
	skipped. Returns the number of applied values and a list of problems.
]]
function Config.Apply(self: any, values: { [string]: any }): (number, { string })
	-- Apply in creation order so values that depend on earlier ones (for
	-- example a theme preset followed by individual colours) resolve the
	-- same way every time.
	local targets = {}
	for flag, value in values do
		local component = self._library.Flags[flag]
		if component and isSaved(component) then
			table.insert(targets, { Flag = flag, Component = component, Value = value })
		end
	end
	table.sort(targets, function(a, b)
		return (a.Component._flagOrder or 0) < (b.Component._flagOrder or 0)
	end)
	local applied, problems = 0, {}
	self._applying = true
	for _, target in targets do
		local ok, success, reason = pcall(target.Component.Deserialize, target.Component, target.Value)
		if ok and success then
			applied += 1
		else
			table.insert(problems, string.format("%s (%s)", target.Flag, tostring(if ok then reason else success)))
		end
	end
	self._applying = false
	return applied, problems
end

function Config.Encode(self: any): string
	return HttpService:JSONEncode({ Version = FORMAT_VERSION, Flags = self:Snapshot() })
end

local function decode(data: string): (boolean, any)
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, data)
	if not ok or type(decoded) ~= "table" then
		return false, "the data is not valid JSON"
	end
	if type(decoded.Flags) ~= "table" then
		return false, "the data is not a Lattice config"
	end
	if type(decoded.Version) == "number" and decoded.Version > FORMAT_VERSION then
		return false, "the config was made by a newer version of Lattice"
	end
	return true, decoded.Flags
end

--------------------------------------------------------------------------------
-- Named configs
--------------------------------------------------------------------------------

--[[
	Saves the current values under `name`. Overwrites an existing config unless
	`overwrite` is false. Returns ok, error.
]]
function Config.Save(self: any, name: string, overwrite: boolean?): (boolean, string?)
	local valid, normalized = Config.ValidateName(name)
	if not valid then
		return false, normalized
	end
	if overwrite == false and self:Exists(normalized) then
		return false, string.format('A config named "%s" already exists', normalized)
	end
	local ok, err = self._storage:Write(normalized, self:Encode())
	if not ok then
		return false, "Could not save: " .. tostring(err)
	end
	self.Saved:Fire(normalized)
	return true, nil
end

-- Loads a saved config. Returns ok, error.
function Config.Load(self: any, name: string): (boolean, string?)
	local valid, normalized = Config.ValidateName(name)
	if not valid then
		return false, normalized
	end
	local ok, data = self._storage:Read(normalized)
	if not ok then
		return false, string.format('Could not load "%s": %s', normalized, tostring(data))
	end
	if type(data) ~= "string" then
		return false, "Stored config data is invalid"
	end
	local decoded, values = decode(data)
	if not decoded then
		return false, string.format('Could not load "%s": %s', normalized, values)
	end
	local _, problems = self:Apply(values)
	if #problems > 0 then
		Log.warn('Config "%s": skipped %d invalid value(s): %s', normalized, #problems, table.concat(problems, ", "))
	end
	self.Loaded:Fire(normalized)
	return true, nil
end

function Config.Delete(self: any, name: string): (boolean, string?)
	local valid, normalized = Config.ValidateName(name)
	if not valid then
		return false, normalized
	end
	local ok, err = self._storage:Delete(normalized)
	if not ok then
		return false, string.format('Could not delete "%s": %s', normalized, tostring(err))
	end
	if self:GetAutoload() == normalized then
		self:SetAutoload(nil)
	end
	return true, nil
end

-- Saved config names, sorted alphabetically.
function Config.List(self: any): { string }
	local ok, names = self._storage:List()
	if not ok or type(names) ~= "table" then
		if not ok then
			Log.warn("Config:List failed: %s", tostring(names))
		end
		return {}
	end
	local result = {}
	for _, name in names do
		if type(name) == "string" and string.sub(name, 1, 2) ~= "__" then
			table.insert(result, name)
		end
	end
	table.sort(result, function(a, b)
		return string.lower(a) < string.lower(b)
	end)
	return result
end

function Config.Exists(self: any, name: string): boolean
	local valid, normalized = Config.ValidateName(name)
	if not valid then
		return false
	end
	return table.find(self:List(), normalized) ~= nil
end

--------------------------------------------------------------------------------
-- Import / export
--------------------------------------------------------------------------------

-- JSON for the current values (or for a saved config when `name` is given).
function Config.Export(self: any, name: string?): string?
	if name == nil then
		return self:Encode()
	end
	local valid, normalized = Config.ValidateName(name)
	if not valid then
		Log.warn("Config:Export: %s", normalized)
		return nil
	end
	local ok, data = self._storage:Read(normalized)
	return if ok and type(data) == "string" then data else nil
end

-- Applies JSON produced by Export. Returns ok, error.
function Config.Import(self: any, json: string): (boolean, string?)
	if type(json) ~= "string" then
		return false, "Import expects a JSON string"
	end
	local decoded, values = decode(json)
	if not decoded then
		return false, values
	end
	local _, problems = self:Apply(values)
	if #problems > 0 then
		Log.warn("Config import: skipped %d invalid value(s): %s", #problems, table.concat(problems, ", "))
	end
	return true, nil
end

--------------------------------------------------------------------------------
-- Autoload / autosave
--------------------------------------------------------------------------------

function Config.SetAutoload(self: any, name: string?): (boolean, string?)
	if name == nil then
		local ok, err = self._storage:Delete(AUTOLOAD_KEY)
		if not ok and err ~= "not found" then
			return false, tostring(err)
		end
		return true, nil
	end
	local valid, normalized = Config.ValidateName(name)
	if not valid then
		return false, normalized
	end
	local ok, err = self._storage:Write(AUTOLOAD_KEY, normalized)
	if not ok then
		return false, tostring(err)
	end
	return true, nil
end

function Config.GetAutoload(self: any): string?
	local ok, name = self._storage:Read(AUTOLOAD_KEY)
	if ok and type(name) == "string" and name ~= "" then
		return name
	end
	return nil
end

-- Loads the autoload config if one is set. Returns ok, error-or-nil.
function Config.LoadAutoload(self: any): (boolean, string?)
	local name = self:GetAutoload()
	if name == nil then
		return false, "No autoload config is set"
	end
	return self:Load(name)
end

--[[
	Saves to `name` about a second after any saved value changes (changes are
	batched). Pass false/nil to turn auto-saving off.
]]
function Config.SetAutoSave(self: any, name: (string | boolean)?)
	if name == nil or name == false then
		self._autosave = nil
		self:_CancelAutosave()
		return
	end
	local valid, normalized = Config.ValidateName(name)
	if not valid then
		Log.warn("Config:SetAutoSave: %s", normalized)
		return
	end
	self._autosave = normalized
end

-- Called by components after a user-visible value change.
function Config._OnValueChanged(self: any, component: any)
	if self._autosave == nil or self._applying or self._autosavePending then
		return
	end
	if not isSaved(component) then
		return
	end
	self._autosavePending = true
	self._autosaveThread = task.delay(AUTOSAVE_DELAY, function()
		self._autosavePending = false
		self._autosaveThread = nil
		local name = self._autosave
		if name then
			local ok, err = self:Save(name)
			if not ok then
				Log.warn("Auto-save failed: %s", tostring(err))
			end
		end
	end)
end

function Config._CancelAutosave(self: any)
	local thread = self._autosaveThread
	self._autosaveThread = nil
	self._autosavePending = false
	if thread and coroutine.status(thread) == "suspended" then
		task.cancel(thread)
	end
end

function Config.Destroy(self: any)
	self._autosave = nil
	self:_CancelAutosave()
	self.Saved:Destroy()
	self.Loaded:Destroy()
end

return Config
end

-- ConfigSection ---------------------------------------------------------------
definitions["ConfigSection"] = function(...)
--[[
	ConfigSection

	A ready-made section for managing configs, built only from the public API:

	    Lattice:CreateConfigSection(SettingsTab, { Side = "Right" })

	It provides a name field, a list of saved configs, Save / Load / Delete /
	Refresh buttons and a "Load automatically" switch for the selected config,
	and reports results through notifications.
]]

local Log = import("Log")
local Options = import("Options")

local ConfigSection = {}

local AUTOLOAD_HINT = "Load the selected config when the script runs."

local SCHEMA: Options.Schema = {
	Name = { Type = "string", Default = "Configuration" },
	Description = { Type = "string", Default = "Save and load your settings." },
	Side = { Type = "string|number" },
}

function ConfigSection.Build(library: any, tab: any, rawOptions: any): any
	if type(tab) ~= "table" or type(tab.CreateSection) ~= "function" then
		Log.warn("CreateConfigSection expects a tab")
		return nil
	end
	local options = Options.Resolve("CreateConfigSection", rawOptions, SCHEMA)
	local config = library.Config
	local syncAutoload: () -> ()

	local section = tab:CreateSection({
		Name = options.Name,
		Description = options.Description,
		Side = options.Side,
	})

	local nameInput = section:AddInput({
		Name = "Config name",
		Placeholder = "e.g. Default",
		MaxLength = 50,
		Save = false,
	})
	local list = section:AddDropdown({
		Name = "Saved configs",
		Values = {},
		AllowNone = true,
		Placeholder = "No config selected",
		Save = false,
		Callback = function()
			syncAutoload()
		end,
	})
	local autoloadToggle

	local function notify(success: boolean, title: string, message: string?)
		library:Notify({
			Title = title,
			Description = message,
			Type = if success then "Success" else "Error",
			Duration = if success then 3 else 5,
		})
	end

	-- Shows whether the selected config is the autoload one, and which one is.
	function syncAutoload()
		local autoload = config:GetAutoload()
		local selected = list:GetValue()
		autoloadToggle:SetValue(selected ~= nil and selected == autoload, true)
		autoloadToggle:SetDisabled(selected == nil)
		autoloadToggle:SetDescription(
			if autoload then string.format('"%s" loads when the script runs.', autoload) else AUTOLOAD_HINT
		)
	end

	local function refresh()
		list:SetValues(config:List())
		syncAutoload()
	end

	local function selectedName(): string?
		local typed = nameInput:GetValue()
		if type(typed) == "string" and typed ~= "" then
			return typed
		end
		return list:GetValue()
	end

	section
		:AddButton({
			Name = "Save",
			Variant = "Primary",
			Callback = function()
				local name = selectedName()
				if name == nil then
					notify(false, "Nothing to save", "Enter a config name first.")
					return
				end
				local ok, err = config:Save(name)
				if ok then
					local _, normalized = config.ValidateName(name)
					list:SetValues(config:List())
					list:SetValue(normalized, true)
					nameInput:SetValue("", true)
					syncAutoload()
					notify(true, "Config saved", string.format('Saved "%s".', normalized))
				else
					notify(false, "Could not save", err)
				end
			end,
		})
		:AddButton({
			Name = "Load",
			Callback = function()
				local name = list:GetValue()
				if name == nil then
					notify(false, "No config selected", "Pick a config from the list.")
					return
				end
				local ok, err = config:Load(name)
				if ok then
					notify(true, "Config loaded", string.format('Loaded "%s".', name))
				else
					notify(false, "Could not load", err)
				end
			end,
		})

	section
		:AddButton({
			Name = "Delete",
			Variant = "Danger",
			Confirm = {
				Title = "Delete config?",
				Description = "The selected config will be removed permanently.",
				ConfirmText = "Delete",
				Variant = "Danger",
			},
			Callback = function()
				local name = list:GetValue()
				if name == nil then
					notify(false, "No config selected", "Pick a config from the list.")
					return
				end
				local ok, err = config:Delete(name)
				if ok then
					refresh()
					notify(true, "Config deleted", string.format('Deleted "%s".', name))
				else
					notify(false, "Could not delete", err)
				end
			end,
		})
		:AddButton({
			Name = "Refresh",
			Callback = refresh,
		})

	autoloadToggle = section:AddToggle({
		Name = "Load automatically",
		Description = AUTOLOAD_HINT,
		Save = false,
		Callback = function(enabled: boolean)
			local name = list:GetValue()
			if enabled then
				if name == nil then
					autoloadToggle:SetValue(false, true)
					notify(false, "No config selected", "Pick a config to load automatically.")
					return
				end
				local ok, err = config:SetAutoload(name)
				if ok then
					notify(true, "Autoload set", string.format('"%s" will load automatically.', name))
				else
					notify(false, "Could not set autoload", err)
				end
			elseif name ~= nil and config:GetAutoload() == name then
				config:SetAutoload(nil)
			end
			syncAutoload()
		end,
	})

	refresh()
	return section
end

return ConfigSection
end

-- ConfigStorage ---------------------------------------------------------------
definitions["ConfigStorage"] = function(...)
--[[
	ConfigStorage

	Storage adapters for the configuration system. An adapter is any table
	with these methods (each returns ok, result-or-error):

	    adapter:Read(name: string)               -> (boolean, string | error)
	    adapter:Write(name: string, data: string) -> (boolean, error?)
	    adapter:Delete(name: string)             -> (boolean, error?)
	    adapter:List()                           -> (boolean, { string } | error)

	Built-in adapters:
	    Storage.Files(folder?)   JSON files in the executor's workspace folder
	                             (writefile/readfile/listfiles). The default in
	                             executors.
	    Storage.Memory()         session-only. The default without file access.
	    Storage.Custom({ Read, Write, Delete, List })
	                             adapt your own functions
]]

local Environment = import("Environment")

local Storage = {}

type Adapter = {
	Name: string?,
	Folder: string?,
	Read: (self: any, name: string) -> (boolean, any),
	Write: (self: any, name: string, data: string) -> (boolean, any),
	Delete: (self: any, name: string) -> (boolean, any),
	List: (self: any) -> (boolean, any),
}

-- True when the executor provides file functions.
function Storage.HasFiles(): boolean
	return Environment.FileSystem() ~= nil
end

-- Keeps configs in memory for the current session.
function Storage.Memory(): Adapter
	local data: { [string]: string } = {}
	return {
		Name = "Memory",
		Read = function(_, name: string)
			local value = data[name]
			if value == nil then
				return false, "not found"
			end
			return true, value
		end,
		Write = function(_, name: string, value: string)
			data[name] = value
			return true, nil
		end,
		Delete = function(_, name: string)
			if data[name] == nil then
				return false, "not found"
			end
			data[name] = nil
			return true, nil
		end,
		List = function(_)
			local names = {}
			for name in data do
				table.insert(names, name)
			end
			return true, names
		end,
	}
end

--[[
	Stores each config as `<folder>/<name>.json` in the executor's workspace
	folder. Folders are created as needed. Without file functions every call
	fails with a clear error (use Storage.Memory() instead).
]]
function Storage.Files(folder: string?): Adapter
	local root = string.gsub(folder or "Lattice", "[/\\]+$", "")
	local function pathOf(name: string): string
		return root .. "/" .. name .. ".json"
	end
	local function files(): any
		local fs = Environment.FileSystem()
		if fs == nil then
			error("this executor has no file functions (writefile/readfile)", 0)
		end
		return fs
	end
	local function ensureFolder(fs: any)
		if fs.makefolder == nil or fs.isfolder == nil then
			return
		end
		local path = ""
		for part in string.gmatch(root, "[^/\\]+") do
			path = if path == "" then part else path .. "/" .. part
			if not fs.isfolder(path) then
				fs.makefolder(path)
			end
		end
	end
	-- Runs a file operation, turning errors into (false, message).
	local function attempt(operation: () -> (boolean, any)): (boolean, any)
		local ok, success, result = pcall(operation)
		if not ok then
			return false, tostring(success)
		end
		return success, result
	end

	return {
		Name = "Files",
		Folder = root,
		Read = function(_, name: string)
			return attempt(function()
				local fs = files()
				local path = pathOf(name)
				if not fs.isfile(path) then
					return false, "not found"
				end
				return true, fs.read(path)
			end)
		end,
		Write = function(_, name: string, data: string)
			return attempt(function()
				local fs = files()
				ensureFolder(fs)
				fs.write(pathOf(name), data)
				return true, nil
			end)
		end,
		Delete = function(_, name: string)
			return attempt(function()
				local fs = files()
				local path = pathOf(name)
				if not fs.isfile(path) then
					return false, "not found"
				end
				if fs.delfile == nil then
					return false, "this executor cannot delete files"
				end
				fs.delfile(path)
				return true, nil
			end)
		end,
		List = function(_)
			return attempt(function()
				local fs = files()
				if fs.isfolder and not fs.isfolder(root) then
					return true, {}
				end
				local names = {}
				for _, file in fs.listfiles(root) do
					-- Executors return full paths, with either kind of slash.
					local name = string.match(file, "([^/\\]+)%.json$")
					if name then
						table.insert(names, name)
					end
				end
				return true, names
			end)
		end,
	}
end

--[[
	Wraps plain functions. Each function may return the value directly or
	(ok, value); errors are caught and reported as failures.

	Storage.Custom({
	    Read = function(name) return myStore[name] end,
	    Write = function(name, data) myStore[name] = data end,
	    Delete = function(name) myStore[name] = nil end,
	    List = function() return names end,
	})
]]
function Storage.Custom(functions: { [string]: (...any) -> ...any }): Adapter
	local function wrap(method: string, required: boolean)
		local fn = functions[method]
		return function(_, ...: any): (boolean, any)
			if type(fn) ~= "function" then
				if required then
					return false, method .. " is not implemented"
				end
				return true, nil
			end
			local results = table.pack(pcall(fn, ...))
			if not results[1] then
				return false, tostring(results[2])
			end
			if type(results[2]) == "boolean" and results.n >= 2 then
				return results[2], results[3]
			end
			if method == "Read" and results[2] == nil then
				return false, "not found"
			end
			return true, results[2]
		end
	end
	local adapter: any = {
		Name = "Custom",
		Read = wrap("Read", true),
		Write = wrap("Write", true),
		Delete = wrap("Delete", false),
		List = wrap("List", true),
	}
	return adapter
end

-- True when `value` implements the adapter interface.
function Storage.IsAdapter(value: any): boolean
	return type(value) == "table"
		and type(value.Read) == "function"
		and type(value.Write) == "function"
		and type(value.Delete) == "function"
		and type(value.List) == "function"
end

return Storage
end

-- Dialogs ---------------------------------------------------------------------
definitions["Dialogs"] = function(...)
--[[
	Dialogs

	Modal dialogs scoped to one window: a dimmed backdrop over the window and a
	centred card with a title, a description and buttons. Used for confirmation
	prompts (Button/Toggle `Confirm` option) and available publicly through
	Window:Dialog().

	Only one dialog is shown at a time; opening another dismisses the current one.
	Escape or a click on the backdrop dismisses a dialog unless
	Dismissible = false.
]]

local Animator = import("Animator")
local Log = import("Log")
local Maid = import("Maid")
local Theme = import("Theme")
local Util = import("Util")
local Widgets = import("Widgets")

local Dialogs = {}
Dialogs.__index = Dialogs

type DialogButton = {
	Name: string,
	Variant: string?,
	Callback: (() -> ())?,
}

type DialogOptions = {
	Title: string?,
	Description: string?,
	Buttons: { DialogButton }?,
	Dismissible: boolean?,
	OnDismiss: (() -> ())?,
}

type DialogHandle = {
	Close: (self: DialogHandle) -> (),
	IsOpen: (self: DialogHandle) -> boolean,
}

local CARD_WIDTH = 320

function Dialogs.new(layer: GuiObject, scope: Theme.Scope, input: any)
	return setmetatable({
		_layer = layer,
		_scope = scope,
		_input = input,
		_current = nil :: any,
	}, Dialogs)
end

--[[
	Shows a dialog. Each button closes the dialog and then runs its callback.
	Returns a handle that can close the dialog programmatically.
]]
function Dialogs.Show(self: any, options: DialogOptions): DialogHandle
	if self._current then
		self._current:_Dismiss()
	end

	local scope: Theme.Scope = self._scope
	local maid = Maid.new()
	local closed = false
	local handle: any = {}

	local backdrop = Util.Create("TextButton", {
		Name = "DialogBackdrop",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 40,
		Selectable = false,
		Parent = self._layer,
	})
	maid:Add(backdrop)
	scope:Bind(backdrop, "BackgroundColor3", "Overlay")
	Widgets.Corner(scope, backdrop, "WindowCornerRadius")

	local holder = Util.Create("Frame", {
		Name = "Dialog",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(CARD_WIDTH, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = 41,
		Parent = backdrop,
	})
	local holderScale = Util.Create("UIScale", { Scale = 0.96, Parent = holder })
	local _, setShadow = Widgets.Shadow(scope, holder, "WindowCornerRadius", 40)
	setShadow(0)

	local card = Util.Create("CanvasGroup", {
		Name = "Card",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		GroupTransparency = 1,
		ZIndex = 41,
		Parent = holder,
	})
	scope:Bind(card, "BackgroundColor3", "Secondary")
	Widgets.Corner(scope, card, "WindowCornerRadius")
	local padding = Util.Create("UIPadding", { Parent = card })
	scope:Bind(padding, "PaddingTop", function(t)
		return UDim.new(0, t.Padding + 4)
	end)
	scope:Bind(padding, "PaddingBottom", function(t)
		return UDim.new(0, t.Padding + 2)
	end)
	scope:Bind(padding, "PaddingLeft", function(t)
		return UDim.new(0, t.Padding + 4)
	end)
	scope:Bind(padding, "PaddingRight", function(t)
		return UDim.new(0, t.Padding + 4)
	end)
	local list = Util.List(card)
	scope:Bind(list, "Padding", function(t)
		return UDim.new(0, t.Spacing)
	end)

	local border = Util.Create("Frame", {
		Name = "Border",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 42,
		Parent = holder,
	})
	Widgets.Corner(scope, border, "WindowCornerRadius")
	local borderStroke = Util.Create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Transparency = 1,
		Parent = border,
	})
	scope:Bind(borderStroke, "Color", "Border")
	scope:Bind(borderStroke, "Thickness", "StrokeThickness")

	if options.Title and options.Title ~= "" then
		Widgets.Label(scope, {
			Text = options.Title,
			Style = "Title",
			Weight = Enum.FontWeight.SemiBold,
			Wrapped = true,
			Properties = {
				Name = "Title",
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = 1,
				ZIndex = 41,
				Parent = card,
			},
		})
	end
	if options.Description and options.Description ~= "" then
		Widgets.Label(scope, {
			Text = options.Description,
			Wrapped = true,
			Color = "MutedText",
			Properties = {
				Name = "Description",
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = 2,
				ZIndex = 41,
				Parent = card,
			},
		})
	end

	local row = Util.Create("Frame", {
		Name = "Buttons",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		ZIndex = 41,
		Parent = card,
	})
	Util.Create("UIPadding", { PaddingTop = UDim.new(0, 6), Parent = row })
	Util.List(row, {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Padding = UDim.new(0, 8),
	})

	local function close(runDismiss: boolean)
		if closed then
			return
		end
		closed = true
		if self._current == handle then
			self._current = nil
		end
		Animator.Play(backdrop, { BackgroundTransparency = 1 }, { Scope = scope })
		setShadow(0, true)
		Animator.Play(card, { GroupTransparency = 1 }, { Scope = scope, DurationScale = 0.8 })
		Animator.Play(borderStroke, { Transparency = 1 }, { Scope = scope, DurationScale = 0.8 })
		Animator.Play(holderScale, { Scale = 0.96 }, {
			Scope = scope,
			DurationScale = 0.8,
			OnComplete = function()
				scope:Unbind(backdrop)
				maid:Destroy()
			end,
		})
		backdrop.Interactable = false
		if runDismiss and options.OnDismiss then
			Util.SafeCall(options.OnDismiss, "dialog dismiss")
		end
	end

	local buttons: { DialogButton } = options.Buttons or {}
	if #buttons == 0 then
		buttons = { { Name = "OK", Variant = "Primary" } :: DialogButton }
	end
	for index, spec in buttons do
		if type(spec) ~= "table" or type(spec.Name) ~= "string" then
			Log.warn("Dialog: each button needs a Name")
			continue
		end
		local widget = Widgets.Button(scope, {
			Text = spec.Name,
			Variant = (spec.Variant or (if index == #buttons then "Primary" else "Default")) :: any,
			AutoWidth = true,
			LayoutOrder = index,
			Parent = row,
		})
		maid:Add(widget)
		maid:Add(widget.Activated:Connect(function()
			close(false)
			Util.SafeCall(spec.Callback, string.format('dialog button "%s"', spec.Name))
		end))
	end

	local dismissible = options.Dismissible ~= false
	maid:Add(backdrop.Activated:Connect(function()
		if dismissible then
			close(true)
		end
	end))
	maid:Add(self._input:OnKey({
		Began = function(input: InputObject)
			if input.KeyCode == Enum.KeyCode.Escape and dismissible then
				close(true)
			end
		end,
	}))

	local overlayTransparency = scope:Get("OverlayTransparency")
	Animator.Play(backdrop, { BackgroundTransparency = overlayTransparency }, { Scope = scope })
	Animator.Play(card, { GroupTransparency = 0 }, { Scope = scope })
	Animator.Play(borderStroke, { Transparency = scope:Get("BorderTransparency") }, { Scope = scope })
	Animator.Play(holderScale, { Scale = 1 }, { Scope = scope, EasingStyle = Enum.EasingStyle.Back })
	setShadow(1, true)

	function handle.Close(_self: any)
		close(true)
	end
	function handle.IsOpen(_self: any): boolean
		return not closed
	end
	function handle._Dismiss(_self: any)
		close(true)
	end

	self._current = handle
	return handle :: DialogHandle
end

--[[
	Convenience confirmation prompt. `callback(true)` runs on confirm and
	`callback(false)` on cancel or dismissal.
]]
function Dialogs.Confirm(
	self: any,
	options: {
		Title: string?,
		Description: string?,
		ConfirmText: string?,
		CancelText: string?,
		Variant: string?,
	},
	callback: (boolean) -> ()
): DialogHandle
	local answered = false
	local function answer(value: boolean)
		if answered then
			return
		end
		answered = true
		callback(value)
	end
	return self:Show({
		Title = options.Title or "Are you sure?",
		Description = options.Description,
		Buttons = {
			{
				Name = options.CancelText or "Cancel",
				Variant = "Default",
				Callback = function()
					answer(false)
				end,
			},
			{
				Name = options.ConfirmText or "Confirm",
				Variant = options.Variant or "Primary",
				Callback = function()
					answer(true)
				end,
			},
		},
		OnDismiss = function()
			answer(false)
		end,
	})
end

function Dialogs.CloseAll(self: any)
	if self._current then
		self._current:_Dismiss()
	end
end

function Dialogs.Destroy(self: any)
	self:CloseAll()
end

return Dialogs
end

