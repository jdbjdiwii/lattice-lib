		Lines = { { 5.5, 20, 7.5, 15.5 }, { 7.5, 15.5, 16.5, 15.5 }, { 16.5, 15.5, 18.5, 20 } },
	},
	Grid = { Rings = { { 8, 8, 2.6 }, { 16, 8, 2.6 }, { 8, 16, 2.6 }, { 16, 16, 2.6 } } },
	Code = { Lines = { { 9, 7, 4, 12 }, { 4, 12, 9, 17 }, { 15, 7, 20, 12 }, { 20, 12, 15, 17 } } },
	Bolt = {
		Lines = {
			{ 13.5, 3.5, 7, 13 },
			{ 7, 13, 12, 13 },
			{ 12, 13, 10.5, 20.5 },
			{ 10.5, 20.5, 17, 11 },
			{ 17, 11, 12, 11 },
			{ 12, 11, 13.5, 3.5 },
		},
	},
	Palette = { Rings = { { 12, 12, 8 } }, Dots = { { 9, 9, 1.4 }, { 14, 8, 1.4 }, { 16.5, 12, 1.4 } } },
}

Icons.Names = (function(): { string }
	local names = {}
	for name in DEFINITIONS do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end)()

type IconOptions = {
	Size: number?, -- pixel size of the icon box (default 16)
	Thickness: number?, -- stroke thickness in pixels (default scales with size)
	Color: Color3?,
	Parent: any,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	ZIndex: number?,
	LayoutOrder: number?,
	Name: string?,
}

type Icon = {
	Frame: Frame,
	Parts: { GuiObject },
	Strokes: { UIStroke },
	SetColor: (self: Icon, color: Color3) -> (),
	SetTransparency: (self: Icon, transparency: number) -> (),
}

local IconMethods = {}
IconMethods.__index = IconMethods

function IconMethods.SetColor(self: any, color: Color3)
	for _, part in self.Parts do
		part.BackgroundColor3 = color
	end
	for _, stroke in self.Strokes do
		stroke.Color = color
	end
end

function IconMethods.SetTransparency(self: any, transparency: number)
	for _, part in self.Parts do
		part.BackgroundTransparency = transparency
	end
	for _, stroke in self.Strokes do
		stroke.Transparency = transparency
	end
end

function Icons.Has(name: string): boolean
	return DEFINITIONS[name] ~= nil
end

--[[
	Builds an icon. Returns an object with the container frame and helpers to
	recolour it, so callers can bind it to theme tokens:

	    local icon = Icons.Create("ChevronDown", { Size = 14, Parent = box })
	    scope:Observe(function(t) icon:SetColor(t.MutedText) end)
]]
function Icons.Create(name: string, options: IconOptions?): Icon
	local definition = DEFINITIONS[name] or DEFINITIONS.Dot
	local opts: IconOptions = options or {}
	local size = opts.Size or 16
	local unit = size / 24
	local thickness = opts.Thickness or math.max(1.5, math.floor(size / 8 + 0.5))
	local color = opts.Color or Color3.new(1, 1, 1)

	local container = Util.Create("Frame", {
		Name = opts.Name or (name .. "Icon"),
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		ZIndex = opts.ZIndex or 1,
		LayoutOrder = opts.LayoutOrder or 0,
		Parent = opts.Parent,
	})

	local parts: { GuiObject } = {}
	local strokes: { UIStroke } = {}

	for _, line in definition.Lines or NO_LINES do
		local x1, y1, x2, y2 = line[1] * unit, line[2] * unit, line[3] * unit, line[4] * unit
		local dx, dy = x2 - x1, y2 - y1
		local length = math.sqrt(dx * dx + dy * dy) + thickness
		local bar = Util.Create("Frame", {
			Name = "Stroke",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
			Size = UDim2.fromOffset(length, thickness),
			Rotation = math.deg(math.atan2(dy, dx)),
			BackgroundColor3 = color,
			ZIndex = container.ZIndex,
			Parent = container,
		})
		Util.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bar })
		table.insert(parts, bar)
	end

	for _, ring in definition.Rings or NO_CIRCLES do
		local diameter = ring[3] * 2 * unit
		local frame = Util.Create("Frame", {
			Name = "Ring",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(ring[1] * unit, ring[2] * unit),
			Size = UDim2.fromOffset(diameter, diameter),
			BackgroundTransparency = 1,
			ZIndex = container.ZIndex,
			Parent = container,
		})
		Util.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = frame })
		local stroke = Util.Create("UIStroke", {
			Thickness = thickness,
			Color = color,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = frame,
		})
		table.insert(strokes, stroke)
	end

	for _, dot in definition.Dots or NO_CIRCLES do
		local diameter = dot[3] * 2 * unit
		local frame = Util.Create("Frame", {
			Name = "Dot",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(dot[1] * unit, dot[2] * unit),
			Size = UDim2.fromOffset(diameter, diameter),
			BackgroundColor3 = color,
			ZIndex = container.ZIndex,
			Parent = container,
		})
		Util.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = frame })
		table.insert(parts, frame)
	end

	local icon = setmetatable({
		Frame = container,
		Parts = parts,
		Strokes = strokes,
	}, IconMethods)
	return (icon :: any) :: Icon
end

--[[
	Shows either an image (an asset id string such as "rbxassetid://123") or a
	built-in icon name. Returns the created GuiObject and a recolour function.
]]
function Icons.Visual(source: string, options: IconOptions?): (GuiObject, (Color3) -> ())
	local opts: IconOptions = options or {}
	if DEFINITIONS[source] then
		local icon = Icons.Create(source, opts)
		return icon.Frame, function(color: Color3)
			icon:SetColor(color)
		end
	end
	local size = opts.Size or 16
	local image = Util.Create("ImageLabel", {
		Name = opts.Name or "Icon",
		Image = source,
		ImageColor3 = opts.Color or Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(size, size),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		ZIndex = opts.ZIndex or 1,
		LayoutOrder = opts.LayoutOrder or 0,
		ScaleType = Enum.ScaleType.Fit,
		Parent = opts.Parent,
	})
	return image, function(color: Color3)
		image.ImageColor3 = color
	end
end

return Icons
end

-- Input -----------------------------------------------------------------------
definitions["Input"] = function(...)
--[[
	Input

	    local Name = Section:AddInput({
	        Name = "Display name",
	        Placeholder = "Enter a name",
	        Default = "",
	        MaxLength = 20,
	        Validate = function(text)
	            return #text >= 3, "Use at least 3 characters"
	        end,
	        Callback = function(text) print(text) end,
	    })

	    local Amount = Section:AddInput({
	        Name = "Amount",
	        Numeric = true,      -- value is a number
	        Min = 1, Max = 500, Rounding = 0,
	        Default = 10,
	    })

	By default the value commits when the field loses focus (Enter or clicking
	away). Set Live = true to commit on every valid keystroke. Invalid input
	shows an inline error and reverts to the last valid value.
]]

local Animator = import("Animator")
local InputManager = import("InputManager")
local Log = import("Log")
local Theme = import("Theme")
local Util = import("Util")
local Widgets = import("Widgets")

local Base = import("Base")

local Input = Base.extend("Input", {
	Placeholder = { Type = "string", Default = "" },
	Default = { Type = "string|number" },
	Numeric = { Type = "boolean", Default = false },
	Min = { Type = "number" },
	Max = { Type = "number" },
	Rounding = {
		Type = "number",
		Validate = function(value)
			return value >= 0 and value <= 6 and value % 1 == 0, "must be a whole number from 0 to 6"
		end,
	},
	MaxLength = {
		Type = "number",
		Validate = function(value)
			return value >= 1, "must be at least 1"
		end,
	},
	Validate = { Type = "function" },
	Live = { Type = "boolean", Default = false },
	ClearOnFocus = { Type = "boolean", Default = false },
}, { Value = "Default", PlaceholderText = "Placeholder" })
Input.DefaultName = "Input"
Input.Serializable = true

local ERROR_DURATION = 4

function Input.new(context: any, options: any)
	local self: any = setmetatable({}, Input)
	local resolved = self:_Init(context, options)
	self.Numeric = resolved.Numeric
	self.Placeholder = resolved.Placeholder
	self.Min, self.Max = resolved.Min, resolved.Max
	if self.Min and self.Max and self.Min > self.Max then
		Log.warn("%s: Min is greater than Max; swapping them", self:_Describe())
		self.Min, self.Max = self.Max, self.Min
	end
	self.Rounding = resolved.Rounding
	self.MaxLength = resolved.MaxLength
	self._validate = resolved.Validate
	self._live = resolved.Live
	self._focused = false
	self._hovered = false
	self._error = nil :: string?

	-- An empty field to start with is never "invalid": Validate only checks
	-- an explicit Default and what the player types.
	local fallback = if self.Numeric then (self.Min or 0) else ""
	local normalized = fallback
	if resolved.Default ~= nil then
		local ok, result = self:_Normalize(resolved.Default)
		if ok then
			normalized = result
		else
			Log.warn("%s: Default %s", self:_Describe(), tostring(result))
		end
	end
	self:_InitValue(normalized)

	self:_Build(resolved.ClearOnFocus)
	self:_Mount()
	return self
end

function Input._Build(self: any, clearOnFocus: boolean)
	local scope: Theme.Scope = self._scope
	local root = self:_CreateRoot()
	Util.List(root, { Padding = UDim.new(0, 6) })

	local header = Util.Create("Frame", {
		Name = "Header",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		ZIndex = 2,
		Parent = root,
	})
	Util.List(header, { FillDirection = Enum.FillDirection.Horizontal })
	self:_BuildTextBlock(header, 1)

	local box, _, stroke = Widgets.Surface(scope, {
		Background = "InputBackground",
		Properties = {
			Name = "Field",
			Size = UDim2.new(1, 0, 0, 30),
			LayoutOrder = 2,
			ZIndex = 2,
			Parent = root,
		},
	})
	scope:Bind(box, "Size", function(t)
		return UDim2.new(1, 0, 0, t.ControlHeight)
	end)
	Util.Padding(box, 0, 10, 0, 10)
	self._box = box
	self._boxStroke = stroke

	local textBox = Widgets.Label(scope, {
		Color = false,
		Properties = {
			Name = "TextBox",
			Size = UDim2.fromScale(1, 1),
			PlaceholderText = self.Placeholder,
			ClearTextOnFocus = clearOnFocus,
			Text = self:_Format(self.Value),
			ZIndex = 2,
			Parent = box,
		},
	}, "TextBox")
	scope:Bind(textBox, "PlaceholderColor3", "PlaceholderText")
	self._textBox = textBox

	self._errorLabel = Widgets.Label(scope, {
		Style = "Small",
		Wrapped = true,
		Color = "Error",
		Properties = {
			Name = "Error",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Visible = false,
			LayoutOrder = 3,
			ZIndex = 2,
			Parent = root,
		},
	})

	local editing = false
	self._maid:Add(textBox:GetPropertyChangedSignal("Text"):Connect(function()
		if editing then
			return
		end
		local text = textBox.Text
		local filtered = self:_Filter(text)
		if filtered ~= text then
			editing = true
			textBox.Text = filtered
			editing = false
		end
		if self._live and self._focused then
			local ok, normalized = self:_Normalize(self:_Parse(filtered))
			if ok then
				self:_ClearError()
				self:_Commit(normalized, false)
			end
		end
	end))
	self._maid:Add(textBox.Focused:Connect(function()
		if self.Disabled then
			textBox:ReleaseFocus()
			return
		end
		self._focused = true
		self:_RenderBox(true)
	end))
	self._maid:Add(textBox.FocusLost:Connect(function()
		self._focused = false
		self:_CommitText(textBox.Text)
		self:_RenderBox(true)
	end))
	self._maid:Add(InputManager.TrackState(textBox, function(state)
		local hovered = state == Enum.GuiState.Hover or state == Enum.GuiState.Press
		if hovered ~= self._hovered then
			self._hovered = hovered
			self:_RenderBox(true)
		end
	end))
	self._maid:Add(scope:Observe(function()
		self:_RenderBox(false)
	end))
end

-- Restricts what can be typed: length and, for numeric fields, characters.
function Input._Filter(self: any, text: string): string
	if self.Numeric then
		local negative = string.sub(text, 1, 1) == "-"
		local digits = string.gsub(text, "[^%d%.]", "")
		local first = string.find(digits, ".", 1, true)
		if first then
			digits = string.sub(digits, 1, first) .. string.gsub(string.sub(digits, first + 1), "%.", "")
		end
		text = (if negative and (self.Min == nil or self.Min < 0) then "-" else "") .. digits
	end
	if self.MaxLength and utf8.len(text) and (utf8.len(text) :: number) > self.MaxLength then
		local cut = utf8.offset(text, self.MaxLength + 1)
		if cut then
			text = string.sub(text, 1, cut - 1)
		end
	end
	return text
end

function Input._Parse(self: any, text: string): any
	if self.Numeric then
		return tonumber(text)
	end
	return text
end

function Input._Format(self: any, value: any): string
	if self.Numeric and type(value) == "number" then
		if self.Rounding then
			return Util.FormatNumber(value, self.Rounding)
		end
		return tostring(value)
	end
	return tostring(value or "")
end

function Input._Normalize(self: any, value: any): (boolean, any)
	if self.Numeric then
		if type(value) == "string" then
			value = tonumber(value)
		end
		if type(value) ~= "number" or value ~= value then
			return false, "Enter a number"
		end
		if self.Min then
			value = math.max(value, self.Min)
		end
		if self.Max then
			value = math.min(value, self.Max)
		end
		if self.Rounding then
			value = Util.Round(value, self.Rounding)
		end
	else
		if type(value) == "number" then
			value = tostring(value)
		end
		if type(value) ~= "string" then
			return false, "expected a string, got " .. typeof(value)
		end
		if self.MaxLength and (utf8.len(value) or #value) > self.MaxLength then
			local cut = utf8.offset(value, self.MaxLength + 1)
			value = if cut then string.sub(value, 1, cut - 1) else value
		end
	end
	if self._validate then
		local ok, accepted, reason = pcall(self._validate, value)
		if not ok then
			Log.handlerError(accepted, self:_Describe() .. " Validate")
			return false, "Invalid value"
		end
		if accepted == false then
			return false, if type(reason) == "string" then reason else "Invalid value"
		end
	end
	return true, value
end

function Input._CommitText(self: any, text: string)
	local ok, normalized = self:_Normalize(self:_Parse(text))
	if ok then
		self:_ClearError()
		if not self:_Commit(normalized, false) then
			self:_SyncText()
		end
	else
		self:_ShowError(tostring(normalized))
		self:_SyncText()
	end
end

function Input._SyncText(self: any)
	if not self._focused then
		self._textBox.Text = self:_Format(self.Value)
	end
end

function Input._ShowError(self: any, message: string)
	self._error = message
	self._errorLabel.Text = message
	self._errorLabel.Visible = true
	self:_RenderBox(true)
	self._maid:Set(
		"ErrorTimeout",
		task.delay(ERROR_DURATION, function()
			self._maid:Set("ErrorTimeout", nil)
			self:_ClearError()
		end)
	)
end

function Input._ClearError(self: any)
	if self._error == nil then
		return
	end
	self._error = nil
	self._errorLabel.Visible = false
	self._maid:Clear("ErrorTimeout")
	self:_RenderBox(true)
end

function Input._RenderBox(self: any, animate: boolean)
	local t = self._scope:View()
	local stroke = if self.Disabled
		then t.Border
		elseif self._error then t.Error
		elseif self._focused then t.InputFocusBorder
		elseif self._hovered then t.Border:Lerp(t.Text, 0.15)
		else t.Border
	local background = if self.Disabled then t.Disabled else t.InputBackground
	if animate then
		Animator.Play(self._boxStroke, { Color = stroke }, { Scope = self._scope, DurationScale = 0.8 })
		Animator.Play(self._box, { BackgroundColor3 = background }, { Scope = self._scope, DurationScale = 0.8 })
	else
		Animator.Set(self._boxStroke, { Color = stroke })
		Animator.Set(self._box, { BackgroundColor3 = background })
	end
	self._textBox.TextColor3 = if self.Disabled then t.DisabledText else t.Text
end

function Input._Render(self: any, animate: boolean)
	self:_SyncText()
	self:_RenderBox(animate)
end

function Input._OnDisabledChanged(self: any, disabled: boolean)
	local textBox: TextBox = self._textBox
	textBox.TextEditable = not disabled
	textBox.Interactable = not disabled
	if disabled and textBox:IsFocused() then
		textBox:ReleaseFocus()
	end
end

function Input.SetPlaceholder(self: any, text: string)
	self.Placeholder = text
	self._textBox.PlaceholderText = text
end

-- Puts the text cursor in the field.
function Input.Focus(self: any)
	if not self.Disabled then
		self._textBox:CaptureFocus()
	end
end

return Input
end

-- InputManager ----------------------------------------------------------------
definitions["InputManager"] = function(...)
--[[
	InputManager

	One owner for global input, shared by every window of a library instance:

	  * Pointer position in screen space for mouse and touch.
	  * Pointer capture for drags (sliders, colour areas, window move/resize).
	    Only one drag can be active at a time, which is what keeps a slider drag
	    from also moving the window or a resize from fighting a colour picker.
	  * Pointer-down listeners, used to close popups when clicking outside them.
	  * Key listeners for keybinds and window toggle keys.
	  * Exclusive capture of the next input, used when rebinding a keybind.
	  * Gamepad handlers for selected GUI objects (slider adjustment, etc).

	Global UserInputService connections are created lazily on first use and
	released when nothing is listening any more (or by Destroy()); nothing
	runs per frame.
]]

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Signal = import("Signal")

local InputManager = {}
InputManager.__index = InputManager

type InputMode = "Mouse" | "Touch" | "Gamepad"

type DragHandlers = {
	-- Called with the pointer position and the delta from where the drag began.
	Move: (position: Vector2, delta: Vector2) -> (),
	End: (() -> ())?,
}

type KeyListener = {
	Began: (input: InputObject, gameProcessed: boolean) -> (),
	Ended: ((input: InputObject, gameProcessed: boolean) -> ())?,
}

local POINTER_DOWN: { [Enum.UserInputType]: boolean } = {
	[Enum.UserInputType.MouseButton1] = true,
	[Enum.UserInputType.Touch] = true,
}

local MOUSE_BUTTONS: { [Enum.UserInputType]: boolean } = {
	[Enum.UserInputType.MouseButton1] = true,
	[Enum.UserInputType.MouseButton2] = true,
	[Enum.UserInputType.MouseButton3] = true,
}

local GAMEPADS: { [Enum.UserInputType]: boolean } = {
	[Enum.UserInputType.Gamepad1] = true,
	[Enum.UserInputType.Gamepad2] = true,
	[Enum.UserInputType.Gamepad3] = true,
	[Enum.UserInputType.Gamepad4] = true,
	[Enum.UserInputType.Gamepad5] = true,
	[Enum.UserInputType.Gamepad6] = true,
	[Enum.UserInputType.Gamepad7] = true,
	[Enum.UserInputType.Gamepad8] = true,
}

local function modeFor(inputType: Enum.UserInputType): InputMode?
	if inputType == Enum.UserInputType.Touch then
		return "Touch"
	elseif GAMEPADS[inputType] then
		return "Gamepad"
	elseif
		inputType == Enum.UserInputType.MouseMovement
		or inputType == Enum.UserInputType.Keyboard
		or MOUSE_BUTTONS[inputType]
		or inputType == Enum.UserInputType.MouseWheel
	then
		return "Mouse"
	end
	return nil
end

-- The binding identity of an input: a KeyCode, a mouse button, or nil.
function InputManager.KeyOf(input: InputObject): EnumItem?
	local inputType = input.UserInputType
	if MOUSE_BUTTONS[inputType] then
		return inputType
	end
	-- KeyCode value 0 is the "no key" item (named Unknown in older engine versions, None today).
	if (inputType == Enum.UserInputType.Keyboard or GAMEPADS[inputType]) and input.KeyCode.Value ~= 0 then
		return input.KeyCode
	end
	return nil
end

function InputManager.new()
	local lastType = UserInputService:GetLastInputType()
	local self = setmetatable({
		_connections = {} :: { RBXScriptConnection },
		_started = false,
		_drag = nil :: any,
		_pointerListeners = {} :: { (Vector2, InputObject) -> () },
		_keyListeners = {} :: { KeyListener },
		_capture = nil :: ((InputObject) -> ())?,
		_swallowed = {} :: { [EnumItem]: boolean },
		_selectionHandlers = setmetatable({}, { __mode = "k" }) :: any,
		_mode = (modeFor(lastType) or (if UserInputService.TouchEnabled
				and not UserInputService.KeyboardEnabled
			then "Touch"
			else "Mouse")) :: any,
		InputModeChanged = Signal.new("InputModeChanged"),
	}, InputManager)
	return self
end

type InputManager = typeof(InputManager.new())

function InputManager._EnsureStarted(self: InputManager)
	if self._started then
		return
	end
	self._started = true
	local current = modeFor(UserInputService:GetLastInputType())
	if current then
		self._mode = current
	end
	local connections = self._connections
	table.insert(
		connections,
		UserInputService.InputBegan:Connect(function(input, processed)
			self:_OnBegan(input, processed)
		end)
	)
	table.insert(
		connections,
		UserInputService.InputChanged:Connect(function(input)
			self:_OnChanged(input)
		end)
	)
	table.insert(
		connections,
		UserInputService.InputEnded:Connect(function(input, processed)
			self:_OnEnded(input, processed)
		end)
	)
	table.insert(
		connections,
		UserInputService.LastInputTypeChanged:Connect(function(inputType)
			local mode = modeFor(inputType)
			if mode and mode ~= self._mode then
				self._mode = mode
				self.InputModeChanged:Fire(mode)
			end
		end)
	)
	table.insert(
		connections,
		UserInputService.WindowFocusReleased:Connect(function()
			-- The mouse may be released outside the game window; never leave a drag stuck.
			self:EndDrag()
		end)
	)
end

-- Releases the global connections once nothing is listening any more, so a
-- library with no windows left holds no UserInputService connections.
function InputManager._MaybeStop(self: InputManager)
	if
		not self._started
		or self._drag ~= nil
		or self._capture ~= nil
		or #self._pointerListeners > 0
		or #self._keyListeners > 0
		or next(self._selectionHandlers) ~= nil
	then
		return
	end
	self._started = false
	for _, connection in self._connections do
		connection:Disconnect()
	end
	table.clear(self._connections)
	table.clear(self._swallowed)
end

function InputManager._OnBegan(self: InputManager, input: InputObject, processed: boolean)
	local inputType = input.UserInputType

	local capture = self._capture
	if capture then
		local key = InputManager.KeyOf(input)
		if key then
			self._capture = nil
			-- Swallow the matching release so a hold-mode keybind bound to the
			-- same key does not see a stray "ended" event.
			self._swallowed[key] = true
			capture(input)
			self:_MaybeStop()
			return
		end
	end

	if POINTER_DOWN[inputType] then
		local position = self:GetPointerPosition(input)
		for _, listener in table.clone(self._pointerListeners) do
			listener(position, input)
		end
	end

	if GAMEPADS[inputType] then
		local selected = GuiService.SelectedObject
		local handler = selected and self._selectionHandlers[selected]
		if handler and handler(input) then
			return
		end
	end

	for _, listener in table.clone(self._keyListeners) do
		listener.Began(input, processed)
	end
end

function InputManager._OnChanged(self: InputManager, input: InputObject)
	local drag = self._drag
	if drag == nil then
		return
	end
	local inputType = input.UserInputType
	if
		(drag.Mouse and inputType == Enum.UserInputType.MouseMovement)
		or (not drag.Mouse and inputType == Enum.UserInputType.Touch and input == drag.Input)
	then
		local position = self:GetPointerPosition(input)
		drag.Move(position, position - drag.Origin)
	end
end

function InputManager._OnEnded(self: InputManager, input: InputObject, processed: boolean)
	local drag = self._drag
	if drag then
		if
			(drag.Mouse and input.UserInputType == Enum.UserInputType.MouseButton1)
			or (not drag.Mouse and input == drag.Input)
		then
			self:EndDrag()
		end
	end

	local key = InputManager.KeyOf(input)
	if key and self._swallowed[key] then
		self._swallowed[key] = nil
		return
	end

	for _, listener in table.clone(self._keyListeners) do
		if listener.Ended then
			listener.Ended(input, processed)
		end
	end
end

--[[
	Pointer position in screen space (top-left of the screen, including the
	top bar inset). Library ScreenGuis use IgnoreGuiInset so this matches
	GuiObject.AbsolutePosition directly.
]]
function InputManager.GetPointerPosition(_self: InputManager, input: InputObject?): Vector2
	if input and input.UserInputType == Enum.UserInputType.Touch then
		local inset = GuiService:GetGuiInset()
		return Vector2.new(input.Position.X, input.Position.Y) + inset
	end
	return UserInputService:GetMouseLocation()
end

--[[
	Starts a pointer capture from a MouseButton1 or Touch input. Move/End are
	driven by input events only, never by per-frame polling. Starting a new
	drag ends the previous one.
]]
function InputManager.BeginDrag(self: InputManager, input: InputObject, handlers: DragHandlers): boolean
	local inputType = input.UserInputType
	if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then
		return false
	end
	self:_EnsureStarted()
	if self._drag then
		self:EndDrag()
	end
	self._drag = {
		Input = input,
		Mouse = inputType == Enum.UserInputType.MouseButton1,
		Origin = self:GetPointerPosition(input),
		Move = handlers.Move,
		End = handlers.End,
	}
	return true
end

function InputManager.EndDrag(self: InputManager)
	local drag = self._drag
	if drag == nil then
		return
	end
	self._drag = nil
	if drag.End then
		drag.End()
	end
	self:_MaybeStop()
end

function InputManager.IsDragging(self: InputManager): boolean
	return self._drag ~= nil
end

-- Registers a listener for every mouse/touch press anywhere on screen.
function InputManager.OnPointerDown(self: InputManager, listener: (Vector2, InputObject) -> ()): () -> ()
	self:_EnsureStarted()
	table.insert(self._pointerListeners, listener)
	return function()
		local index = table.find(self._pointerListeners, listener)
		if index then
			table.remove(self._pointerListeners, index)
			self:_MaybeStop()
		end
	end
end

-- Registers a key listener (keyboard, mouse buttons and gamepad buttons).
function InputManager.OnKey(self: InputManager, listener: KeyListener): () -> ()
	self:_EnsureStarted()
	table.insert(self._keyListeners, listener)
	return function()
		local index = table.find(self._keyListeners, listener)
		if index then
			table.remove(self._keyListeners, index)
			self:_MaybeStop()
		end
	end
end

--[[
	Routes the next key/button press exclusively to `callback` (other key
	listeners do not see it). Returns a function that cancels the capture.
]]
function InputManager.CaptureNext(self: InputManager, callback: (InputObject) -> ()): () -> ()
	self:_EnsureStarted()
	self._capture = callback
	return function()
		if self._capture == callback then
			self._capture = nil
			self:_MaybeStop()
		end
	end
end

function InputManager.IsCapturing(self: InputManager): boolean
	return self._capture ~= nil
end

--[[
	Handles gamepad input while `object` is the selected GUI object. The handler
	returns true when it consumed the input.
]]
function InputManager.OnSelectedInput(
	self: InputManager,
	object: GuiObject,
	handler: (InputObject) -> boolean
): () -> ()
	self:_EnsureStarted()
	self._selectionHandlers[object] = handler
	return function()
		if self._selectionHandlers[object] == handler then
			self._selectionHandlers[object] = nil
			self:_MaybeStop()
		end
	end
end

function InputManager.GetInputMode(self: InputManager): InputMode
	if not self._started then
		-- Not listening right now; ask the engine directly.
		local current = modeFor(UserInputService:GetLastInputType())
		if current then
			self._mode = current
		end
	end
	return self._mode
end

-- True on phones/tablets: touch input without a physical keyboard.
function InputManager.IsTouchDevice(_self: InputManager): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function InputManager.IsTyping(_self: InputManager): boolean
	return UserInputService:GetFocusedTextBox() ~= nil
end

--[[
	Calls `callback` with the button's GuiState (Idle, Hover, Press,
	NonInteractable) now and whenever it changes. GuiState is maintained by the
	engine for mouse, touch and gamepad alike, which keeps hover/press visuals
	consistent across input methods.
]]
function InputManager.TrackState(object: GuiObject, callback: (Enum.GuiState) -> ()): RBXScriptConnection
	callback(object.GuiState)
	return object:GetPropertyChangedSignal("GuiState"):Connect(function()
		callback(object.GuiState)
	end)
end

-- True when `point` (screen space) lies inside `object`'s on-screen rectangle.
function InputManager.Contains(object: GuiObject, point: Vector2): boolean
	local position, size = object.AbsolutePosition, object.AbsoluteSize
	return point.X >= position.X
		and point.Y >= position.Y
		and point.X <= position.X + size.X
		and point.Y <= position.Y + size.Y
end

function InputManager.Destroy(self: InputManager)
	self:EndDrag()
	for _, connection in self._connections do
		connection:Disconnect()
	end
	table.clear(self._connections)
	table.clear(self._pointerListeners)
	table.clear(self._keyListeners)
	self._capture = nil
	self._started = false
	self.InputModeChanged:Destroy()
end

return InputManager
end

-- Keybind ---------------------------------------------------------------------
definitions["Keybind"] = function(...)
--[[
	Keybind

	    local Bind = Section:AddKeybind({
	        Name = "Sprint",
	        Default = Enum.KeyCode.LeftShift,    -- or "LeftShift", "MB2", nil
	        Mode = "Hold",                       -- "Toggle" | "Hold" | "Press"
	        Callback = function(active) print("Sprint", active) end,
	        ChangedCallback = function(key) print("Rebound to", key) end,
	    })

	    Bind:GetValue()   -- Enum.KeyCode.LeftShift (or nil when unbound)
	    Bind:GetState()   -- true while active (Toggle/Hold modes)
	    Bind:Clear()      -- unbind

	Click the key button to rebind: press any key, MB2 or MB3 (MB1 too when
	AllowMouseButton1 = true), or a gamepad button. Escape cancels, Backspace
	or Delete unbinds. Right-click (long-press on touch) opens the mode menu.

	Callback semantics:
	  Toggle  callback(newState) on each press
	  Hold    callback(true) on press, callback(false) on release
	  Press   callback(true) on each press

	Attached to a toggle (Toggle:AddKeybind) in Toggle or Hold mode, the key
	drives the toggle's value unless LinkToggle = false.

	Bound keys appear in the keybind list (Lattice:SetKeybindListVisible)
	unless ShowInList = false.
]]

local Animator = import("Animator")
local Icons = import("Icons")
local InputManager = import("InputManager")
local Log = import("Log")
local Maid = import("Maid")
local Signal = import("Signal")
local Theme = import("Theme")
local Util = import("Util")
local Widgets = import("Widgets")

local Base = import("Base")

local MODES = { Toggle = true, Hold = true, Press = true }
local MODE_ORDER = { "Toggle", "Hold", "Press" }

local Keybind = Base.extend("Keybind", {
	Default = { Type = "EnumItem|string|boolean" },
	Mode = {
		Type = "string",
		Default = "Toggle",
		Validate = function(value)
			return MODES[value] == true, 'must be "Toggle", "Hold" or "Press"'
		end,
	},
	ModeChangeable = { Type = "boolean", Default = true },
	ChangedCallback = { Type = "function" },
	AllowMouse = { Type = "boolean", Default = true },
	AllowMouseButton1 = { Type = "boolean", Default = false },
	Blacklist = { Type = "table" },
	LinkToggle = { Type = "boolean", Default = true },
	ShowInList = { Type = "boolean", Default = true },
}, { Value = "Default", Key = "Default", OnBindChanged = "ChangedCallback", OnChanged = "ChangedCallback" })
Keybind.DefaultName = "Keybind"
Keybind.Serializable = true

local LONG_PRESS = 0.5

function Keybind.new(context: any, options: any)
	local self: any = setmetatable({}, Keybind)
	local resolved = self:_Init(context, options)
	self.Mode = resolved.Mode
	self._changedCallback = resolved.ChangedCallback
	self._allowMouse = resolved.AllowMouse
	self._allowMouse1 = resolved.AllowMouseButton1
	self._modeChangeable = resolved.ModeChangeable
	self._blacklist = {} :: { [EnumItem]: boolean }
	for _, entry in resolved.Blacklist or {} do
		local key = Util.ParseKey(entry)
		if key then
			self._blacklist[key] = true
		end
	end
	self._active = false
	self._listening = false
	self._hovered = false
	self.Triggered = Signal.new(self:_Describe() .. " Triggered")

	local initial = nil
	if resolved.Default ~= nil and resolved.Default ~= false then
		local ok, normalized = self:_Normalize(resolved.Default)
		if ok then
			initial = normalized
		else
			Log.warn("%s: Default %s", self:_Describe(), tostring(normalized))
		end
	end
	self:_InitValue(initial)

	local host = context.Host
	if host then
		self:_BuildButton(context.Container, context.Order)
		self.Instance = self._button
		self._maid:Add(self._button)
		if host.Type == "Toggle" and resolved.LinkToggle then
			self._linkedToggle = host
			self._active = host.Value == true
			self._maid:Add(host.Changed:Connect(function(value: boolean)
				self._active = value
				self:_RenderButton(true)
				self._library:_KeybindUpdated(self)
			end))
		end
	else
		local root = self:_CreateRoot()
		self:_BuildInlineRow(root)
		self:_BuildButton(root, 3)
	end

	self._maid:Add(context.Input:OnKey({
		Began = function(input: InputObject, processed: boolean)
			self:_OnInputBegan(input, processed)
		end,
		Ended = function(input: InputObject)
			self:_OnInputEnded(input)
		end,
	}))

	if host then
		self._maid:Add(context.Tooltips:Attach(self._button, function()
			return self.Tooltip
		end))
		if self.Disabled then
			self:_ApplyDisabled()
		end
		self._button.Parent = context.Container
		self._library:_RegisterFlag(self, resolved.Flag, context.Path)
	else
		self:_Mount()
	end
	self._library:_TrackKeybind(self)
	return self
end

function Keybind._BuildButton(self: any, parent: Instance, order: number)
	local scope: Theme.Scope = self._scope
	local button, _, stroke = Widgets.Surface(scope, {
		Background = "Tertiary",
		Properties = {
			Name = "Key",
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = order,
			ZIndex = 2,
			Selectable = true,
		},
	}, "TextButton")
	Util.Create("UISizeConstraint", { MinSize = Vector2.new(38, 22), Parent = button })
	Util.Padding(button, 0, 8, 0, 8)
	self._buttonStroke = stroke
	self._keyLabel = Widgets.Label(scope, {
		Style = "Small",
		Weight = Enum.FontWeight.Medium,
		Color = false,
		Properties = {
			Name = "KeyName",
			Size = UDim2.fromScale(0, 1),
			AutomaticSize = Enum.AutomaticSize.X,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTruncate = Enum.TextTruncate.None,
			ZIndex = 2,
			Parent = button,
		},
	})
	Util.List(button, {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})
	self._button = button

	local pressStarted: number? = nil
	self._maid:Add(button.Activated:Connect(function()
		if self._suppressActivate then
			self._suppressActivate = false
			return
		end
		if self.Disabled then
			return
		end
		if self._listening then
			self:_StopListening()
		else
			self:_StartListening()
		end
	end))
	self._maid:Add(button.InputBegan:Connect(function(input: InputObject)
		if self.Disabled then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton2 and not self._listening then
			self:_OpenModeMenu()
		elseif input.UserInputType == Enum.UserInputType.Touch then
			local started = os.clock()
			pressStarted = started
			self._maid:Set(
				"LongPress",
				task.delay(LONG_PRESS, function()
					self._maid:Set("LongPress", nil)
					if pressStarted == started and not self._listening then
						self._suppressActivate = true
						self:_OpenModeMenu()
					end
				end)
			)
		end
	end))
	self._maid:Add(button.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch then
			pressStarted = nil
			self._maid:Clear("LongPress")
		end
	end))
	self._maid:Add(InputManager.TrackState(button, function(state)
		local hovered = state == Enum.GuiState.Hover or state == Enum.GuiState.Press
		if hovered ~= self._hovered then
			self._hovered = hovered
			self:_RenderButton(true)
		end
	end))
	self._maid:Add(scope:Observe(function()
		self:_RenderButton(false)
	end))

	button.Parent = parent
end

--------------------------------------------------------------------------------
-- Binding
--------------------------------------------------------------------------------

function Keybind._Normalize(self: any, value: any): (boolean, any)
	if value == nil or value == false or value == "None" or value == "" then
		return true, nil
	end
	local key = Util.ParseKey(value)
	if key == nil then
		return false, "unrecognised key " .. tostring(value)
	end
	if key.EnumType == Enum.UserInputType then
		if not self._allowMouse then
			return false, "mouse buttons are not allowed for this keybind"
		end
		if key == Enum.UserInputType.MouseButton1 and not self._allowMouse1 then
			return false, "MouseButton1 is not allowed (set AllowMouseButton1 = true)"
		end
	end
	if self._blacklist[key] then
		return false, Util.KeyName(key) .. " cannot be bound here"
	end
	return true, key
end

function Keybind._Emit(self: any, value: any, previous: any)
	Util.SafeCall(self._changedCallback, self:_Describe() .. " ChangedCallback", value)
	self.Changed:Fire(value, previous)
	self._library:_OnComponentChanged(self)
end

function Keybind._StartListening(self: any)
	if self._listening or self._destroyed then
		return
	end
	self._listening = true
	self:_RenderButton(true)
	self._maid:Set(
		"Capture",
		self._context.Input:CaptureNext(function(input: InputObject)
			self:_OnCaptured(input)
		end)
	)
end

function Keybind._StopListening(self: any)
	if not self._listening then
		return
	end
	self._listening = false
	self._maid:Clear("Capture")
	self:_RenderButton(true)
end

function Keybind._OnCaptured(self: any, input: InputObject)
	self._listening = false
	self._maid:Set("Capture", nil)
	local key = InputManager.KeyOf(input)
	if key == Enum.KeyCode.Escape then
		self:_RenderButton(true)
		return
	end
	if key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
		self:Clear()
		self:_RenderButton(true)
		return
	end
	if key == Enum.UserInputType.MouseButton1 and not self._allowMouse1 then
		-- A plain click cancels rebinding.
		self:_RenderButton(true)
		return
	end
	local ok, normalized = self:_Normalize(key)
	if ok then
		if self._active and self.Mode ~= "Toggle" then
			self:_SetActive(false)
		end
		self:_Commit(normalized, false)
	else
		self:_Flash()
	end
	self:_RenderButton(true)
end

-- Unbinds the keybind.
function Keybind.Clear(self: any)
	if self._active and self.Mode == "Hold" then
		self:_SetActive(false)
	end
	self:SetValue(nil)
end

function Keybind.IsListening(self: any): boolean
	return self._listening
end

-- Starts listening for a new key, as if the button was clicked.
function Keybind.Rebind(self: any)
	if not self.Disabled then
		self:_StartListening()
	end
end

--------------------------------------------------------------------------------
-- Activation
--------------------------------------------------------------------------------

function Keybind._OnInputBegan(self: any, input: InputObject, processed: boolean)
	if self.Disabled or self._destroyed or self._listening or self.Value == nil then
		return
	end
	local inputManager = self._context.Input
	if inputManager:IsTyping() then
		return
	end
	local key = InputManager.KeyOf(input)
	if key == nil or key ~= self.Value then
		return
	end
	if processed and key.EnumType == Enum.UserInputType then
		return -- mouse button pressed over a GUI element
	end
	if self.Mode == "Toggle" then
		self:_SetActive(not self._active)
	elseif self.Mode == "Hold" then
		self:_SetActive(true)
	else
		self:_Pulse()
	end
end

function Keybind._OnInputEnded(self: any, input: InputObject)
	if self.Mode ~= "Hold" or not self._active or self.Value == nil then
		return
	end
	if InputManager.KeyOf(input) == self.Value then
		self:_SetActive(false)
	end
end

function Keybind._SetActive(self: any, active: boolean)
	if self._active == active then
		return
	end
	self._active = active
	self:_RenderButton(true)
	Util.SafeCall(self._callback, self:_Describe() .. " callback", active)
	self.Triggered:Fire(active)
	local toggle = self._linkedToggle
	if toggle and not toggle._destroyed and not toggle.Disabled then
		toggle:SetValue(active)
	end
	self._library:_KeybindUpdated(self)
end

function Keybind._Pulse(self: any)
	Util.SafeCall(self._callback, self:_Describe() .. " callback", true)
	self.Triggered:Fire(true)
	self:_Flash(true)
end

-- True while the keybind is active (Toggle/Hold modes).
function Keybind.GetState(self: any): boolean
	return self._active
end

function Keybind.SetMode(self: any, mode: string)
	if not MODES[mode] then
		Log.warn('%s:SetMode: unknown mode "%s"', self:_Describe(), tostring(mode))
		return
	end
	if self.Mode == mode then
		return
	end
	if self._active and self._linkedToggle == nil then
		self:_SetActive(false)
	end
	self.Mode = mode
	self:_RenderButton(true)
	self._library:_OnComponentChanged(self)
	self._library:_KeybindUpdated(self)
end

function Keybind.GetMode(self: any): string
	return self.Mode
end

--------------------------------------------------------------------------------
-- Mode menu
--------------------------------------------------------------------------------

function Keybind._OpenModeMenu(self: any)
	if not self._modeChangeable then
		return
	end
	local popups = self._context.Popups
	if popups:IsOpen(self) then
		popups:Close(self)
		return
	end
	local scope: Theme.Scope = self._scope
	local maid = Maid.new()
	self._maid:Set("ModeMenu", maid)
	local holder = Util.Create("Frame", {
		Name = "KeybindMenu",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(132, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 30,
	})
	maid:Add(holder)
	maid:Add(function()
		scope:Unbind(holder)
	end)
	local panel, _, _ = Widgets.Surface(scope, {
		Background = "DropdownBackground",
		Properties = {
			Name = "Panel",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			ZIndex = 30,
			Parent = holder,
		},
	})
	Util.Padding(panel, 4)
	Util.List(panel, { Padding = UDim.new(0, 1) })

	local function addItem(text: string, order: number, checked: boolean, onClick: () -> ())
		local item = Util.Create("TextButton", {
			Name = text,
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			LayoutOrder = order,
			ZIndex = 30,
			Parent = panel,
		})
		Widgets.Corner(scope, item)
		Util.Padding(item, 0, 8, 0, 8)
		Util.List(item, {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
		})
		local label = Widgets.Label(scope, {
			Text = text,
			Style = "Small",
			Color = if checked then "Accent" else "Text",
			Weight = if checked then Enum.FontWeight.Medium else Enum.FontWeight.Regular,
			Properties = { Size = UDim2.new(0, 0, 1, 0), ZIndex = 30, LayoutOrder = 1, Parent = item },
		})
		Util.Fill(label)
		if checked then
			local check = Icons.Create("Check", { Size = 12, LayoutOrder = 2, ZIndex = 30, Parent = item })
			maid:Add(scope:Observe(function(t)
				check:SetColor(t.Accent)
			end))
		end
		maid:Add(InputManager.TrackState(item, function(state)
			local t = scope:View()
			local hovered = state == Enum.GuiState.Hover or state == Enum.GuiState.Press
			Animator.Play(item, {
				BackgroundColor3 = t.DropdownItemHover,
				BackgroundTransparency = if hovered then 0 else 1,
			}, { Scope = scope, DurationScale = 0.6 })
		end))
		maid:Add(item.Activated:Connect(function()
			popups:Close(self)
			onClick()
		end))
	end

	for index, mode in MODE_ORDER do
		addItem(mode, index, self.Mode == mode, function()
			self:SetMode(mode)
		end)
	end
	addItem("Clear binding", #MODE_ORDER + 1, false, function()
		self:Clear()
	end)

	popups:Open({
		Frame = holder,
		Anchor = self._button,
		Placement = "Below",
		Owner = self,
		OnClose = function()
			self._maid:Set("ModeMenu", nil)
		end,
	})
end

--------------------------------------------------------------------------------
-- Visuals
--------------------------------------------------------------------------------

function Keybind._Flash(self: any, success: boolean?)
	local t = self._scope:View()
	local stroke: UIStroke = self._buttonStroke
	stroke.Color = if success then t.Accent else t.Error
	Animator.Play(stroke, { Color = t.Border }, { Scope = self._scope, DurationScale = 2.5 })
end

function Keybind._RenderButton(self: any, animate: boolean)
	local t = self._scope:View()
	local text
	if self._listening then
		text = "..."
	elseif self.Value == nil then
		text = "None"
	else
		text = Util.KeyName(self.Value)
	end
	self._keyLabel.Text = text
	local textColor = if self.Disabled
		then t.DisabledText
		elseif self._listening or self._active then t.Accent
		elseif self.Value == nil then t.MutedText
		else t.Text
	local strokeColor = if self._listening
		then t.Accent
		elseif self._hovered then t.Border:Lerp(t.Text, 0.15)
		else t.Border
	local background = if self.Disabled then t.Disabled elseif self._hovered then t.Hover else t.Tertiary
	if animate then
		local options = { Scope = self._scope, DurationScale = 0.7 }
		Animator.Play(self._keyLabel, { TextColor3 = textColor }, options)
		Animator.Play(self._buttonStroke, { Color = strokeColor }, options)
		Animator.Play(self._button, { BackgroundColor3 = background }, options)
	else
		Animator.Set(self._keyLabel, { TextColor3 = textColor })
		Animator.Set(self._buttonStroke, { Color = strokeColor })
		Animator.Set(self._button, { BackgroundColor3 = background })
	end
end

function Keybind._Render(self: any, animate: boolean)
	self:_RenderButton(animate)
	self._library:_KeybindUpdated(self)
end

function Keybind._OnNameChanged(self: any, _name: string)
	self._library:_KeybindUpdated(self)
end

function Keybind._OnDisabledChanged(self: any, disabled: boolean)
	self._button.Interactable = not disabled
	self._button.Selectable = not disabled
	if disabled then
		self:_StopListening()
		if self._active and self.Mode == "Hold" then
			self:_SetActive(false)
		end
	end
end

--------------------------------------------------------------------------------
-- Serialisation
--------------------------------------------------------------------------------

function Keybind.Serialize(self: any): any
	return {
		Key = if self.Value then self.Value.Name else false,
		Mode = self.Mode,
	}
end

function Keybind.Deserialize(self: any, data: any): (boolean, string?)
	local key, mode = data, nil
	if type(data) == "table" then
		key, mode = data.Key, data.Mode
	end
	if mode ~= nil then
		if not MODES[mode] then
			return false, "unknown mode " .. tostring(mode)
		end
		self:SetMode(mode)
	end
	local ok, normalized = self:_Normalize(key)
	if not ok then
		return false, tostring(normalized)
	end
	self:_Commit(normalized, false)
	return true, nil
end

function Keybind._OnDestroy(self: any)
	self._listening = false
	self._library:_UntrackKeybind(self)
	self.Triggered:Destroy()
end

return Keybind
end

