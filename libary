-- Prints full tracebacks for callback errors when enabled.
function Library.SetDebug(_self: any, enabled: boolean)
	Log.Verbose = enabled == true
end

--[[
	Destroys every window and notification, disconnects all input listeners
	and clears flags. The library can be used again afterwards.
]]
function Library.Destroy(self: any)
	self.Destroying:Fire()
	for _, window: any in table.clone(self.Windows) do
		window:Destroy()
	end
	table.clear(self.Windows)
	self._notifications:Destroy()
	self._overlay:Destroy()
	self._input:Destroy()
	self.Config:SetAutoSave(nil)
	table.clear(self.Flags)
	self:_ReleaseTitles()
	self._input = InputManager.new()
	self._notifications = Notifications.new(self)
	self._overlay = Overlay.new(self)
end

--[[
	Removes everything this script made: windows, notifications, the
	watermark and keybind list, and every input connection. Functions given
	to OnUnload run first, so you can disconnect your own events there.
	(Same as Destroy.)
]]
function Library.Unload(self: any)
	self:Destroy()
end

-- Runs `callback` when the library is unloaded. Returns the connection.
function Library.OnUnload(self: any, callback: () -> ()): Signal.Connection?
	if type(callback) ~= "function" then
		Log.warn("OnUnload expects a function, got %s", typeof(callback))
		return nil
	end
	return self.Destroying:Connect(callback)
end

local default = Library.new()
return default
end

-- Animator --------------------------------------------------------------------
definitions["Animator"] = function(...)
--[[
	Animator

	The single place where the library creates tweens. Components describe
	*what* should change; the Animator decides *how*, using the animation tokens
	of the caller's theme scope (AnimationsEnabled, AnimationDuration,
	EasingStyle, EasingDirection).

	Guarantees:
	  * No tween is created when animations are disabled or nothing would change.
	  * A new tween on a property supersedes the previous one cleanly. If the
	    previous tween also animated other properties, those are snapped to
	    their targets instead of being left half-way.
	  * TweenInfo objects are cached and completion connections are one-shot,
	    so nothing accumulates over time.
]]

local TweenService = game:GetService("TweenService")

local Animator = {}

type PlayOptions = {
	-- Theme scope providing animation tokens. Defaults are used without one.
	Scope: any?,
	-- Absolute duration in seconds (overrides the theme's AnimationDuration).
	Duration: number?,
	-- Multiplier applied to the resolved duration (e.g. 0.6 for quick hovers).
	DurationScale: number?,
	EasingStyle: Enum.EasingStyle?,
	EasingDirection: Enum.EasingDirection?,
	Delay: number?,
	-- Runs when the animation finishes (immediately when applied instantly).
	-- It does not run when the animation is superseded by another one.
	OnComplete: (() -> ())?,
}

type Record = {
	Tween: Tween,
	Goals: { [string]: any },
}

local DEFAULT_DURATION = 0.18
local DEFAULT_STYLE = Enum.EasingStyle.Quart
local DEFAULT_DIRECTION = Enum.EasingDirection.Out

-- instance -> property -> record. Weak keys: destroyed instances are collected.
local active: { [Instance]: { [string]: Record } } = setmetatable({}, { __mode = "k" }) :: any
local infoCache: { [string]: TweenInfo } = {}

local function resolveSettings(options: PlayOptions?): (boolean, number, Enum.EasingStyle, Enum.EasingDirection)
	local enabled, duration, style, direction = true, DEFAULT_DURATION, DEFAULT_STYLE, DEFAULT_DIRECTION
	local scope = options and options.Scope
	if scope then
		enabled = scope:Get("AnimationsEnabled") ~= false
		duration = scope:Get("AnimationDuration") or duration
		style = scope:Get("EasingStyle") or style
		direction = scope:Get("EasingDirection") or direction
	end
	if options then
		if options.Duration then
			duration = options.Duration
		end
		if options.DurationScale then
			duration *= options.DurationScale
		end
		style = options.EasingStyle or style
		direction = options.EasingDirection or direction
	end
	return enabled, duration, style, direction
end

local function tweenInfo(
	duration: number,
	style: Enum.EasingStyle,
	direction: Enum.EasingDirection,
	delay: number
): TweenInfo
	local key = string.format("%.3f|%s|%s|%.3f", duration, style.Name, direction.Name, delay)
	local cached: TweenInfo? = infoCache[key]
	if cached == nil then
		local created = TweenInfo.new(duration, style, direction, 0, false, delay)
		infoCache[key] = created
		return created
	end
	return cached
end

-- Stops tweens that touch any of `properties`. Their other properties snap to target.
local function release(instance: Instance, properties: { [string]: any })
	local records = active[instance]
	if records == nil then
		return
	end
	local handled: { [Record]: boolean } = {}
	for property in properties do
		local record = records[property]
		if record and not handled[record] then
			handled[record] = true
			for otherProperty, goal in record.Goals do
				if records[otherProperty] == record then
					records[otherProperty] = nil
					if properties[otherProperty] == nil then
						(instance :: any)[otherProperty] = goal
					end
				end
			end
			record.Tween:Cancel()
		end
	end
	if next(records) == nil then
		active[instance] = nil
	end
end

local function assign(instance: Instance, goals: { [string]: any })
	for property, value in goals do
		(instance :: any)[property] = value
	end
end

--[[
	Animates `goals` on `instance`. Returns the Tween, or nil when the change was
	applied instantly (animations disabled, zero duration or nothing to change).
]]
function Animator.Play(instance: Instance, goals: { [string]: any }, options: PlayOptions?): Tween?
	release(instance, goals)
	local onComplete = options and options.OnComplete
	local enabled, duration, style, direction = resolveSettings(options)

	if not enabled or duration <= 0 then
		assign(instance, goals)
		if onComplete then
			onComplete()
		end
		return nil
	end

	local changed = false
	for property, value in goals do
		if (instance :: any)[property] ~= value then
			changed = true
			break
		end
	end
	if not changed then
		if onComplete then
			onComplete()
		end
		return nil
	end

	local delay = if options and options.Delay then options.Delay else 0
	local tween = TweenService:Create(instance, tweenInfo(duration, style, direction, delay), goals)
	local record: Record = { Tween = tween, Goals = goals }
	local records = active[instance]
	if records == nil then
		records = {}
		active[instance] = records
	end
	for property in goals do
		(records :: any)[property] = record
	end

	tween.Completed:Once(function(state: Enum.PlaybackState)
		local current = active[instance]
		if current then
			for property in goals do
				if current[property] == record then
					current[property] = nil
				end
			end
			if next(current) == nil then
				active[instance] = nil
			end
		end
		if state == Enum.PlaybackState.Completed and onComplete then
			onComplete()
		end
	end)
	tween:Play()
	return tween
end

--[[
	A linear, timing-critical tween (for example a notification's countdown
	bar). Unlike Play it ignores AnimationsEnabled, because it represents time
	rather than decoration. Returns the Tween so callers can pause/resume it.
]]
function Animator.Timer(instance: Instance, goals: { [string]: any }, duration: number, onComplete: (() -> ())?): Tween
	release(instance, goals)
	local tween = TweenService:Create(
		instance,
		tweenInfo(math.max(duration, 0), Enum.EasingStyle.Linear, Enum.EasingDirection.Out, 0),
		goals
	)
	local record: Record = { Tween = tween, Goals = goals }
	local records = active[instance]
	if records == nil then
		records = {}
		active[instance] = records
	end
	for property in goals do
		(records :: any)[property] = record
	end
	tween.Completed:Once(function(state: Enum.PlaybackState)
		local current = active[instance]
		if current then
			for property in goals do
				if current[property] == record then
					current[property] = nil
				end
			end
			if next(current) == nil then
				active[instance] = nil
			end
		end
		if state == Enum.PlaybackState.Completed and onComplete then
			onComplete()
		end
	end)
	tween:Play()
	return tween
end

-- Applies `goals` instantly, cancelling any tween on those properties.
function Animator.Set(instance: Instance, goals: { [string]: any })
	release(instance, goals)
	assign(instance, goals)
end

-- Cancels every tween currently running on `instance` (properties stay where they are).
function Animator.Cancel(instance: Instance)
	local records = active[instance]
	if records == nil then
		return
	end
	active[instance] = nil
	local seen: { [Record]: boolean } = {}
	for _, record in records do
		if not seen[record] then
			seen[record] = true
			record.Tween:Cancel()
		end
	end
end

function Animator.IsAnimating(instance: Instance): boolean
	return active[instance] ~= nil
end

-- Number of instances with running tweens (used by leak tests).
function Animator.ActiveCount(): number
	local count = 0
	for _ in active do
		count += 1
	end
	return count
end

return Animator
end

-- Base ------------------------------------------------------------------------
definitions["Base"] = function(...)
--[[
	Base component

	Every component inherits from Base, which provides the shared API:

	    component:SetValue(value, silent?)   component:GetValue()
	    component:SetVisible(visible)        component:SetDisabled(disabled)
	    component:SetName(name)              component:SetDescription(text?)
	    component:SetTooltip(text?)          component:SetTheme(overrides)
	    component:OnChanged(fn)              component:SetCallback(fn)
	    component:Reset()                    component:GetAddons()
	    component:Destroy()

	and the shared fields: Type, Name, Description, Value, Flag, Disabled,
	Visible, Instance, Changed (signal), Destroying (signal).

	Components never reach into windows, tabs or other components. Everything
	they need (theme scope, container, popups, dialogs, input, library flags)
	arrives through the context table built by Section, which is what keeps
	components reusable and independently testable.

	Writing a custom component:

	    local MyThing = Lattice.BaseComponent.extend("MyThing", {
	        Default = { Type = "number", Default = 0 },
	    })
	    function MyThing.new(context, options)
	        local self = setmetatable({}, MyThing)
	        local resolved = self:_Init(context, options)
	        self:_InitValue(resolved.Default)
	        local root = self:_CreateRoot()
	        self:_BuildInlineRow(root)
	        ... build your control, then:
	        self:_Mount()
	        return self
	    end
	    function MyThing:_Render(animate) ... end
	    Lattice:RegisterComponent("MyThing", MyThing)
]]

local Log = import("Log")
local Maid = import("Maid")
local Options = import("Options")
local Signal = import("Signal")
local State = import("State")
local Theme = import("Theme")
local Util = import("Util")
local Widgets = import("Widgets")

type Context = {
	Library: any,
	Window: any,
	Tab: any,
	Section: any,
	Scope: Theme.Scope,
	Container: GuiObject,
	Order: number,
	Input: any,
	Popups: any,
	Tooltips: any,
	Dialogs: any,
	GetScale: () -> number,
	Path: string,
	Remove: (component: any) -> (),
	Host: any?,
}

local Base = {}
Base.__index = Base
Base.ClassName = "Component"
Base.Serializable = false

-- Options understood by every component.
Base.Schema = {
	Name = { Type = "string" },
	Description = { Type = "string" },
	Tooltip = { Type = "string" },
	Flag = { Type = "string" },
	Save = { Type = "boolean" },
	Disabled = { Type = "boolean", Default = false },
	Visible = { Type = "boolean", Default = true },
	Order = { Type = "number" },
	Theme = { Type = "table" },
	Callback = { Type = "function" },
} :: Options.Schema

Base.Aliases = {
	Text = "Name",
	Title = "Name",
	Content = "Description",
} :: { [string]: string }

--[[
	Creates a component class inheriting from Base. `schema` adds options on
	top of the shared ones and `aliases` maps alternative option names.
]]
function Base.extend(name: string, schema: Options.Schema?, aliases: { [string]: string }?): any
	local Class = setmetatable({}, { __index = Base })
	Class.__index = Class
	Class.ClassName = name
	Class.Schema = Options.Extend(Base.Schema, schema or {})
	Class.Aliases = Util.Merge(Base.Aliases, aliases)
	return Class
end

--------------------------------------------------------------------------------
-- Initialisation helpers (used by subclasses)
--------------------------------------------------------------------------------

function Base._Init(self: any, context: Context, rawOptions: any): { [string]: any }
	local Class = getmetatable(self)
	local options = Options.Resolve("Add" .. Class.ClassName, rawOptions, Class.Schema, Class.Aliases)
	self.Type = Class.ClassName
	self.Name = options.Name or Class.DefaultName or Class.ClassName
	self.Description = options.Description
	self.Tooltip = options.Tooltip
	self.Disabled = options.Disabled
	self.Visible = options.Visible
	self.Options = options
	self.Destroying = Signal.new()
	self._context = context
	self._library = context.Library
	self._maid = Maid.new()
	self._scope = context.Scope:Extend()
	self._callback = options.Callback
	self._destroyed = false
	self._addons = {}
	if options.Theme then
		self._scope:Set(options.Theme)
	end
	return options
end

-- Sets up value storage for components that have a value.
function Base._InitValue(self: any, initial: any, equals: ((any, any) -> boolean)?)
	self._state = State.new(initial, equals, Util.Describe(self.Type, self.Name) .. " Changed")
	self.Changed = self._state.Changed
	self.Value = initial
	self.Default = initial
end

-- Readable label used in warnings, e.g. 'Toggle "Enabled"'.
function Base._Describe(self: any): string
	return Util.Describe(self.Type, self.Name)
end

--[[
	Creates the component's root row. It sizes itself to its content and is
	placed in the section by LayoutOrder.
]]
function Base._CreateRoot(self: any, className: string?, properties: { [string]: any }?): GuiObject
	local props: { [string]: any } = {
		Name = self.Type,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = self.Options.Order or self._context.Order,
		Visible = self.Visible,
		ZIndex = 2,
	}
	if properties then
		for key, value in properties do
			props[key] = value
		end
	end
	local root = Util.Create(className or "Frame", props)
	if className == "TextButton" then
		root.Selectable = true
	end
	self._maid:Add(root)
	self.Instance = root
	return root
end

-- Name label with an optional description below it, filling the free width.
function Base._BuildTextBlock(self: any, parent: Instance, layoutOrder: number?, nameWeight: Enum.FontWeight?): Frame
	local scope: Theme.Scope = self._scope
	local block = Util.Create("Frame", {
		Name = "Text",
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = layoutOrder or 1,
		ZIndex = 2,
		Parent = parent,
	})
	Util.Fill(block)
	Util.List(block, { Padding = UDim.new(0, 2) })
	self._textBlock = block
	self._nameLabel = Widgets.Label(scope, {
		Text = self.Name,
		Wrapped = true,
		Color = false,
		Weight = nameWeight,
		RichText = self.Options.RichText == true,
		Properties = {
			Name = "Name",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 1,
			ZIndex = 2,
			Parent = block,
		},
	})
	if self.Description and self.Description ~= "" then
		self:_EnsureDescription()
	end
	self._maid:Add(scope:Observe(function()
		self:_RenderText()
	end))
	return block
end

function Base._EnsureDescription(self: any): TextLabel?
	if self._descriptionLabel or self._textBlock == nil then
		return self._descriptionLabel
	end
	self._descriptionLabel = Widgets.Label(self._scope, {
		Text = self.Description or "",
		Style = "Small",
		Wrapped = true,
		Color = false,
		RichText = self.Options.RichText == true,
		Properties = {
			Name = "Description",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 2,
			ZIndex = 2,
			Parent = self._textBlock,
		},
	})
	self:_RenderText()
	return self._descriptionLabel
end

function Base._RenderText(self: any)
	local t = self._scope:View()
	if self._nameLabel then
		self._nameLabel.TextColor3 = if self.Disabled then t.DisabledText else t.Text
	end
	if self._descriptionLabel then
		self._descriptionLabel.TextColor3 = if self.Disabled then t.DisabledText else t.MutedText
	end
end

--[[
	Turns `root` into a horizontal row: [text block][addons][control].
	Returns the text block. Subclasses parent their control to `root` with
	LayoutOrder 3.
]]
function Base._BuildInlineRow(self: any, root: GuiObject): Frame
	Util.List(root, {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 10),
	})
	return self:_BuildTextBlock(root, 1)
end

-- Container for inline addons (keybinds, colour pickers) attached to this row.
function Base._GetAddonsFrame(self: any): Frame
	if self._addonsFrame then
		return self._addonsFrame
	end
	local frame = Util.Create("Frame", {
		Name = "Addons",
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 0, 0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = 2,
		ZIndex = 2,
		Parent = self.Instance,
	})
	Util.List(frame, {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
	})
	self._addonsFrame = frame
	return frame
end

-- Final step of construction: parent into the section and hook shared behaviour.
function Base._Mount(self: any)
	local root: GuiObject = self.Instance
	local context: Context = self._context
	self._maid:Add(context.Tooltips:Attach(self._tooltipTarget or root, function()
		return self.Tooltip
	end))
	if self.Disabled then
		self:_ApplyDisabled()
	end
	root.Parent = context.Container
	local Class = getmetatable(self)
	if Class.Serializable or self.Options.Flag then
		self._library:_RegisterFlag(self, self.Options.Flag, context.Path)
	end
end

--------------------------------------------------------------------------------
-- Value
--------------------------------------------------------------------------------

function Base.GetValue(self: any): any
	return self.Value
end

--[[
	Validates and normalises a candidate value. Subclasses override this and
	return (true, normalised) or (false, reason).
]]
function Base._Normalize(_self: any, value: any): (boolean, any)
	return true, value
end

--[[
	Sets the value. Invalid values are reported and ignored. When `silent` is
	true the UI updates but Callback and Changed do not fire. Returns true if
	the value changed.
]]
function Base.SetValue(self: any, value: any, silent: boolean?): boolean
	if self._destroyed then
		return false
	end
	if self._state == nil then
		Log.warn("%s has no value", self:_Describe())
		return false
	end
	local ok, normalized = self:_Normalize(value)
	if not ok then
		Log.warn("%s:SetValue: %s", self:_Describe(), tostring(normalized))
		return false
	end
	return self:_Commit(normalized, silent)
end

function Base._Commit(self: any, value: any, silent: boolean?): boolean
	local previous = self.Value
	if not self._state:Set(value, true) then
		return false
	end
	self.Value = value
	self:_Render(true)
	if not silent then
		self:_Emit(value, previous)
	end
	return true
end

-- Fires the callback and the Changed signal, and notifies the config system.
function Base._Emit(self: any, value: any, previous: any)
	Util.SafeCall(self._callback, self:_Describe() .. " callback", value)
	self.Changed:Fire(value, previous)
	self._library:_OnComponentChanged(self)
end

-- Restores the value the component was created with.
function Base.Reset(self: any)
	if self._state then
		self:SetValue(self.Default)
	end
end

-- Updates visuals from the current value/state. Subclasses override.
function Base._Render(_self: any, _animate: boolean) end

--------------------------------------------------------------------------------
-- Serialisation (configuration system)
--------------------------------------------------------------------------------

-- Returns a JSON-compatible representation of the value.
function Base.Serialize(self: any): any
	return self.Value
end

-- Applies a value produced by Serialize. Returns false (plus reason) if invalid.
function Base.Deserialize(self: any, data: any): (boolean, string?)
	local ok, normalized = self:_Normalize(data)
	if not ok then
		return false, tostring(normalized)
	end
	self:_Commit(normalized, false)
	return true, nil
end

--------------------------------------------------------------------------------
-- Shared API
--------------------------------------------------------------------------------

function Base.OnChanged(self: any, callback: (any, any) -> ()): Signal.Connection?
	if self.Changed == nil then
		Log.warn("%s has no value to observe", self:_Describe())
		return nil
	end
	return self.Changed:Connect(callback)
end

function Base.SetCallback(self: any, callback: ((...any) -> ())?)
	if callback ~= nil and type(callback) ~= "function" then
		Log.warn("%s:SetCallback expects a function", self:_Describe())
		return
	end
	self._callback = callback
end

function Base.SetName(self: any, name: string)
	if type(name) ~= "string" then
		Log.warn("%s:SetName expects a string", self:_Describe())
		return
	end
	self.Name = name
	if self._nameLabel then
		self._nameLabel.Text = name
	end
	self:_OnNameChanged(name)
end

function Base._OnNameChanged(_self: any, _name: string) end

function Base.SetDescription(self: any, description: string?)
	self.Description = description
	if description == nil or description == "" then
		if self._descriptionLabel then
			self._scope:Unbind(self._descriptionLabel)
			self._descriptionLabel:Destroy()
			self._descriptionLabel = nil
		end
		return
	end
	local label = self:_EnsureDescription()
	if label then
		label.Text = description
	end
end

function Base.SetTooltip(self: any, tooltip: string?)
	self.Tooltip = tooltip
end

function Base.SetVisible(self: any, visible: boolean)
	self.Visible = visible == true
	if self.Instance then
		self.Instance.Visible = self.Visible
	end
	if not self.Visible then
		self._context.Popups:Close(self)
	end
end

function Base.SetDisabled(self: any, disabled: boolean)
	disabled = disabled == true
	if self.Disabled == disabled then
		return
	end
	self.Disabled = disabled
	self:_ApplyDisabled()
end

function Base._ApplyDisabled(self: any)
	if self.Disabled then
		self._context.Popups:Close(self)
	end
	self:_RenderText()
	self:_OnDisabledChanged(self.Disabled)
	self:_Render(true)
end

function Base._OnDisabledChanged(_self: any, _disabled: boolean) end

function Base.SetTheme(self: any, overrides: { [string]: any })
	self._scope:Set(overrides)
end

function Base.IsDestroyed(self: any): boolean
	return self._destroyed
end

--------------------------------------------------------------------------------
-- Addons
--------------------------------------------------------------------------------

-- Attaches a compact Keybind or ColorPicker to the right side of this row.
function Base._AttachAddon(self: any, kind: string, options: any): any
	if self._destroyed then
		return nil
	end
	local Class = self._library:_GetComponentClass(kind)
	local resolved: any = if type(options) == "table"
		then table.clone(options)
		elseif type(options) == "string" then { Name = options }
		else {}
	if resolved.Name == nil then
		resolved.Name = self.Name
	end
	local context = table.clone(self._context)
	context.Scope = self._scope
	context.Container = self:_GetAddonsFrame()
	context.Order = #self._addons + 1
	context.Host = self
	context.Path = self._context.Path .. "/" .. self.Name
	context.Remove = function(addon: any)
		local index = table.find(self._addons, addon)
		if index then
			table.remove(self._addons, index)
		end
	end
	local addon = Class.new(context, resolved)
	table.insert(self._addons, addon)
	return addon
end

-- Components attached to this one: a toggle's keybind or colour picker, or
-- the buttons sharing a button's row.
function Base.GetAddons(self: any): { any }
	return table.clone(self._addons)
end

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

function Base._OnDestroy(_self: any) end

-- Destroys the component, its addons, instances, connections and theme scope.
function Base.Destroy(self: any)
	if self._destroyed then
		return
	end
	self._destroyed = true
	self.Destroying:Fire()
	self._context.Popups:Close(self)
	for _, addon: any in table.clone(self._addons) do
		addon:Destroy()
	end
	self:_OnDestroy()
	self._library:_UnregisterFlag(self)
	self._maid:Destroy()
	self._scope:Destroy()
	if self._state then
		self._state:Destroy()
	end
	self.Destroying:Destroy()
	self._context.Remove(self)
	Util.Retire(self)
end

return Base
end

-- Button ----------------------------------------------------------------------
definitions["Button"] = function(...)
--[[
	Button

	    local Button = Section:AddButton({
	        Name = "Execute",
	        Description = "Run the action",
	        Variant = "Primary",          -- "Default" | "Primary" | "Danger" | "Ghost"
	        Confirm = "This cannot be undone.", -- optional confirmation
	        Callback = function() print("Clicked") end,
	    })

	    Button:AddButton({ Name = "Secondary action" }) -- shares the row
	    Button:Press()                                   -- run the callback in code

	`Confirm` accepts true, a description string, or a table:
	{ Title, Description, ConfirmText, CancelText, Variant, Mode = "Dialog" | "Inline" }.
	Inline mode asks for a second click on the button instead of a dialog.

	A button's value is its label text (GetValue/SetValue), for API symmetry.
]]

local Log = import("Log")
local Signal = import("Signal")
local Util = import("Util")
local Widgets = import("Widgets")

local Base = import("Base")

local VARIANTS = { Default = true, Primary = true, Danger = true, Ghost = true }

local Button = Base.extend("Button", {
	Variant = {
		Type = "string",
		Default = "Default",
		Validate = function(value)
			return VARIANTS[value] == true, 'must be "Default", "Primary", "Danger" or "Ghost"'
		end,
	},
	Confirm = { Type = "boolean|string|table" },
})
Button.DefaultName = "Button"

local CONFIRM_TIMEOUT = 3

function Button.new(context: Base.Context, options: any)
	local self: any = setmetatable({}, Button)
	local resolved = self:_Init(context, options)
	self.Variant = resolved.Variant
	self.Pressed = Signal.new(self:_Describe() .. " Pressed")

	local host = context.Host
	local row
	if host and host._row then
		row = host._row
	else
		row = self:_CreateRoot()
		local layout = Util.List(row, { FillDirection = Enum.FillDirection.Horizontal })
		self._scope:Bind(layout, "Padding", function(t)
			return UDim.new(0, t.Spacing)
		end)
		self._row = row
	end

	local widget = Widgets.Button(self._scope, {
		Text = self.Name,
		Description = self.Description,
		Variant = self.Variant,
		Fill = true,
		LayoutOrder = if host then context.Order + 1 else 0,
		Name = "Button",
	})
	self._widget = widget
	self._maid:Add(widget)
	self._maid:Add(widget.Activated:Connect(function()
		self:_Activate()
	end))

	if host then
		-- A sibling button lives inside its host's row.
		self.Instance = widget.Instance
		self._tooltipTarget = widget.Instance
		self._maid:Add(context.Tooltips:Attach(widget.Instance, function()
			return self.Tooltip
		end))
		widget.Instance.Parent = row
		if self.Disabled then
			self:_ApplyDisabled()
		end
		if resolved.Flag then
			self._library:_RegisterFlag(self, resolved.Flag, context.Path)
		end
	else
		widget.Instance.Parent = row
		self._tooltipTarget = widget.Instance
		self:_Mount()
	end
	return self
end

function Button._Activate(self: any)
	if self.Disabled or self._destroyed then
		return
	end
	local confirm = self.Options.Confirm
	if not confirm then
		self:Press()
		return
	end
	local settings: { [string]: any } = if type(confirm) == "table"
		then confirm
		elseif type(confirm) == "string" then { Description = confirm }
		else {}

	if settings.Mode == "Inline" then
		if self._confirming then
			self:_EndConfirm()
			self:Press()
			return
		end
		self._confirming = true
		self._widget:SetText(settings.ConfirmText or "Click again to confirm")
		self._widget:SetHighlight(self._scope:Get("Warning"))
		self._maid:Set(
			"ConfirmTimeout",
			task.delay(CONFIRM_TIMEOUT, function()
				self._maid:Set("ConfirmTimeout", nil)
				self:_EndConfirm()
			end)
		)
		return
	end

	self._context.Dialogs:Confirm({
		Title = settings.Title or self.Name,
		Description = settings.Description or settings.Text or "Are you sure you want to continue?",
		ConfirmText = settings.ConfirmText,
		CancelText = settings.CancelText,
		Variant = settings.Variant or (if self.Variant == "Danger" then "Danger" else "Primary"),
	}, function(confirmed: boolean)
		if confirmed and not self._destroyed and not self.Disabled then
			self:Press()
		end
	end)
end

function Button._EndConfirm(self: any)
	if not self._confirming then
		return
	end
	self._confirming = false
	self._maid:Clear("ConfirmTimeout")
	self._widget:SetText(self.Name)
	self._widget:SetHighlight(nil)
end

-- Runs the button's callback (skipping any confirmation).
function Button.Press(self: any)
	if self._destroyed then
		return
	end
	Util.SafeCall(self._callback, self:_Describe() .. " callback")
	self.Pressed:Fire()
end

-- Adds another button that shares this button's row, each taking equal width.
function Button.AddButton(self: any, options: any, callback: any): any
	if self._row == nil then
		Log.warn("%s:AddButton: only top-level buttons can host other buttons", self:_Describe())
		return nil
	end
	local resolved: any = if type(options) == "table"
		then table.clone(options)
		elseif type(options) == "string" then { Name = options }
		else {}
	if callback ~= nil and resolved.Callback == nil then
		resolved.Callback = callback
	end
	local context = table.clone(self._context)
	context.Scope = self._context.Scope
	context.Container = self._row
	context.Order = #self._addons + 1
	context.Host = self
	context.Remove = function(addon: any)
		local index = table.find(self._addons, addon)
		if index then
			table.remove(self._addons, index)
		end
	end
	local sibling = Button.new(context, resolved)
	table.insert(self._addons, sibling)
	return sibling
end

function Button.SetVariant(self: any, variant: string)
	if not VARIANTS[variant] then
		Log.warn('%s:SetVariant: unknown variant "%s"', self:_Describe(), tostring(variant))
		return
	end
	self.Variant = variant
	self._widget:SetVariant(variant)
end

-- A button's value is its label.
function Button.GetValue(self: any): string
	return self.Name
end

function Button.SetValue(self: any, value: any): boolean
	if type(value) ~= "string" then
		Log.warn("%s:SetValue expects a string label", self:_Describe())
		return false
	end
	self:SetName(value)
	return true
end

function Button._OnNameChanged(self: any, name: string)
	if not self._confirming then
		self._widget:SetText(name)
	end
end

function Button.SetDescription(self: any, description: string?)
	self.Description = description
	self._widget:SetDescription(description)
end

function Button._OnDisabledChanged(self: any, disabled: boolean)
	self._widget:SetDisabled(disabled)
	if disabled then
		self:_EndConfirm()
	end
end

function Button._OnDestroy(self: any)
	self.Pressed:Destroy()
end

return Button
end

-- ColorPicker -----------------------------------------------------------------
definitions["ColorPicker"] = function(...)
--[[
	ColorPicker

	    local Picker = Section:AddColorPicker({
	        Name = "Highlight",
	        Default = Color3.fromRGB(255, 90, 90),   -- or "#FF5A5A"
	        Transparency = 0,     -- include to enable the transparency slider
	        Callback = function(color, transparency) end,
	    })

	    Picker:SetValue(Color3.new(0, 1, 0))
	    Picker:SetValueRGB(255, 128, 0)
	    Picker:SetValueHSV(0.6, 0.8, 1)
	    Picker:SetHex("#3B82F6")
	    Picker:SetTransparency(0.25)
	    print(Picker:GetValue(), Picker:GetHex(), Picker:GetHSV())

	Clicking the swatch opens a panel with a saturation/value area, a hue strip,
	an optional transparency strip, and hex/RGB fields. Hue and saturation are
	stored separately from the RGB value so they survive passing through greys
	and black while dragging.
]]

local Animator = import("Animator")
local InputManager = import("InputManager")
local Log = import("Log")
local Maid = import("Maid")
local Theme = import("Theme")
local Util = import("Util")
local Widgets = import("Widgets")

local Base = import("Base")

local ColorPicker = Base.extend("ColorPicker", {
	Default = { Type = "Color3|string|table", Default = Color3.new(1, 1, 1) },
	Transparency = {
		Type = "number",
		Validate = function(value)
			return value >= 0 and value <= 1, "must be between 0 and 1"
		end,
	},
}, { Value = "Default", Color = "Default", Alpha = "Transparency" })
ColorPicker.DefaultName = "Color"
ColorPicker.Serializable = true

local PANEL_WIDTH = 236
local AREA_HEIGHT = 150
local STRIP_WIDTH = 14
local ALPHA_HEIGHT = 12
local FIELD_HEIGHT = 26
local CHECKER_LIGHT = Color3.fromRGB(205, 205, 210)
local CHECKER_DARK = Color3.fromRGB(150, 150, 158)

local function hueSequence(): ColorSequence
	local keypoints = {}
	for index = 0, 6 do
		table.insert(keypoints, ColorSequenceKeypoint.new(index / 6, Color3.fromHSV((index % 6) / 6, 1, 1)))
	end
	return ColorSequence.new(keypoints)
end

-- Fills `parent` with a checkerboard (used behind transparent colours).
local function buildChecker(parent: GuiObject, columns: number, rows: number, zIndex: number)
	local holder = Util.Create("Frame", {
		Name = "Checker",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ClipsDescendants = true,
		ZIndex = zIndex,
		Parent = parent,
	})
	for row = 0, rows - 1 do
		for column = 0, columns - 1 do
			Util.Create("Frame", {
				Size = UDim2.fromScale(1 / columns, 1 / rows),
				Position = UDim2.fromScale(column / columns, row / rows),
				BackgroundColor3 = if (row + column) % 2 == 0 then CHECKER_LIGHT else CHECKER_DARK,
				ZIndex = zIndex,
				Parent = holder,
			})
		end
	end
	return holder
end

function ColorPicker.new(context: any, options: any)
	local self: any = setmetatable({}, ColorPicker)
	local resolved = self:_Init(context, options)
	self.HasTransparency = resolved.Transparency ~= nil
	self.Transparency = resolved.Transparency or 0

	local color = Util.ToColor3(resolved.Default)
	if color == nil then
		Log.warn("%s: Default is not a valid colour; using white", self:_Describe())
		color = Color3.new(1, 1, 1)
	end
	local h, s, v = (color :: Color3):ToHSV()
	self._h, self._s, self._v = h, s, v
	self:_InitValue(color)
	self._hovered = false
	self._open = false

	local host = context.Host
	if host then
		self:_BuildSwatch(context.Container, context.Order)
		self.Instance = self._swatch
		self._maid:Add(self._swatch)
		self._maid:Add(context.Tooltips:Attach(self._swatch, function()
			return self.Tooltip
		end))
		if self.Disabled then
			self:_ApplyDisabled()
		end
		self._swatch.Parent = context.Container
		self._library:_RegisterFlag(self, resolved.Flag, context.Path)
	else
		local root = self:_CreateRoot()
		self:_BuildInlineRow(root)
		self:_BuildSwatch(root, 3)
		self:_Mount()
	end
	return self
end

--------------------------------------------------------------------------------
-- Swatch
--------------------------------------------------------------------------------

function ColorPicker._BuildSwatch(self: any, parent: Instance, order: number)
	local scope: Theme.Scope = self._scope
	local swatch = Util.Create("TextButton", {
		Name = "Swatch",
		Size = UDim2.fromOffset(30, 18),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Selectable = true,
		ZIndex = 2,
		Parent = parent,
	})
	if self.HasTransparency then
		local checker = buildChecker(swatch, 4, 2, 2)
		checker.Size = UDim2.new(1, -2, 1, -2)
		checker.Position = UDim2.fromOffset(1, 1)
	end
	local fill = Util.Create("Frame", {
		Name = "Color",
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
		Parent = swatch,
	})
	local corner = Util.Create("UICorner", { Parent = fill })
	scope:Bind(corner, "CornerRadius", function(t)
		return UDim.new(0, math.max(3, t.CornerRadius - 2))
	end)
	local stroke = Util.Create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = fill,
	})
	scope:Bind(stroke, "Thickness", "StrokeThickness")
	self._swatch = swatch
	self._swatchFill = fill
	self._swatchStroke = stroke

	self._maid:Add(swatch.Activated:Connect(function()
		if self._open then
			self:Close()
		else
			self:Open()
		end
	end))
	self._maid:Add(InputManager.TrackState(swatch, function(state)
		local hovered = state == Enum.GuiState.Hover or state == Enum.GuiState.Press
		if hovered ~= self._hovered then
			self._hovered = hovered
			self:_RenderSwatch(true)
		end
	end))
	self._maid:Add(scope:Observe(function()
		self:_Render(false)
	end))
end

function ColorPicker._RenderSwatch(self: any, animate: boolean)
	local t = self._scope:View()
	local strokeColor = if self._open then t.Accent elseif self._hovered then t.Border:Lerp(t.Text, 0.25) else t.Border
	self._swatchFill.BackgroundColor3 = self.Value
	self._swatchFill.BackgroundTransparency = if self.Disabled then 0.6 else self.Transparency
	if animate then
		Animator.Play(self._swatchStroke, { Color = strokeColor }, { Scope = self._scope, DurationScale = 0.7 })
	else
		Animator.Set(self._swatchStroke, { Color = strokeColor })
	end
end

--------------------------------------------------------------------------------
-- Value
--------------------------------------------------------------------------------

function ColorPicker._Normalize(_self: any, value: any): (boolean, any)
	local color = Util.ToColor3(value)
	if color == nil then
		return false, "expected a Color3 or hex string, got " .. typeof(value)
	end
	return true, color
end

-- Applies a colour from HSV components (the internal source of truth).
function ColorPicker._ApplyHSV(self: any, h: number, s: number, v: number, transparency: number?, silent: boolean?)
	self._h, self._s, self._v = math.clamp(h, 0, 1), math.clamp(s, 0, 1), math.clamp(v, 0, 1)
	local color = Color3.fromHSV(self._h, self._s, self._v)
	local nextTransparency = math.clamp(transparency or self.Transparency, 0, 1)
	local changed = color ~= self.Value or nextTransparency ~= self.Transparency
	local previous = self.Value
	self.Transparency = nextTransparency
	if color ~= self.Value then
		self._state:Set(color, true)
		self.Value = color
	end
	self:_Render(false)
	if changed and not silent then
		self:_Emit(color, previous)
	end
	return changed
end

function ColorPicker._Commit(self: any, color: Color3, silent: boolean?): boolean
	local h, s, v = color:ToHSV()
	-- Keep hue/saturation when the colour carries no information about them.
	if v == 0 then
		h, s = self._h, self._s
	elseif s == 0 then
		h = self._h
	end
	return self:_ApplyHSV(h, s, v, nil, silent)
end

function ColorPicker._Emit(self: any, color: Color3, previous: Color3)
	Util.SafeCall(self._callback, self:_Describe() .. " callback", color, self.Transparency)
	self.Changed:Fire(color, previous)
	self._library:_OnComponentChanged(self)
end

--[[
	Sets the colour (Color3 or hex string) and optionally the transparency.
	Like every component, `SetValue(value, true)` updates silently (no
	callback); `SetValue(value, transparency, true)` does both.
]]
function ColorPicker.SetValue(self: any, value: any, transparency: any, silent: boolean?): boolean
	if self._destroyed then
		return false
	end
	if type(transparency) == "boolean" then
		silent = transparency
		transparency = nil
	end
	local ok, color = self:_Normalize(value)
	if not ok then
		Log.warn("%s:SetValue: %s", self:_Describe(), tostring(color))
		return false
	end
	if transparency ~= nil and type(transparency) ~= "number" then
		Log.warn("%s:SetValue: transparency must be a number", self:_Describe())
		return false
	end
	local h, s, v = (color :: Color3):ToHSV()
	if v == 0 then
		h, s = self._h, self._s
	elseif s == 0 then
		h = self._h
	end
	return self:_ApplyHSV(h, s, v, transparency, silent)
end

function ColorPicker.SetValueRGB(self: any, r: number, g: number, b: number, transparency: number?): boolean
	if type(r) ~= "number" or type(g) ~= "number" or type(b) ~= "number" then
		Log.warn("%s:SetValueRGB expects three numbers from 0 to 255", self:_Describe())
		return false
	end
	return self:SetValue(
		Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255)),
		transparency
	)
end

function ColorPicker.SetValueHSV(self: any, h: number, s: number, v: number, transparency: number?): boolean
	if type(h) ~= "number" or type(s) ~= "number" or type(v) ~= "number" then
		Log.warn("%s:SetValueHSV expects three numbers from 0 to 1", self:_Describe())
		return false
	end
	return self:_ApplyHSV(h, s, v, transparency, false)
end

function ColorPicker.SetHex(self: any, hex: string, transparency: number?): boolean
	return self:SetValue(hex, transparency)
end

function ColorPicker.SetTransparency(self: any, transparency: number): boolean
	if type(transparency) ~= "number" then
		Log.warn("%s:SetTransparency expects a number from 0 to 1", self:_Describe())
		return false
	end
	return self:_ApplyHSV(self._h, self._s, self._v, transparency, false)
end

function ColorPicker.GetTransparency(self: any): number
	return self.Transparency
end

function ColorPicker.GetHex(self: any): string
	return Util.ToHex(self.Value)
end

function ColorPicker.GetHSV(self: any): (number, number, number)
	return self._h, self._s, self._v
end

function ColorPicker.GetRGB(self: any): (number, number, number)
	local color: Color3 = self.Value
	return math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5)
end

function ColorPicker.Serialize(self: any): any
	return { Hex = Util.ToHex(self.Value), Transparency = self.Transparency }
end

function ColorPicker.Deserialize(self: any, data: any): (boolean, string?)
	local hex, transparency = data, nil
	if type(data) == "table" and data.Hex ~= nil then
		hex, transparency = data.Hex, data.Transparency
	end
	local color = Util.ToColor3(hex)
	if color == nil then
		return false, "invalid colour"
	end
	if transparency ~= nil and type(transparency) ~= "number" then
		return false, "invalid transparency"
	end
	self:SetValue(color, transparency)
	return true, nil
end

