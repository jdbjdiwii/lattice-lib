	    local Toggle = Section:AddToggle({
	        Name = "Enabled",
	        Description = "Turn the system on",
	        Default = false,
	        Style = "Switch",            -- or "Checkbox"
	        Confirm = { When = "Enable", Description = "This affects everyone." },
	        Callback = function(value) print(value) end,
	    })

	    Toggle:SetValue(true)
	    print(Toggle:GetValue())

	    -- Compact addons on the same row:
	    Toggle:AddKeybind({ Default = Enum.KeyCode.F })   -- pressing F toggles it
	    Toggle:AddColorPicker({ Default = Color3.new(1, 0, 0) })

	The whole row is clickable. `Confirm` accepts true, a description string or
	{ Title, Description, ConfirmText, CancelText, When = "Enable" | "Disable" | "Both" }.
	Confirmation only applies to user clicks, never to SetValue.
]]

local Animator = import("Animator")
local Icons = import("Icons")
local InputManager = import("InputManager")
local Util = import("Util")

local Base = import("Base")

local Toggle = Base.extend("Toggle", {
	Default = { Type = "boolean", Default = false },
	Style = {
		Type = "string",
		Default = "Switch",
		Validate = function(value)
			return value == "Switch" or value == "Checkbox", 'must be "Switch" or "Checkbox"'
		end,
	},
	Confirm = { Type = "boolean|string|table" },
}, { Value = "Default" })
Toggle.DefaultName = "Toggle"
Toggle.Serializable = true

local TRACK_WIDTH = 34
local TRACK_HEIGHT = 18
local KNOB_SIZE = 12
local CHECKBOX_SIZE = 18

function Toggle.new(context: any, options: any)
	local self: any = setmetatable({}, Toggle)
	local resolved = self:_Init(context, options)
	self:_InitValue(resolved.Default)
	self.Style = resolved.Style
	self._hovered = false

	local root = self:_CreateRoot("TextButton")
	self:_BuildInlineRow(root)

	local scope = self._scope
	if self.Style == "Checkbox" then
		local box = Util.Create("Frame", {
			Name = "Checkbox",
			Size = UDim2.fromOffset(CHECKBOX_SIZE, CHECKBOX_SIZE),
			LayoutOrder = 3,
			ZIndex = 2,
			Parent = root,
		})
		local corner = Util.Create("UICorner", { Parent = box })
		scope:Bind(corner, "CornerRadius", function(t: any)
			return UDim.new(0, math.max(3, t.CornerRadius - 2))
		end)
		self._boxStroke = Util.Create("UIStroke", {
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = box,
		})
		scope:Bind(self._boxStroke, "Thickness", "StrokeThickness")
		self._check = Icons.Create("Check", {
			Size = 14,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			ZIndex = 2,
			Parent = box,
		})
		self._box = box
	else
		local track = Util.Create("Frame", {
			Name = "Switch",
			Size = UDim2.fromOffset(TRACK_WIDTH, TRACK_HEIGHT),
			LayoutOrder = 3,
			ZIndex = 2,
			Parent = root,
		})
		Util.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })
		local knob = Util.Create("Frame", {
			Name = "Knob",
			AnchorPoint = Vector2.new(0, 0.5),
			Size = UDim2.fromOffset(KNOB_SIZE, KNOB_SIZE),
			ZIndex = 3,
			Parent = track,
		})
		Util.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })
		self._track = track
		self._knob = knob
	end

	self._maid:Add(root.Activated:Connect(function()
		self:_UserToggle()
	end))
	self._maid:Add(InputManager.TrackState(root, function(state)
		local hovered = state == Enum.GuiState.Hover or state == Enum.GuiState.Press
		if hovered ~= self._hovered then
			self._hovered = hovered
			self:_Render(true)
		end
	end))
	self._maid:Add(scope:Observe(function()
		self:_Render(false)
	end))

	self:_Mount()
	return self
end

function Toggle._Normalize(_self: any, value: any): (boolean, any)
	if type(value) ~= "boolean" then
		return false, "expected a boolean, got " .. typeof(value)
	end
	return true, value
end

function Toggle._UserToggle(self: any)
	if self.Disabled or self._destroyed then
		return
	end
	local target = not self.Value
	local confirm = self.Options.Confirm
	if confirm then
		local settings: { [string]: any } = if type(confirm) == "table"
			then confirm
			elseif type(confirm) == "string" then { Description = confirm }
			else {}
		local when = settings.When or "Enable"
		local needed = when == "Both" or (when == "Enable" and target) or (when == "Disable" and not target)
		if needed then
			self._context.Dialogs:Confirm({
				Title = settings.Title or string.format("%s %s?", if target then "Enable" else "Disable", self.Name),
				Description = settings.Description or settings.Text,
				ConfirmText = settings.ConfirmText or (if target then "Enable" else "Disable"),
				CancelText = settings.CancelText,
				Variant = settings.Variant,
			}, function(confirmed: boolean)
				if confirmed and not self._destroyed and not self.Disabled then
					self:SetValue(target)
				end
			end)
			return
		end
	end
	self:SetValue(target)
end

function Toggle._Render(self: any, animate: boolean)
	local t = self._scope:View()
	local on = self.Value == true
	local disabled = self.Disabled
	local hovered = self._hovered and not disabled
	local options = { Scope = self._scope }

	local function apply(instance: Instance, goals: { [string]: any })
		if animate then
			Animator.Play(instance, goals, options)
		else
			Animator.Set(instance, goals)
		end
	end

	if self._track then
		local track = if disabled then t.Disabled elseif on then t.ToggleOn else t.ToggleOff
		if hovered then
			track = if on then track:Lerp(Color3.new(1, 1, 1), 0.08) else track:Lerp(t.Text, 0.06)
		end
		local knob = if disabled then t.DisabledText elseif on then t.ToggleKnob else t.ToggleKnobOff
		apply(self._track, { BackgroundColor3 = track })
		apply(self._knob, {
			BackgroundColor3 = knob,
			Position = if on then UDim2.new(0, TRACK_WIDTH - KNOB_SIZE - 3, 0.5, 0) else UDim2.new(0, 3, 0.5, 0),
		})
	else
		local fill = if disabled then t.Disabled elseif on then t.ToggleOn else t.InputBackground
		local stroke = if disabled then t.Border elseif on then t.ToggleOn else t.Border
		if hovered and not on then
			stroke = stroke:Lerp(t.Text, 0.2)
		end
		apply(self._box, { BackgroundColor3 = fill })
		apply(self._boxStroke, { Color = stroke })
		local checkColor = if disabled then t.DisabledText else t.ToggleKnob
		self._check:SetColor(checkColor)
		for _, part in self._check.Parts do
			apply(part, { BackgroundTransparency = if on then 0 else 1 })
		end
	end
end

function Toggle._OnDisabledChanged(self: any, disabled: boolean)
	self.Instance.Interactable = not disabled
	self.Instance.Selectable = not disabled
end

-- Attaches a keybind to this row. In Toggle/Hold mode it drives the toggle.
function Toggle.AddKeybind(self: any, options: any): any
	return self:_AttachAddon("Keybind", options)
end

-- Attaches a colour picker swatch to this row.
function Toggle.AddColorPicker(self: any, options: any): any
	return self:_AttachAddon("ColorPicker", options)
end

return Toggle
end

-- Tooltips --------------------------------------------------------------------
definitions["Tooltips"] = function(...)
--[[
	Tooltips

	Hover hints for any GUI object. One tooltip frame per window is created on
	first use and reused. Showing is delayed slightly so moving the pointer
	across a list does not flash hints, and placement happens once per show:
	there is no per-frame follow loop. Tooltips are skipped for touch input.
]]

local Animator = import("Animator")
local Maid = import("Maid")
local Theme = import("Theme")
local Util = import("Util")
local Widgets = import("Widgets")

local Tooltips = {}
Tooltips.__index = Tooltips

local SHOW_DELAY = 0.45
local MAX_WIDTH = 240

function Tooltips.new(layer: GuiObject, scope: Theme.Scope, input: any, getScale: () -> number)
	return setmetatable({
		_layer = layer,
		_scope = scope,
		_input = input,
		_getScale = getScale,
		_frame = nil :: CanvasGroup?,
		_label = nil :: TextLabel?,
		_pending = nil :: thread?,
		_target = nil :: GuiObject?,
		_maid = Maid.new(),
	}, Tooltips)
end

function Tooltips._Build(self: any)
	if self._frame then
		return
	end
	local scope = self._scope
	local frame = Util.Create("CanvasGroup", {
		Name = "Tooltip",
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.new(),
		GroupTransparency = 1,
		Visible = false,
		ZIndex = 60,
	})
	scope:Bind(frame, "BackgroundColor3", "TooltipBackground")
	Widgets.Corner(scope, frame)
	Util.Padding(frame, 6, 9, 6, 9)
	local label = Widgets.Label(scope, {
		Style = "Small",
		Wrapped = true,
		Color = "TooltipText",
		Properties = {
			Name = "Text",
			AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.new(),
			ZIndex = 60,
			Parent = frame,
		},
	})
	Util.Create("UISizeConstraint", { MaxSize = Vector2.new(MAX_WIDTH, math.huge), Parent = label })
	frame.Parent = self._layer
	self._maid:Add(frame)
	self._frame = frame
	self._label = label
end

function Tooltips._Cancel(self: any)
	if self._pending then
		pcall(task.cancel, self._pending)
		self._pending = nil
	end
end

function Tooltips._Show(self: any, target: GuiObject, text: string)
	self:_Build()
	local frame = self._frame :: CanvasGroup
	local label = self._label :: TextLabel
	label.Text = text
	self._target = target

	local scale = math.max(self._getScale(), 0.01)
	local layerPosition = self._layer.AbsolutePosition
	local position = (target.AbsolutePosition - layerPosition) / scale
	local size = target.AbsoluteSize / scale
	local x = position.X
	local y = position.Y + size.Y + 6
	local screen = self._layer:FindFirstAncestorWhichIsA("LayerCollector")
	if screen and screen:IsA("GuiBase2d") then
		local estimatedHeight = frame.AbsoluteSize.Y / scale
		if layerPosition.Y + (y + estimatedHeight) * scale > screen.AbsoluteSize.Y - 8 then
			y = position.Y - estimatedHeight - 6
		end
	end
	frame.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
	frame.Visible = true
	Animator.Play(frame, { GroupTransparency = 0 }, { Scope = self._scope, DurationScale = 0.8 })
end

function Tooltips.Hide(self: any)
	self:_Cancel()
	self._target = nil
	local frame = self._frame
	if frame and frame.Visible then
		Animator.Play(frame, { GroupTransparency = 1 }, {
			Scope = self._scope,
			DurationScale = 0.5,
			OnComplete = function()
				if self._target == nil then
					frame.Visible = false
				end
			end,
		})
	end
end

--[[
	Shows `getText()` while the pointer rests on `target`. Returns a function
	that detaches the tooltip.
]]
function Tooltips.Attach(self: any, target: GuiObject, getText: () -> string?): () -> ()
	local maid = Maid.new()
	maid:Add(target.MouseEnter:Connect(function()
		if self._input:GetInputMode() == "Touch" then
			return
		end
		local text = getText()
		if text == nil or text == "" then
			return
		end
		self:_Cancel()
		self._pending = task.delay(SHOW_DELAY, function()
			self._pending = nil
			if target.Parent ~= nil then
				self:_Show(target, text)
			end
		end)
	end))
	maid:Add(target.MouseLeave:Connect(function()
		if self._target == target or self._pending then
			self:Hide()
		end
	end))
	maid:Add(target.InputBegan:Connect(function(input: InputObject)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			self:Hide()
		end
	end))
	return function()
		if self._target == target then
			self:Hide()
		end
		maid:Destroy()
	end
end

function Tooltips.Destroy(self: any)
	self:_Cancel()
	self._maid:Destroy()
	self._frame = nil
	self._label = nil
end

return Tooltips
end

-- Util ------------------------------------------------------------------------
definitions["Util"] = function(...)
--[[
	Util

	Small, dependency-free helpers shared by every module: instance creation with
	sane GUI defaults, number rounding/snapping, colour parsing, key names and
	protected callback invocation.
]]

local Log = import("Log")

local Util = {}

-- Properties every instance of a class should start with. Roblox defaults
-- (borders, auto button colours, white label backgrounds) rarely match a
-- designed UI, so we normalise them once here.
local CLASS_DEFAULTS: { [string]: { [string]: any } } = {
	Frame = { BorderSizePixel = 0 },
	CanvasGroup = { BorderSizePixel = 0 },
	ScrollingFrame = {
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(),
		ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		Selectable = false,
	},
	TextLabel = {
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
	},
	TextButton = {
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
	},
	TextBox = {
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
	},
	ImageLabel = { BorderSizePixel = 0, BackgroundTransparency = 1 },
	ImageButton = { BorderSizePixel = 0, BackgroundTransparency = 1, AutoButtonColor = false },
}

--[[
	Creates an instance, applies class defaults and the given properties, then
	parents it last (parenting last avoids redundant replication/layout work).
]]
function Util.Create(className: string, properties: { [string]: any }?, children: { Instance }?): any
	local instance: any = Instance.new(className)
	local defaults = CLASS_DEFAULTS[className]
	if defaults then
		for key, value in defaults do
			instance[key] = value
		end
	end
	local parent = nil
	if properties then
		for key, value in properties do
			if key == "Parent" then
				parent = value
			else
				instance[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent ~= nil then
		instance.Parent = parent
	end
	return instance
end

function Util.Padding(parent: Instance, top: number, right: number?, bottom: number?, left: number?): UIPadding
	return Util.Create("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right or top),
		PaddingBottom = UDim.new(0, bottom or top),
		PaddingLeft = UDim.new(0, left or right or top),
		Parent = parent,
	})
end

function Util.List(parent: Instance, properties: { [string]: any }?): UIListLayout
	local props: { [string]: any } = {
		SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = Enum.FillDirection.Vertical,
		Parent = parent,
	}
	if properties then
		for key, value in properties do
			props[key] = value
		end
	end
	return Util.Create("UIListLayout", props)
end

-- Returns a UIFlexItem that makes `parent` fill the remaining space of its list.
function Util.Fill(parent: Instance): UIFlexItem
	return Util.Create("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill, Parent = parent })
end

--------------------------------------------------------------------------------
-- Tables
--------------------------------------------------------------------------------

function Util.Merge(base: { [any]: any }, overrides: { [any]: any }?): { [any]: any }
	local result = table.clone(base)
	if overrides then
		for key, value in overrides do
			result[key] = value
		end
	end
	return result
end

function Util.Keys(dictionary: { [any]: any }): { any }
	local keys = {}
	for key in dictionary do
		table.insert(keys, key)
	end
	return keys
end

function Util.ShallowEqual(a: any, b: any): boolean
	if a == b then
		return true
	end
	if type(a) ~= "table" or type(b) ~= "table" then
		return false
	end
	for key, value in a do
		if b[key] ~= value then
			return false
		end
	end
	for key in b do
		if a[key] == nil then
			return false
		end
	end
	return true
end

--------------------------------------------------------------------------------
-- Numbers
--------------------------------------------------------------------------------

function Util.Round(value: number, decimals: number): number
	local factor = 10 ^ decimals
	return math.floor(value * factor + 0.5) / factor
end

-- Snaps `value` to the nearest step measured from `origin`.
function Util.Snap(value: number, step: number, origin: number): number
	if step <= 0 then
		return value
	end
	return origin + math.floor((value - origin) / step + 0.5) * step
end

-- Number of decimal places needed to represent `value` (capped at 6).
function Util.DecimalsOf(value: number): number
	for decimals = 0, 6 do
		if math.abs(Util.Round(value, decimals) - value) < 1e-9 then
			return decimals
		end
	end
	return 6
end

function Util.FormatNumber(value: number, decimals: number): string
	local text = string.format("%." .. math.max(0, math.floor(decimals)) .. "f", value)
	if string.match(text, "^%-0%.?0*$") then
		text = string.sub(text, 2)
	end
	return text
end

--------------------------------------------------------------------------------
-- Colours
--------------------------------------------------------------------------------

-- Accepts a Color3, "#RRGGBB", "RRGGBB", "#RGB" or {R, G, B} (0-255).
function Util.ToColor3(value: any): Color3?
	local kind = typeof(value)
	if kind == "Color3" then
		return value
	elseif kind == "string" then
		local hex = string.gsub(value, "^#", "")
		if #hex == 3 then
			hex = string.gsub(hex, ".", "%0%0")
		end
		if #hex == 6 and string.match(hex, "^%x+$") then
			return Color3.fromRGB(
				tonumber(string.sub(hex, 1, 2), 16) :: number,
				tonumber(string.sub(hex, 3, 4), 16) :: number,
				tonumber(string.sub(hex, 5, 6), 16) :: number
			)
		end
	elseif kind == "table" then
		local r, g, b = value[1] or value.R, value[2] or value.G, value[3] or value.B
		if type(r) == "number" and type(g) == "number" and type(b) == "number" then
			return Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255))
		end
	end
	return nil
end

function Util.ToHex(color: Color3): string
	return string.format(
		"%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

function Util.Mix(a: Color3, b: Color3, alpha: number): Color3
	return a:Lerp(b, math.clamp(alpha, 0, 1))
end

-- Relative luminance (WCAG) in the range 0..1.
function Util.Luminance(color: Color3): number
	local function channel(c: number): number
		return if c <= 0.03928 then c / 12.92 else ((c + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

-- Picks white or near-black text, whichever reads better on `background`.
function Util.ContrastText(background: Color3): Color3
	if Util.Luminance(background) > 0.45 then
		return Color3.fromRGB(18, 19, 22)
	end
	return Color3.fromRGB(255, 255, 255)
end

function Util.IsDark(color: Color3): boolean
	return Util.Luminance(color) < 0.3
end

--------------------------------------------------------------------------------
-- Input names
--------------------------------------------------------------------------------

local KEY_ALIASES: { [string]: string } = {
	LeftShift = "LShift",
	RightShift = "RShift",
	LeftControl = "LCtrl",
	RightControl = "RCtrl",
	LeftAlt = "LAlt",
	RightAlt = "RAlt",
	LeftSuper = "LSuper",
	RightSuper = "RSuper",
	LeftMeta = "LMeta",
	RightMeta = "RMeta",
	MouseButton1 = "MB1",
	MouseButton2 = "MB2",
	MouseButton3 = "MB3",
	Return = "Enter",
	Backspace = "Bksp",
	Delete = "Del",
	Insert = "Ins",
	PageUp = "PgUp",
	PageDown = "PgDn",
	CapsLock = "Caps",
	Escape = "Esc",
	Space = "Space",
	Zero = "0",
	One = "1",
	Two = "2",
	Three = "3",
	Four = "4",
	Five = "5",
	Six = "6",
	Seven = "7",
	Eight = "8",
	Nine = "9",
	KeypadZero = "Num0",
	KeypadOne = "Num1",
	KeypadTwo = "Num2",
	KeypadThree = "Num3",
	KeypadFour = "Num4",
	KeypadFive = "Num5",
	KeypadSix = "Num6",
	KeypadSeven = "Num7",
	KeypadEight = "Num8",
	KeypadNine = "Num9",
	Backquote = "`",
	Minus = "-",
	Equals = "=",
	LeftBracket = "[",
	RightBracket = "]",
	BackSlash = "\\",
	Semicolon = ";",
	Quote = "'",
	Comma = ",",
	Period = ".",
	Slash = "/",
}

local REVERSE_ALIASES: { [string]: string } = {}
for name, alias in KEY_ALIASES do
	REVERSE_ALIASES[string.lower(alias)] = name
end

local MOUSE_BUTTONS = {
	MouseButton1 = Enum.UserInputType.MouseButton1,
	MouseButton2 = Enum.UserInputType.MouseButton2,
	MouseButton3 = Enum.UserInputType.MouseButton3,
}

-- Short display name for a key or mouse button ("RShift", "MB2", "None").
function Util.KeyName(key: EnumItem?): string
	if key == nil then
		return "None"
	end
	return KEY_ALIASES[key.Name] or key.Name
end

--[[
	Converts a key description into an EnumItem. Accepts Enum.KeyCode items,
	Enum.UserInputType mouse buttons, and strings such as "RightShift",
	"RShift", "MB2" or "MouseButton2". Returns nil when unrecognised.
]]
function Util.ParseKey(value: any): EnumItem?
	if typeof(value) == "EnumItem" then
		local item = value :: EnumItem
		if item.EnumType == Enum.KeyCode then
			-- Value 0 is the "no key" item (Unknown/None depending on engine version).
			return if item.Value == 0 then nil else item
		end
		if item.EnumType == Enum.UserInputType and MOUSE_BUTTONS[item.Name] then
			return item
		end
		return nil
	end
	if type(value) ~= "string" or value == "" then
		return nil
	end
	local name = REVERSE_ALIASES[string.lower(value)] or value
	if MOUSE_BUTTONS[name] then
		return MOUSE_BUTTONS[name]
	end
	local ok, item = pcall(function()
		return (Enum.KeyCode :: any)[name]
	end)
	if ok and typeof(item) == "EnumItem" and item.Value ~= 0 then
		return item
	end
	return nil
end

--------------------------------------------------------------------------------
-- Callbacks
--------------------------------------------------------------------------------

local function invoke(callback: (...any) -> ...any, source: string, ...: any)
	local ok, err = xpcall(callback, debug.traceback, ...)
	if not ok then
		Log.handlerError(err, source)
	end
end

--[[
	Runs a user callback on its own thread with error protection. The caller is
	never blocked by a yielding callback and never broken by an erroring one.
]]
function Util.SafeCall(callback: ((...any) -> ...any)?, source: string, ...: any)
	if callback == nil then
		return
	end
	task.spawn(invoke, callback, source, ...)
end

-- Readable description of a component for messages, e.g. 'Toggle "Enabled"'.
function Util.Describe(kind: string, name: string?): string
	if name and name ~= "" then
		return string.format('%s "%s"', kind, name)
	end
	return kind
end

-- Moves gamepad selection to `object`. Ignored where the engine refuses it
-- (for example UI in CoreGui, which uses a separate selection).
function Util.SelectObject(object: GuiObject?)
	pcall(function()
		game:GetService("GuiService").SelectedObject = object
	end)
end

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

local function noop() end

-- What a method of a destroyed object turns into.
local function retiredMember(key: any): "keep" | "noop" | "warn"
	if type(key) ~= "string" or string.sub(key, 1, 1) == "_" then
		-- Internal methods keep working for any late engine callbacks.
		return "keep"
	end
	if
		string.sub(key, 1, 3) == "Get"
		or string.sub(key, 1, 2) == "Is"
		or string.sub(key, 1, 3) == "Has"
		or key == "Serialize"
	then
		return "keep"
	end
	if string.sub(key, 1, 6) == "Create" or string.sub(key, 1, 3) == "Add" then
		return "warn"
	end
	return "noop"
end

local retiredClasses: { [any]: any } = setmetatable({}, { __mode = "k" }) :: any

--[[
	Called at the end of Destroy. Afterwards the object's getters (Get*, Is*,
	Has*) keep returning its last state, creation methods (Create*, Add*) warn
	and return nil, and every other method does nothing, so a stale reference
	can never touch destroyed UI or throw.
]]
function Util.Retire(object: any)
	local class = getmetatable(object)
	if type(class) ~= "table" then
		return
	end
	local retired = retiredClasses[class]
	if retired == nil then
		local original = rawget(class, "__index")
		local proxy: any = setmetatable({}, { __index = class })
		proxy.__index = function(target: any, key: any): any
			local member
			if type(original) == "function" then
				member = original(target, key)
			else
				member = class[key]
			end
			if type(member) ~= "function" then
				return member
			end
			local kind = retiredMember(key)
			if kind == "noop" then
				return noop
			elseif kind == "warn" then
				return function(self: any)
					local name = rawget(self, "Name") or rawget(self, "Title")
					local described = Util.Describe(tostring(rawget(self, "Type") or "Object"), name)
					Log.warn("%s was destroyed; %s() does nothing", described, tostring(key))
					return nil
				end
			end
			return member
		end
		retiredClasses[class] = proxy
		retired = proxy
	end
	setmetatable(object, retired)
end

return Util
end

-- Widgets ---------------------------------------------------------------------
definitions["Widgets"] = function(...)
--[[
	Widgets

	Themed building blocks shared by elements and components: labels bound to
	the typography tokens, rounded surfaces, layered drop shadows and an
	interactive button. Centralising them keeps every part of the library
	visually consistent and avoids duplicating hover/press logic.
]]

local Animator = import("Animator")
local InputManager = import("InputManager")
local Maid = import("Maid")
local Theme = import("Theme")
local Util = import("Util")

local Widgets = {}

type Scope = Theme.Scope
type View = Theme.View

type TextStyle = "Body" | "Small" | "Title"

local SIZE_TOKENS: { [string]: string } = {
	Body = "TextSize",
	Small = "SmallTextSize",
	Title = "TitleTextSize",
}

type LabelProps = {
	Text: string?,
	Style: TextStyle?,
	Weight: Enum.FontWeight?,
	-- Theme token for the text colour. Pass false to manage the colour yourself.
	Color: (string | boolean)?,
	Wrapped: boolean?,
	RichText: boolean?,
	Properties: { [string]: any }?,
}

--[[
	Creates a TextLabel whose font, size and (optionally) colour follow the theme.
	Extra instance properties go in `Properties`.
]]
function Widgets.Label(scope: Scope, props: LabelProps, className: string?): any
	local properties: { [string]: any } = {
		Text = props.Text or "",
		TextWrapped = props.Wrapped == true,
		RichText = props.RichText == true,
		TextTruncate = if props.Wrapped then Enum.TextTruncate.None else Enum.TextTruncate.AtEnd,
	}
	if props.Properties then
		for key, value in props.Properties do
			properties[key] = value
		end
	end
	local label = Util.Create(className or "TextLabel", properties)
	local weight = props.Weight or Enum.FontWeight.Regular
	local sizeToken = SIZE_TOKENS[props.Style or "Body"]
	scope:Bind(label, "FontFace", function(t: View)
		return Theme.Font(t.Font, weight)
	end)
	scope:Bind(label, "TextSize", sizeToken)
	if props.Color ~= false then
		scope:Bind(label, "TextColor3", if type(props.Color) == "string" then props.Color else "Text")
	end
	return label
end

type SurfaceProps = {
	Background: string?, -- colour token (default "Tertiary")
	Transparency: string?, -- transparency token (default "SurfaceTransparency")
	Radius: string?, -- radius token (default "CornerRadius")
	Stroke: (string | boolean)?, -- stroke colour token, or false for none (default "Border")
	Properties: { [string]: any }?,
}

-- Creates a rounded, stroked frame bound to theme tokens. Returns frame, corner, stroke.
function Widgets.Surface(scope: Scope, props: SurfaceProps, className: string?): (any, UICorner, UIStroke?)
	local frame = Util.Create(className or "Frame", props.Properties)
	scope:Bind(frame, "BackgroundColor3", props.Background or "Tertiary")
	scope:Bind(frame, "BackgroundTransparency", props.Transparency or "SurfaceTransparency")
	local radiusToken = props.Radius or "CornerRadius"
	local corner = Util.Create("UICorner", { Parent = frame })
	scope:Bind(corner, "CornerRadius", function(t: View)
		return UDim.new(0, t[radiusToken])
	end)
	local stroke: UIStroke? = nil
	if props.Stroke ~= false then
		local strokeInstance = Util.Create("UIStroke", {
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = frame,
		})
		scope:Bind(strokeInstance, "Color", if type(props.Stroke) == "string" then props.Stroke else "Border")
		scope:Bind(strokeInstance, "Thickness", "StrokeThickness")
		scope:Bind(strokeInstance, "Transparency", "BorderTransparency")
		stroke = strokeInstance
	end
	return frame, corner, stroke
end

-- Binds a UICorner to a radius token.
function Widgets.Corner(scope: Scope, parent: Instance, radiusToken: string?): UICorner
	local corner = Util.Create("UICorner", { Parent = parent })
	local token = radiusToken or "CornerRadius"
	scope:Bind(corner, "CornerRadius", function(t: View)
		return UDim.new(0, t[token])
	end)
	return corner
end

--[[
	Layered soft shadow. `parent` must be sized like the element casting the
	shadow (the layers extend beyond it). Rendered beneath siblings with a
	higher ZIndex. Returns the container and a function to set the overall
	opacity multiplier (0..1) for fades.
]]
local SHADOW_LAYERS = {
	{ Spread = 2, Offset = 1, Weight = 0.5 },
	{ Spread = 6, Offset = 3, Weight = 0.24 },
	{ Spread = 14, Offset = 6, Weight = 0.1 },
}

function Widgets.Shadow(
	scope: Scope,
	parent: Instance,
	radiusToken: string?,
	zIndex: number?
): (Frame, (number, boolean?) -> ())
	local container = Util.Create("Frame", {
		Name = "Shadow",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = zIndex or 0,
		Parent = parent,
	})
	local token = radiusToken or "CornerRadius"
	local layers: { Frame } = {}
	local bound: { Instance } = {}
	local opacity = 1
	for index, layer in SHADOW_LAYERS do
		local frame = Util.Create("Frame", {
			Name = "Layer" .. index,
			Size = UDim2.new(1, layer.Spread * 2, 1, layer.Spread * 2),
			Position = UDim2.fromOffset(-layer.Spread, -layer.Spread + layer.Offset),
			ZIndex = zIndex or 0,
			Parent = container,
		})
		local corner = Util.Create("UICorner", { Parent = frame })
		scope:Bind(corner, "CornerRadius", function(t: View)
			return UDim.new(0, t[token] + layer.Spread)
		end)
		scope:Bind(frame, "BackgroundColor3", "Shadow")
		table.insert(layers, frame)
		table.insert(bound, frame)
		table.insert(bound, corner)
	end
	local function transparencies(): { number }
		local strength = 1 - scope:Get("ShadowTransparency")
		local values = {}
		for index, layer in SHADOW_LAYERS do
			values[index] = 1 - strength * layer.Weight * opacity
		end
		return values
	end
	local function apply(animate: boolean?)
		local values = transparencies()
		for index, frame in layers do
			if animate then
				Animator.Play(frame, { BackgroundTransparency = values[index] }, { Scope = scope, DurationScale = 1.3 })
			else
				Animator.Set(frame, { BackgroundTransparency = values[index] })
			end
		end
	end
	local stopObserving = scope:Observe(function()
		apply(false)
	end)
	-- Unbind each instance explicitly: with deferred events this handler runs
	-- after destruction, when the hierarchy is no longer available.
	container.Destroying:Once(function()
		stopObserving()
		for _, instance in bound do
			scope:Unbind(instance)
		end
	end)
	return container,
		function(value: number, animate: boolean?)
			opacity = math.clamp(value, 0, 1)
			apply(animate)
		end
end

--------------------------------------------------------------------------------
-- Button
--------------------------------------------------------------------------------

type ButtonVariant = "Default" | "Primary" | "Danger" | "Ghost"

type ButtonProps = {
	Text: string?,
	Description: string?,
	Variant: ButtonVariant?,
	-- Size the width to the text instead of filling the parent.
	AutoWidth: boolean?,
	Parent: Instance?,
	LayoutOrder: number?,
	Name: string?,
	Fill: boolean?, -- add a UIFlexItem so the button shares a row equally
}

type ButtonWidget = {
	Instance: TextButton,
	Label: TextLabel,
	Activated: RBXScriptSignal,
	SetText: (self: ButtonWidget, text: string) -> (),
	SetDescription: (self: ButtonWidget, text: string?) -> (),
	SetVariant: (self: ButtonWidget, variant: ButtonVariant) -> (),
	SetDisabled: (self: ButtonWidget, disabled: boolean) -> (),
	SetHighlight: (self: ButtonWidget, color: Color3?) -> (),
	Destroy: (self: ButtonWidget) -> (),
}

local ButtonWidget = {}
ButtonWidget.__index = ButtonWidget

local function buttonColors(t: View, variant: string, state: Enum.GuiState, disabled: boolean, highlight: Color3?)
	if disabled then
		return t.Disabled, t.DisabledText, t.Border, if variant == "Ghost" then 1 else t.SurfaceTransparency
	end
	local hovered = state == Enum.GuiState.Hover
	local pressed = state == Enum.GuiState.Press
	if variant == "Primary" or variant == "Danger" then
		local base = if variant == "Danger" then t.Error else t.Accent
		local text = if variant == "Danger" then Util.ContrastText(base) else t.AccentText
		local background = base
		if pressed then
			background = base:Lerp(Color3.new(0, 0, 0), 0.14)
		elseif hovered then
			background = base:Lerp(Color3.new(1, 1, 1), 0.1)
		end
		return background, text, base, 0
	elseif variant == "Ghost" then
		local background = if pressed then t.Active else t.Hover
		local transparency = if hovered or pressed then 0 else 1
		return background, if hovered or pressed then t.Text else t.MutedText, t.Border, transparency
	end
	local background = if pressed then t.Active elseif hovered then t.Hover else t.Tertiary
	local stroke = if highlight then highlight elseif hovered or pressed then t.Border:Lerp(t.Text, 0.12) else t.Border
	return background, highlight or t.Text, stroke, t.SurfaceTransparency
end

function Widgets.Button(scope: Scope, props: ButtonProps): ButtonWidget
	local maid = Maid.new()
	local autoWidth = props.AutoWidth == true
	local button = Util.Create("TextButton", {
		Name = props.Name or "Button",
		Size = if autoWidth then UDim2.new(0, 0, 0, 0) else UDim2.new(1, 0, 0, 0),
		AutomaticSize = if autoWidth then Enum.AutomaticSize.XY else Enum.AutomaticSize.Y,
		LayoutOrder = props.LayoutOrder or 0,
		BackgroundTransparency = 0,
	})
	maid:Add(button)
	local corner = Util.Create("UICorner", { Parent = button })
	scope:Bind(corner, "CornerRadius", function(t: View)
		return UDim.new(0, t.CornerRadius)
	end)
	local stroke = Util.Create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = button,
	})
	scope:Bind(stroke, "Thickness", "StrokeThickness")
	local sizeConstraint = Util.Create("UISizeConstraint", { Parent = button })
	scope:Bind(sizeConstraint, "MinSize", function(t: View)
		return Vector2.new(if autoWidth then 64 else 0, t.ControlHeight)
	end)
	local padding = Util.Create("UIPadding", { Parent = button })
	scope:Bind(padding, "PaddingLeft", function(t: View)
		return UDim.new(0, t.Padding)
	end)
	scope:Bind(padding, "PaddingRight", function(t: View)
		return UDim.new(0, t.Padding)
	end)
	scope:Bind(padding, "PaddingTop", function(t: View)
		return UDim.new(0, math.floor(t.Spacing * 0.75))
	end)
	scope:Bind(padding, "PaddingBottom", function(t: View)
		return UDim.new(0, math.floor(t.Spacing * 0.75))
	end)
	Util.List(button, {
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 2),
	})
	if props.Fill then
		Util.Fill(button)
		button.Size = UDim2.new(0, 0, 0, 0)
	end

	local label = Widgets.Label(scope, {
		Text = props.Text or "Button",
		Weight = Enum.FontWeight.Medium,
		Color = false,
		Properties = {
			Name = "Label",
			Size = if autoWidth then UDim2.new() else UDim2.new(1, 0, 0, 0),
			AutomaticSize = if autoWidth then Enum.AutomaticSize.XY else Enum.AutomaticSize.Y,
			TextXAlignment = Enum.TextXAlignment.Center,
			LayoutOrder = 1,
			Parent = button,
		},
	})

	local self: any = setmetatable({
		Instance = button,
		Label = label,
		Activated = button.Activated,
		_scope = scope,
		_maid = maid,
		_stroke = stroke,
		_variant = props.Variant or "Default",
		_disabled = false,
		_state = Enum.GuiState.Idle,
		_highlight = nil,
		_description = nil,
	}, ButtonWidget)

	if props.Description then
		self:SetDescription(props.Description)
	end

	maid:Add(InputManager.TrackState(button, function(state)
		if state == self._state then
			return
		end
		self._state = state
		self:_Render(true)
	end))
	maid:Add(scope:Observe(function()
		self:_Render(false)
	end))

	button.Parent = props.Parent
	return self :: ButtonWidget
end

function ButtonWidget._Render(self: any, animate: boolean)
	local t = self._scope:View()
	local background, text, strokeColor, transparency =
		buttonColors(t, self._variant, self._state, self._disabled, self._highlight)
	local options = { Scope = self._scope, DurationScale = 0.7 }
	if animate then
		Animator.Play(self.Instance, { BackgroundColor3 = background, BackgroundTransparency = transparency }, options)
		Animator.Play(self.Label, { TextColor3 = text }, options)
		Animator.Play(self._stroke, { Color = strokeColor }, options)
	else
		Animator.Set(self.Instance, { BackgroundColor3 = background, BackgroundTransparency = transparency })
		Animator.Set(self.Label, { TextColor3 = text })
		Animator.Set(self._stroke, { Color = strokeColor })
	end
	self._stroke.Transparency = if self._variant == "Ghost" then 1 else t.BorderTransparency
	if self._description then
		self._description.TextColor3 = if self._disabled
			then t.DisabledText
			elseif self._variant == "Primary" or self._variant == "Danger" then text:Lerp(background, 0.25)
			else t.MutedText
	end
end

function ButtonWidget.SetText(self: any, text: string)
	self.Label.Text = text
end

function ButtonWidget.SetDescription(self: any, text: string?)
	if text == nil or text == "" then
		if self._description then
			self._scope:Unbind(self._description)
			self._description:Destroy()
			self._description = nil
		end
		return
	end
	if self._description == nil then
		self._description = Widgets.Label(self._scope, {
			Style = "Small",
			Wrapped = true,
			Color = false,
			Properties = {
				Name = "Description",
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				TextXAlignment = Enum.TextXAlignment.Center,
				LayoutOrder = 2,
				Parent = self.Instance,
			},
		})
	end
	self._description.Text = text
	self:_Render(false)
end

function ButtonWidget.SetVariant(self: any, variant: ButtonVariant)
	self._variant = variant
	self:_Render(true)
end

function ButtonWidget.SetDisabled(self: any, disabled: boolean)
	self._disabled = disabled
	self.Instance.Interactable = not disabled
	self.Instance.Selectable = not disabled
	self:_Render(true)
end

-- Temporarily tints text and stroke (used for inline confirmation states).
function ButtonWidget.SetHighlight(self: any, color: Color3?)
	self._highlight = color
	self:_Render(true)
end

function ButtonWidget.Destroy(self: any)
	self._scope:Unbind(self.Instance)
	self._maid:Destroy()
end

return Widgets
end

-- Window ----------------------------------------------------------------------
definitions["Window"] = function(...)
--[[
	Window

	The top-level container. Owns a ScreenGui, the sidebar of tabs, the content
	area, an overlay layer for popups/tooltips/dialogs, and all window-level
	behaviour: dragging, resizing, automatic scaling, responsive breakpoints,
	open/close animations, minimising, toggle key/button and background effects.

	Structure:
	  ScreenGui
	    Dim                      optional full-screen dimmer
	    Root                     position + size (+ UIScale for auto-scaling)
	      Canvas                 open/close pop (+ UIScale for the animation)
	        Shadow               layered soft shadow
	        Body (CanvasGroup)   fades as a unit; contains TopBar, Sidebar, Content
	        Border               stroke drawn above the body
	        Overlay              popups, tooltips and dialogs
	    ToggleButton             optional floating button (mobile)
]]

local Lighting = game:GetService("Lighting")

local Animator = import("Animator")
local Dialogs = import("Dialogs")
local Environment = import("Environment")
local Icons = import("Icons")
local InputManager = import("InputManager")
local Log = import("Log")
local Maid = import("Maid")
local Options = import("Options")
local Popups = import("Popups")
local Signal = import("Signal")
local State = import("State")
local Theme = import("Theme")
local Tooltips = import("Tooltips")
local Util = import("Util")
local Widgets = import("Widgets")

local Tab = import("Tab")

local Window = {}
Window.__index = Window

local TOP_BAR_HEIGHT = 46
local TAB_HEIGHT = 34
local TAB_GAP = 2
local COMPACT_SIDEBAR_WIDTH = 54
local COMPACT_BREAKPOINT = 560
local SCREEN_MARGIN = 12
local REFERENCE_HEIGHT = 1080

local SCHEMA: Options.Schema = {
	Title = { Type = "string", Default = "Lattice" },
	Subtitle = { Type = "string" },
	Icon = { Type = "string" },
	Size = { Type = "UDim2|Vector2", Default = Vector2.new(660, 480) },
	MinSize = { Type = "Vector2", Default = Vector2.new(420, 300) },
	MaxSize = { Type = "Vector2", Default = Vector2.new(1600, 1100) },
	Position = { Type = "UDim2" },
	AnchorPoint = { Type = "Vector2" },
	Draggable = { Type = "boolean", Default = true },
	Resizable = { Type = "boolean", Default = true },
	ToggleKey = { Type = "EnumItem|string|boolean", Default = Enum.KeyCode.RightShift },
	ToggleButton = { Type = "boolean|string|table", Default = "Auto" },
	Blur = { Type = "boolean|number", Default = false },
	Dim = { Type = "boolean|number", Default = false },
	AutoScale = { Type = "boolean", Default = true },
	Scale = { Type = "number", Default = 1, Validate = Options.Validators.Positive },
	SidebarWidth = { Type = "number", Default = 172, Validate = Options.Validators.Positive },
	TabHeader = { Type = "boolean", Default = true },
	Columns = { Type = "number|string", Default = "Auto" },
	TopBar = { Type = "table" },
	Theme = { Type = "table|string" },
	Parent = { Type = "Instance" },
	DisplayOrder = { Type = "number", Default = 50 },
	Visible = { Type = "boolean", Default = true },
	CloseBehavior = {
		Type = "string",
		Default = "Hide",
		Validate = function(value)
			return value == "Hide" or value == "Destroy", 'must be "Hide" or "Destroy"'
		end,
	},
	HideHint = { Type = "boolean", Default = true },
	FadeEffects = { Type = "boolean", Default = true },
	-- Handled by Lattice:CreateWindow (re-running a script replaces its old UI).
	ReplaceExisting = { Type = "boolean", Default = true },
}

local TOP_BAR_SCHEMA: Options.Schema = {
	Height = { Type = "number", Default = TOP_BAR_HEIGHT, Validate = Options.Validators.Positive },
	Minimize = { Type = "boolean", Default = true },
	Close = { Type = "boolean", Default = true },
	Visible = { Type = "boolean", Default = true },
}

local function toVector2(size: UDim2 | Vector2, viewport: Vector2): Vector2
	if typeof(size) == "Vector2" then
		return size
	end
	local udim = size :: UDim2
	return Vector2.new(udim.X.Scale * viewport.X + udim.X.Offset, udim.Y.Scale * viewport.Y + udim.Y.Offset)
end

--------------------------------------------------------------------------------
-- Construction
--------------------------------------------------------------------------------

function Window.new(library: any, rawOptions: any)
	local options = Options.Resolve("CreateWindow", rawOptions, SCHEMA)
	local topBarOptions = Options.Resolve("CreateWindow.TopBar", options.TopBar, TOP_BAR_SCHEMA)

	local parent = options.Parent or Environment.GuiParent()
	if parent == nil then
		Log.error("CreateWindow: there is no player to show UI to here. Pass Parent = <Instance>.")
	end

	local scope = library._theme:Extend()
	if type(options.Theme) == "string" then
		local preset = library:_GetPreset(options.Theme)
		if preset then
			scope:Set(preset, true)
		else
			Log.warn('CreateWindow: unknown theme preset "%s"', options.Theme)
		end
	elseif type(options.Theme) == "table" then
		scope:Set(options.Theme)
	end

	local self: any = setmetatable({
		Type = "Window",
		Title = options.Title,
		Subtitle = options.Subtitle,
		Tabs = {},
		Opened = Signal.new("Window.Opened"),
		Closed = Signal.new("Window.Closed"),
		TabChanged = Signal.new("Window.TabChanged"),
		Destroying = Signal.new("Window.Destroying"),
		_library = library,
		_input = library._input,
		_options = options,
		_topBar = topBarOptions,
		_scope = scope,
		_maid = Maid.new(),
		_open = State.new(false),
		_minimized = State.new(false),
		_selected = nil,
		_tabCounter = 0,
		_destroyed = false,
		_compact = false,
		_scale = 1,
		_userScale = options.Scale,
		_desiredSize = Vector2.new(660, 480),
		_size = Vector2.new(660, 480),
		_minSize = options.MinSize,
		_maxSize = options.MaxSize,
		_sidebarWidth = options.SidebarWidth,
		_toggleKey = nil :: EnumItem?,
		_customButtons = 0,
	}, Window)

	self:_Build(parent)
	self:SetToggleKey(options.ToggleKey)
	self:_SetupToggleButton()

	local viewport = self._gui.AbsoluteSize
	if viewport.X <= 0 then
		viewport = Vector2.new(1920, 1080)
	end
	self._desiredSize = toVector2(options.Size, viewport)
	self:_Layout()

	self._maid:Add(self._gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_Layout()
	end))

	if options.Visible then
		self:Open()
	end
	return self
end

function Window._Build(self: any, parent: Instance)
	local scope: Theme.Scope = self._scope
	local maid = self._maid
	local fade = self._options.FadeEffects

	local gui = Util.Create("ScreenGui", {
		Name = "Lattice",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = self._options.DisplayOrder,
	})
	maid:Add(gui)
	self._gui = gui

	-- Optional dimmer behind the window.
	if self._options.Dim ~= false then
		local dim = Util.Create("Frame", {
			Name = "Dim",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = 0,
			Parent = gui,
		})
		scope:Bind(dim, "BackgroundColor3", "Overlay")
		self._dim = dim
	end

	-- Optional world blur.
	if self._options.Blur ~= false then
		local blur = Util.Create("BlurEffect", { Name = "LatticeBlur", Size = 0, Enabled = false, Parent = Lighting })
		maid:Add(blur)
		self._blur = blur
	end

	local root = Util.Create("Frame", {
		Name = "Window",
		BackgroundTransparency = 1,
		AnchorPoint = self._options.AnchorPoint
			or (if self._options.Position then Vector2.zero else Vector2.new(0.5, 0.5)),
		Position = self._options.Position or UDim2.fromScale(0.5, 0.5),
		Visible = false,
		ZIndex = 1,
		Parent = gui,
	})
	self._root = root
	self._uiScale = Util.Create("UIScale", { Parent = root })

	local canvas = Util.Create("Frame", {
		Name = "Canvas",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		Parent = root,
	})
	self._canvas = canvas
	self._animScale = Util.Create("UIScale", { Scale = 0.96, Parent = canvas })

	local _, setShadow = Widgets.Shadow(scope, canvas, "WindowCornerRadius", 1)
	self._setShadow = setShadow
	setShadow(0)

	local body = Util.Create(if fade then "CanvasGroup" else "Frame", {
		Name = "Body",
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = canvas,
	})
	if fade then
		body.GroupTransparency = 1
	end
	scope:Bind(body, "BackgroundColor3", "Background")
	scope:Bind(body, "BackgroundTransparency", "BackgroundTransparency")
	Widgets.Corner(scope, body, "WindowCornerRadius")
	self._body = body

	local border = Util.Create("Frame", {
		Name = "Border",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = canvas,
	})
	Widgets.Corner(scope, border, "WindowCornerRadius")
	self._borderStroke = Util.Create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Transparency = 1,
		Parent = border,
	})
	scope:Bind(self._borderStroke, "Color", "Border")
	scope:Bind(self._borderStroke, "Thickness", "StrokeThickness")

	local overlay = Util.Create("Frame", {
		Name = "Overlay",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 10,
		Parent = canvas,
	})
	self._overlay = overlay

	local function getScale(): number
		return self._uiScale.Scale * self._animScale.Scale
	end
	self._popups = Popups.new(overlay, self._input, getScale)
	self._tooltips = Tooltips.new(overlay, scope, self._input, getScale)
	self._dialogs = Dialogs.new(overlay, scope, self._input)

	self:_BuildTopBar(body)
	self:_BuildMain(body)
	self:_BuildResizeGrip(body)

	gui.Parent = parent
end

function Window._BuildTopBar(self: any, body: GuiObject)
