			Name = "Subtitle",
			Size = UDim2.new(0, 0, 0, 16),
			LayoutOrder = 2,
			Visible = self.Subtitle ~= nil and self.Subtitle ~= "",
			ZIndex = 4,
			Parent = titleBlock,
		},
	})
	Util.Fill(self._subtitleLabel)

	local controls = Util.Create("Frame", {
		Name = "Controls",
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 0, 28),
		LayoutOrder = 3,
		ZIndex = 4,
		Parent = bar,
	})
	Util.List(controls, {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 2),
	})
	self._controls = controls

	if self._topBar.Minimize then
		self._minimizeButton = self:_CreateControlButton("Minus", function()
			return if self._minimized:Get() then "Restore" else "Minimize"
		end, function()
			self:SetMinimized(not self._minimized:Get())
		end, 1000)
	end
	if self._topBar.Close then
		self:_CreateControlButton("Close", function()
			return if self._options.CloseBehavior == "Destroy" then "Close" else "Hide"
		end, function()
			if self._options.CloseBehavior == "Destroy" then
				self:Destroy()
			else
				self:Close()
				self:_ShowHideHint()
			end
		end, 1001)
	end

	-- Dragging by the title bar.
	self._maid:Add(bar.InputBegan:Connect(function(input: InputObject)
		if not self._options.Draggable then
