function Dropdown._HasSearch(self: any): boolean
	if self._searchSetting ~= nil then
		return self._searchSetting
	end
	return #self._choices > AUTO_SEARCH_THRESHOLD
end

function Dropdown._BuildPopup(self: any)
	if self._popup then
		return
	end
	local scope: Theme.Scope = self._scope
	local maid = Maid.new()
	self._maid:Add(maid)
	self._popupMaid = maid

	local holder = Util.Create("Frame", {
		Name = "DropdownPopup",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(200, 100),
		Visible = false,
		ZIndex = 20,
	})
	maid:Add(holder)
	maid:Add(function()
		scope:Unbind(holder)
	end)
	local _, setShadow = Widgets.Shadow(scope, holder, "CornerRadius", 20)
	self._setPopupShadow = setShadow

	local panel = Util.Create("CanvasGroup", {
		Name = "Panel",
		Size = UDim2.fromScale(1, 1),
		GroupTransparency = 1,
		ZIndex = 21,
		Parent = holder,
	})
	scope:Bind(panel, "BackgroundColor3", "DropdownBackground")
	Widgets.Corner(scope, panel)
	Util.Padding(panel, PANEL_PADDING)
	Util.List(panel, { Padding = UDim.new(0, PANEL_PADDING) })

	local border = Util.Create("Frame", {
		Name = "Border",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 22,
		Parent = holder,
	})
	Widgets.Corner(scope, border)
	local borderStroke = Util.Create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Transparency = 1,
		Parent = border,
	})
	scope:Bind(borderStroke, "Color", "Border")
	scope:Bind(borderStroke, "Thickness", "StrokeThickness")
	self._popupBorder = borderStroke

	-- Search field
	local search = Util.Create("Frame", {
		Name = "Search",
		Size = UDim2.new(1, 0, 0, SEARCH_HEIGHT),
		LayoutOrder = 1,
		ZIndex = 21,
		Parent = panel,
	})
	scope:Bind(search, "BackgroundColor3", "InputBackground")
	Widgets.Corner(scope, search)
	Util.Padding(search, 0, 8, 0, 8)
	Util.List(search, {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
	})
	local searchIcon = Icons.Create("Search", { Size = 14, LayoutOrder = 1, ZIndex = 21, Parent = search })
	maid:Add(scope:Observe(function(t)
		searchIcon:SetColor(t.MutedText)
	end))
	local searchBox = Widgets.Label(scope, {
		Style = "Small",
		Properties = {
			Name = "Query",
			Size = UDim2.new(0, 0, 1, 0),
			PlaceholderText = "Search...",
			LayoutOrder = 2,
			ZIndex = 21,
			Parent = search,
		},
	}, "TextBox")
	scope:Bind(searchBox, "PlaceholderColor3", "PlaceholderText")
	Util.Fill(searchBox)
	maid:Add(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		self._query = string.lower(searchBox.Text)
		self:_ApplyFilter()
	end))
	self._search = search
	self._searchBox = searchBox

	local list = Util.Create("ScrollingFrame", {
		Name = "List",
		Size = UDim2.new(1, 0, 0, ITEM_HEIGHT),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		LayoutOrder = 2,
		ZIndex = 21,
		Parent = panel,
	})
	scope:Bind(list, "ScrollBarImageColor3", "ScrollBar")
	Util.List(list, { Padding = UDim.new(0, ITEM_GAP) })
	self._list = list

	self._empty = Widgets.Label(scope, {
		Text = "No results",
		Style = "Small",
		Color = "MutedText",
		Properties = {
			Name = "Empty",
			Size = UDim2.new(1, 0, 0, ITEM_HEIGHT),
			TextXAlignment = Enum.TextXAlignment.Center,
			Visible = false,
			LayoutOrder = 3,
			ZIndex = 21,
			Parent = panel,
		},
	})

	self._popup = holder
	self._panel = panel
	self:_RebuildItems()
end

function Dropdown._CreateItem(self: any, option: Option, index: number): any
	local scope: Theme.Scope = self._scope
	local maid = Maid.new()
	local button = Util.Create("TextButton", {
		Name = "Option",
		Size = UDim2.new(1, 0, 0, ITEM_HEIGHT),
		BackgroundTransparency = 1,
		LayoutOrder = index,
		ZIndex = 21,
	})
	maid:Add(button)
	maid:Add(function()
		scope:Unbind(button)
	end)
	Widgets.Corner(scope, button)
	Util.Padding(button, 0, 8, 0, 8)
	Util.List(button, {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
	})
	local label = Widgets.Label(scope, {
		Text = option.Label,
		Color = false,
		Properties = {
			Name = "Label",
			Size = UDim2.new(0, 0, 0, 18),
			LayoutOrder = 1,
			ZIndex = 21,
			Parent = button,
		},
	})
	Util.Fill(label)
	local check = Icons.Create("Check", { Size = 14, LayoutOrder = 2, ZIndex = 21, Parent = button })

	local item = {
		Option = option,
		Button = button,
		Label = label,
		Check = check,
		Maid = maid,
		Hovered = false,
	}
	maid:Add(InputManager.TrackState(button, function(state)
		local hovered = state == Enum.GuiState.Hover or state == Enum.GuiState.Press
		if hovered ~= item.Hovered then
			item.Hovered = hovered
			self:_RenderItem(item, true)
		end
	end))
	maid:Add(button.Activated:Connect(function()
		self:_Choose(item.Option)
	end))
	button.Parent = self._list
	return item
end

-- Synchronises item rows with the option list, reusing rows where possible.
function Dropdown._RebuildItems(self: any)
	if self._list == nil then
		return
	end
	local existing = self._items
	local nextItems = {}
	for index, option in self._choices do
		local item = existing[option.Value]
		if item then
			existing[option.Value] = nil
			item.Option = option
			item.Label.Text = option.Label
			item.Button.LayoutOrder = index
		else
			item = self:_CreateItem(option, index)
		end
		nextItems[option.Value] = item
	end
	for _, item in existing do
		item.Maid:Destroy()
	end
	self._items = nextItems
	self:_ApplyFilter()
end

function Dropdown._RenderItem(self: any, item: any, animate: boolean)
	local t = self._scope:View()
	local option: Option = item.Option
	local selected = self:IsSelected(option.Value)
	local textColor = if option.Disabled then t.DisabledText elseif selected then t.DropdownSelectedText else t.Text
	local background = t.DropdownItemHover
	local transparency = if item.Hovered and not option.Disabled then 0 else 1
	if animate then
		Animator.Play(item.Button, { BackgroundColor3 = background, BackgroundTransparency = transparency }, {
			Scope = self._scope,
			DurationScale = 0.6,
		})
	else
		Animator.Set(item.Button, { BackgroundColor3 = background, BackgroundTransparency = transparency })
	end
	item.Label.TextColor3 = textColor
	item.Label.FontFace = Theme.Font(t.Font, if selected then Enum.FontWeight.Medium else Enum.FontWeight.Regular)
	item.Check:SetColor(t.DropdownSelectedText)
	item.Check.Frame.Visible = selected
	-- A closing list fades out but no longer reacts to input.
	local usable = self._open and not option.Disabled
	item.Button.Interactable = usable
	item.Button.Selectable = usable
end

function Dropdown._RenderItems(self: any)
	for _, item in self._items do
		self:_RenderItem(item, false)
	end
end

function Dropdown._ApplyFilter(self: any)
	if self._list == nil then
		return
	end
	local query = self._query
	local visible = 0
	for _, item in self._items do
		local show = query == "" or string.find(string.lower(item.Option.Label), query, 1, true) ~= nil
		item.Button.Visible = show
		if show then
			visible += 1
		end
	end
	local hasSearch = self:_HasSearch()
	self._search.Visible = hasSearch
	self._empty.Visible = visible == 0
	self._empty.Text = if #self._choices == 0 then "No options" else "No results"
	local rows = math.clamp(visible, 0, self._maxVisible)
	local listHeight = if rows > 0 then rows * ITEM_HEIGHT + (rows - 1) * ITEM_GAP else 0
	self._list.Size = UDim2.new(1, 0, 0, listHeight)
	self._list.Visible = rows > 0
	local height = PANEL_PADDING * 2
	local sections = 0
	if hasSearch then
		height += SEARCH_HEIGHT
		sections += 1
	end
	if rows > 0 then
		height += listHeight
		sections += 1
	else
		height += ITEM_HEIGHT
		sections += 1
	end
	height += math.max(0, sections - 1) * PANEL_PADDING
	self._popupHeight = height
	if self._popup then
		self._popup.Size = UDim2.new(0, self._popup.Size.X.Offset, 0, height)
		if self._open then
			self._context.Popups:Reposition(self)
		end
	end
	self:_RenderItems()
end

function Dropdown._Choose(self: any, option: Option)
	if option.Disabled or self.Disabled or not self._open then
		return
	end
	if self.Multi then
		local values = table.clone(self.Value)
		local index = table.find(values, option.Value)
		if index then
			table.remove(values, index)
		else
			table.insert(values, option.Value)
		end
		self:SetValue(values)
	else
		if self.Value == option.Value then
			if self.AllowNone then
				self:SetValue(nil)
			end
		else
			self:SetValue(option.Value)
		end
	end
	if self._closeOnSelect then
		self:Close()
	end
end

function Dropdown.Open(self: any)
	if self._open or self.Disabled or self._destroyed then
		return
	end
	self:_BuildPopup()
	self._open = true
	self._query = ""
	self._searchBox.Text = ""
	self._searchBox.Interactable = true
	self:_ApplyFilter()

	local holder: Frame = self._popup
	local panel: CanvasGroup = self._panel
	self._context.Popups:Open({
		Frame = holder,
		Anchor = self._box,
		MatchWidth = true,
		Height = self._popupHeight,
		Owner = self,
		OnClose = function()
			self:_OnPopupClosed()
		end,
	})
	panel.Position = UDim2.fromOffset(0, -4)
	Animator.Play(panel, { GroupTransparency = 0, Position = UDim2.new() }, { Scope = self._scope })
	Animator.Play(self._popupBorder, { Transparency = self._scope:Get("BorderTransparency") }, { Scope = self._scope })
	self._setPopupShadow(1, true)
	self:_RenderBox(true)

	if self._context.Input:GetInputMode() == "Gamepad" then
		for _, option in self._choices do
			local item = self._items[option.Value]
			if item and item.Button.Visible and not option.Disabled then
				Util.SelectObject(item.Button)
				break
			end
		end
	end
end

function Dropdown._OnPopupClosed(self: any)
	self._open = false
	local holder: Frame = self._popup
	if self._searchBox then
		if self._searchBox:IsFocused() then
			self._searchBox:ReleaseFocus()
		end
		self._searchBox.Interactable = false
	end
	if not self._destroyed then
		self:_RenderItems()
	end
	Animator.Play(self._popupBorder, { Transparency = 1 }, { Scope = self._scope, DurationScale = 0.7 })
	self._setPopupShadow(0, true)
	Animator.Play(self._panel, { GroupTransparency = 1 }, {
		Scope = self._scope,
		DurationScale = 0.7,
		OnComplete = function()
			if not self._open then
				holder.Visible = false
			end
		end,
	})
	if not self._destroyed then
		self:_RenderBox(true)
		if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(holder) then
			Util.SelectObject(self._box)
		end
	end
end

function Dropdown.Close(self: any)
	if self._open then
		self._context.Popups:Close(self)
	end
end

function Dropdown.IsOpen(self: any): boolean
	return self._open
end

function Dropdown.SetPlaceholder(self: any, text: string)
	self.Placeholder = text
	self:_RenderBox(false)
end

return Dropdown
end

-- Environment -----------------------------------------------------------------
definitions["Environment"] = function(...)
--# selene: allow(undefined_variable, global_usage)
--[[
	Environment

	Where Lattice is running. In an executor it uses the executor's functions
	(gethui, getgenv, identifyexecutor, writefile/readfile/listfiles...). In
	an ordinary LocalScript it falls back to the standard Roblox equivalents.
	Executor globals are read only when needed, and missing ones are simply
	nil, so nothing here errors in either environment.
]]

local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")

local Environment = {}

type FileSystem = {
	write: (path: string, contents: string) -> (),
	read: (path: string) -> string,
	isfile: (path: string) -> boolean,
	listfiles: (path: string) -> { string },
	isfolder: ((path: string) -> boolean)?,
	makefolder: ((path: string) -> ())?,
	delfile: ((path: string) -> ())?,
}

-- The executor's hidden UI container, if it has one.
function Environment.GetHui(): Instance?
	if type(gethui) == "function" then
		local ok, container = pcall(gethui)
		if ok and typeof(container) == "Instance" then
			return container
		end
	end
	return nil
end

-- Table shared by every script run in this session (getgenv, or _G).
function Environment.Shared(): { [any]: any }
	if type(getgenv) == "function" then
		local ok, env = pcall(getgenv)
		if ok and type(env) == "table" then
			return env
		end
	end
	return _G
end

-- The executor's name, or nil outside an executor.
function Environment.ExecutorName(): string?
	if type(identifyexecutor) == "function" then
		local ok, name = pcall(identifyexecutor)
		if ok and type(name) == "string" then
			return name
		end
	end
	return nil
end

-- True when running in an executor.
function Environment.IsExecutor(): boolean
	return type(getgenv) == "function" or type(identifyexecutor) == "function" or type(gethui) == "function"
end

-- The executor's file functions, or nil when files aren't available.
function Environment.FileSystem(): FileSystem?
	if
		type(writefile) == "function"
		and type(readfile) == "function"
		and type(isfile) == "function"
		and type(listfiles) == "function"
	then
		return {
			write = writefile,
			read = readfile,
			isfile = isfile,
			listfiles = listfiles,
			isfolder = if type(isfolder) == "function" then isfolder else nil,
			makefolder = if type(makefolder) == "function" then makefolder else nil,
			delfile = if type(delfile) == "function" then delfile else nil,
		}
	end
	return nil
end

-- Whether this script may put instances in CoreGui (executors usually can).
function Environment.CanUseCoreGui(): boolean
	return (
		pcall(function()
			local probe = Instance.new("Folder")
			probe.Name = "LatticeProbe"
			probe.Parent = CoreGui
			probe:Destroy()
		end)
	)
end

--[[
	Where library ScreenGuis go: the executor's hidden UI container, then
	CoreGui, then the local player's PlayerGui. Returns nil when there is no
	player to show UI to (for example on the server).
]]
function Environment.GuiParent(): Instance?
	local hidden = Environment.GetHui()
	if hidden then
		return hidden
	end
	if Environment.CanUseCoreGui() then
		return CoreGui
	end
	local player = Players.LocalPlayer
	if player == nil then
		return nil
	end
	return player:WaitForChild("PlayerGui")
end

return Environment
end

