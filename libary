definitions["Divider"] = function(...)
--[[
	Divider

	    Section:AddDivider()                       -- a plain line
	    Section:AddDivider({ Text = "Advanced" })  -- a line with a centred label

	A divider's value is its label text ("" for a plain line).
]]

local Log = import("Log")
local Util = import("Util")
local Widgets = import("Widgets")

local Base = import("Base")

local Divider = Base.extend("Divider", {})
Divider.DefaultName = ""

function Divider.new(context: any, options: any)
	local self: any = setmetatable({}, Divider)
	self:_Init(context, options)
	local scope = self._scope
	local root = self:_CreateRoot(nil, { Size = UDim2.new(1, 0, 0, 14), AutomaticSize = Enum.AutomaticSize.None })
	Util.List(root, {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 8),
	})
	local function line(order: number): Frame
		local frame = Util.Create("Frame", {
			Name = "Line",
			Size = UDim2.new(0, 0, 0, 1),
			LayoutOrder = order,
			ZIndex = 2,
			Parent = root,
		})
		Util.Fill(frame)
		scope:Bind(frame, "BackgroundColor3", "Divider")
		scope:Bind(frame, "BackgroundTransparency", "BorderTransparency")
		return frame
	end
	self._left = line(1)
	self._label = Widgets.Label(scope, {
		Text = self.Name,
		Style = "Small",
		Weight = Enum.FontWeight.Medium,
		Color = "MutedText",
		Properties = {
			Name = "Label",
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = 2,
			ZIndex = 2,
			Parent = root,
		},
	})
	self._right = line(3)
	self:_UpdateLabel()
	self:_Mount()
	return self
end

function Divider._UpdateLabel(self: any)
	local hasText = self.Name ~= ""
	self._label.Text = self.Name
	self._label.Visible = hasText
	self._right.Visible = hasText
end

function Divider._OnNameChanged(self: any)
	self:_UpdateLabel()
end

function Divider.GetValue(self: any): string
	return self.Name
end

function Divider.SetValue(self: any, text: any): boolean
	if text == nil then
		text = ""
	end
	if type(text) ~= "string" then
		Log.warn("%s:SetValue expects a string", self:_Describe())
		return false
	end
	self:SetName(text)
	return true
end

function Divider.SetText(self: any, text: string?): boolean
	return self:SetValue(text)
end

return Divider
end

-- Dropdown --------------------------------------------------------------------
definitions["Dropdown"] = function(...)
--[[
	Dropdown

	    local Dropdown = Section:AddDropdown({
	        Name = "Mode",
	        Values = { "Normal", "Fast", { Name = "Extreme", Disabled = true } },
	        Default = "Normal",
	        Callback = function(value) print(value) end,
	    })

	    local Targets = Section:AddDropdown({
	        Name = "Targets",
	        Values = { "Head", "Torso", "Legs" },
	        Multi = true,                 -- value is an array in option order
	        Default = { "Head" },
	        Search = true,                -- filter box (automatic for long lists)
	    })

	    Dropdown:SetValues({ "A", "B" })    -- dynamic options (selection is pruned)
	    Dropdown:SetOptionDisabled("B", true)
	    Targets:IsSelected("Head")

	Options may be strings, numbers or tables { Name, Value?, Disabled? }; the
	selected value is the option's Value (or its Name). Source = "Players" keeps
	the options in sync with the players in the server.
]]

local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")

local Animator = import("Animator")
local Icons = import("Icons")
local InputManager = import("InputManager")
local Log = import("Log")
local Maid = import("Maid")
local Theme = import("Theme")
local Util = import("Util")
local Widgets = import("Widgets")

local Base = import("Base")

local Dropdown = Base.extend("Dropdown", {
	Values = { Type = "table", Default = {} },
	Default = { Type = "string|number|table" },
	Multi = { Type = "boolean", Default = false },
	AllowNone = { Type = "boolean", Default = false },
	Search = { Type = "boolean" },
	Placeholder = { Type = "string" },
	MaxVisible = {
		Type = "number",
		Default = 6,
		Validate = function(value)
			return value >= 1, "must be at least 1"
		end,
	},
	CloseOnSelect = { Type = "boolean" },
	Source = {
		Type = "string",
		Validate = function(value)
			return value == "Players", 'must be "Players"'
		end,
	},
	ExcludeLocalPlayer = { Type = "boolean", Default = false },
}, { Options = "Values", Items = "Values", Value = "Default", Searchable = "Search", MultiSelect = "Multi" })
Dropdown.DefaultName = "Dropdown"
Dropdown.Serializable = true

local ITEM_HEIGHT = 28
local ITEM_GAP = 1
local PANEL_PADDING = 4
local SEARCH_HEIGHT = 28
local AUTO_SEARCH_THRESHOLD = 8

type Option = { Value: any, Label: string, Disabled: boolean }

local function arrayEquals(a: any, b: any): boolean
	if a == b then
		return true
	end
	if type(a) ~= "table" or type(b) ~= "table" or #a ~= #b then
		return false
	end
	for index = 1, #a do
		if a[index] ~= b[index] then
			return false
		end
	end
	return true
end

local function parseOption(raw: any): Option?
	local kind = type(raw)
	if kind == "string" or kind == "number" then
		return { Value = raw, Label = tostring(raw), Disabled = false }
	elseif kind == "table" then
		local name = raw.Name or raw.Text or raw.Label
		local value = if raw.Value ~= nil then raw.Value else name
		if value == nil or (type(value) ~= "string" and type(value) ~= "number") then
			return nil
		end
		return {
			Value = value,
			Label = if name ~= nil then tostring(name) else tostring(value),
			Disabled = raw.Disabled == true,
		}
	end
	return nil
end

function Dropdown.new(context: any, options: any)
	local self: any = setmetatable({}, Dropdown)
	local resolved = self:_Init(context, options)
	self.Multi = resolved.Multi
	self.AllowNone = resolved.AllowNone or resolved.Multi
	self.Placeholder = resolved.Placeholder or (if resolved.Multi then "None" else "Select...")
	self._maxVisible = math.floor(resolved.MaxVisible)
	self._searchSetting = resolved.Search
	self._closeOnSelect = if resolved.CloseOnSelect ~= nil then resolved.CloseOnSelect else not resolved.Multi
	self._choices = {} :: { Option }
	self._items = {} :: { [any]: any }
	self._query = ""
	self._open = false
	self._hovered = false

	self:_ParseValues(resolved.Values)
	if resolved.Source == "Players" then
		self._excludeLocal = resolved.ExcludeLocalPlayer
		self._choices = {}
		self:_ParseValues(self:_PlayerNames())
	end

	local initial: any
	if self.Multi then
		initial = {}
	end
	if resolved.Default ~= nil then
		local ok, normalized = self:_Normalize(resolved.Default)
		if ok then
			initial = normalized
		else
			Log.warn("%s: Default %s", self:_Describe(), tostring(normalized))
		end
	end
	-- Without a Default, a single-select dropdown starts empty (showing the
	-- placeholder) until the user picks; it cannot be cleared afterwards
	-- unless AllowNone is set.
	self:_InitValue(initial, if self.Multi then arrayEquals else nil)

	self:_Build()
	if resolved.Source == "Players" then
		self:_BindPlayers()
	end
	self:_Mount()
	return self
end

--------------------------------------------------------------------------------
-- Options
--------------------------------------------------------------------------------

function Dropdown._ParseValues(self: any, list: any)
	local options: { Option } = {}
	local seen: { [any]: boolean } = {}
	if type(list) ~= "table" then
		Log.warn("%s: Values must be an array", self:_Describe())
		list = {}
	end
	for index, raw in list do
		local option = parseOption(raw)
		if option == nil then
			Log.warn("%s: ignoring invalid option at index %s", self:_Describe(), tostring(index))
		elseif seen[option.Value] then
			Log.warn('%s: duplicate option "%s" ignored', self:_Describe(), option.Label)
		else
			seen[option.Value] = true
			table.insert(options, option)
		end
	end
	self._choices = options
end

function Dropdown._FindOption(self: any, value: any): (Option?, number?)
	for index, option in self._choices do
		if option.Value == value then
			return option, index
		end
	end
	-- Accept "2" for 2 and vice versa.
	local text = tostring(value)
	for index, option in self._choices do
		if tostring(option.Value) == text then
			return option, index
		end
	end
	return nil, nil
end

function Dropdown._PlayerNames(self: any): { string }
	local names = {}
	for _, player in Players:GetPlayers() do
		if not (self._excludeLocal and player == Players.LocalPlayer) then
			table.insert(names, player.Name)
		end
	end
	table.sort(names, function(a, b)
		return string.lower(a) < string.lower(b)
	end)
	return names
end

function Dropdown._BindPlayers(self: any)
	local function refresh()
		if not self._destroyed then
			self:SetValues(self:_PlayerNames())
		end
	end
	self._maid:Add(Players.PlayerAdded:Connect(refresh))
	self._maid:Add(Players.PlayerRemoving:Connect(function()
		task.defer(refresh)
	end))
end

--[[
	Replaces the option list. Selected values that no longer exist are removed
	(firing the callback if the selection changed).
]]
function Dropdown.SetValues(self: any, list: { any })
	self:_ParseValues(list)
	self:_RebuildItems()
	local current = self.Value
	if self.Multi then
		local kept = {}
		for _, value in current do
			local option = self:_FindOption(value)
			if option then
				table.insert(kept, option.Value)
			end
		end
		local _, normalized = self:_Normalize(kept)
		if not self:_Commit(normalized, false) then
			self:_Render(false)
		end
	elseif current ~= nil and self:_FindOption(current) == nil then
		self:_Commit(nil, false)
	else
		self:_Render(false)
	end
end

function Dropdown.GetValues(self: any): { any }
	local values = {}
	for _, option in self._choices do
		table.insert(values, option.Value)
	end
	return values
end

function Dropdown.AddValue(self: any, raw: any)
	local option = parseOption(raw)
	if option == nil then
		Log.warn("%s:AddValue: invalid option", self:_Describe())
		return
	end
	if self:_FindOption(option.Value) then
		return
	end
	local list = {}
	for _, existing in self._choices do
		table.insert(list, { Name = existing.Label, Value = existing.Value, Disabled = existing.Disabled })
	end
	table.insert(list, raw)
	self:SetValues(list)
end

function Dropdown.RemoveValue(self: any, value: any)
	local list = {}
	for _, existing in self._choices do
		if existing.Value ~= value then
			table.insert(list, { Name = existing.Label, Value = existing.Value, Disabled = existing.Disabled })
		end
	end
	self:SetValues(list)
end

function Dropdown.SetOptionDisabled(self: any, value: any, disabled: boolean)
	local option = self:_FindOption(value)
	if option == nil then
		Log.warn('%s:SetOptionDisabled: no option "%s"', self:_Describe(), tostring(value))
		return
	end
	option.Disabled = disabled == true
	self:_RenderItems()
end

function Dropdown.IsSelected(self: any, value: any): boolean
	if self.Multi then
		for _, selected in self.Value do
			if selected == value then
				return true
			end
		end
		return false
	end
	return self.Value ~= nil and self.Value == value
end

--------------------------------------------------------------------------------
-- Value
--------------------------------------------------------------------------------

function Dropdown._Normalize(self: any, value: any): (boolean, any)
	if self.Multi then
		if value == nil then
			return true, {}
		end
		if type(value) ~= "table" then
			if type(value) == "string" or type(value) == "number" then
				value = { value }
			else
				return false, "expected an array of option values"
			end
		end
		-- Accept arrays and { [value] = true } sets.
		local wanted: { [any]: boolean } = {}
		local unknown = {}
		local function want(candidate: any)
			local option = self:_FindOption(candidate)
			if option then
				wanted[option.Value] = true
			else
				table.insert(unknown, tostring(candidate))
			end
		end
		if #value > 0 then
			for _, candidate in value do
				want(candidate)
			end
		else
			for key, flag in value do
				if flag == true then
					want(key)
				end
			end
		end
		if #unknown > 0 then
			Log.warn("%s: ignoring unknown option(s) %s", self:_Describe(), table.concat(unknown, ", "))
		end
		local ordered = {}
		for _, option in self._choices do
			if wanted[option.Value] then
				table.insert(ordered, option.Value)
			end
		end
		return true, ordered
	end

	if value == nil or value == false then
		if self.AllowNone or self.Value == nil then
			return true, nil
		end
		return false, "a value is required (set AllowNone = true to allow clearing)"
	end
	local option = self:_FindOption(value)
	if option == nil then
		return false, string.format('"%s" is not one of the options', tostring(value))
	end
	return true, option.Value
end

-- Clears the selection (multi-select or AllowNone dropdowns).
function Dropdown.Clear(self: any)
	if self.Multi then
		self:SetValue({})
	else
		self:SetValue(nil)
	end
end

function Dropdown.Serialize(self: any): any
	if self.Multi then
		return table.clone(self.Value)
	end
	if self.Value == nil then
		return false
	end
	return self.Value
end

function Dropdown.Deserialize(self: any, data: any): (boolean, string?)
	if not self.Multi and data == false then
		data = nil
	end
	if self.Multi and type(data) ~= "table" then
		return false, "expected an array"
	end
	local ok, normalized = self:_Normalize(data)
	if not ok then
		return false, tostring(normalized)
	end
	self:_Commit(normalized, false)
	return true, nil
end

