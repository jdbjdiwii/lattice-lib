-- Properties
--------------------------------------------------------------------------------

function Section.SetName(self: any, name: string?)
	self.Name = name
	if self._titleLabel then
		self._titleLabel.Text = name or ""
		self._titleLabel.Visible = name ~= nil and name ~= ""
	elseif name then
		Log.warn("Section:SetName: this section was created without a header")
	end
end

function Section.SetDescription(self: any, description: string?)
	self.Description = description
	if self._descriptionLabel then
		self._descriptionLabel.Text = description or ""
		self._descriptionLabel.Visible = description ~= nil and description ~= ""
	elseif description then
		Log.warn("Section:SetDescription: this section was created without a header")
	end
end

function Section.SetVisible(self: any, visible: boolean)
	self.Visible = visible
	self._frame.Visible = visible
end

function Section.SetTheme(self: any, overrides: { [string]: any })
	self._scope:Set(overrides)
end

function Section.IsCollapsed(self: any): boolean
	return self._collapsed
end

--[[
	Collapses or expands the section body with a height animation. The body
	returns to automatic sizing once expanded, so later changes still reflow.
]]
function Section.SetCollapsed(self: any, collapsed: boolean, animate: boolean?)
	if self._collapsed == collapsed then
		return
	end
	self._collapsed = collapsed
	local body: Frame = self._body
	local scale = math.max(self._window:_GetScale(), 0.01)
	local scope = self._scope
	local shouldAnimate = animate ~= false

	if self._chevron then
		local chevron = self._chevron.Frame
		if shouldAnimate then
			Animator.Play(chevron, { Rotation = if collapsed then -90 else 0 }, { Scope = scope })
		else
			Animator.Set(chevron, { Rotation = if collapsed then -90 else 0 })
		end
	end

	if collapsed then
		local height = body.AbsoluteSize.Y / scale
		self._expandedHeight = height
		body.AutomaticSize = Enum.AutomaticSize.None
		body.ClipsDescendants = true
		body.Size = UDim2.new(1, 0, 0, height)
		local function finish()
			if self._collapsed then
				body.Visible = false
			end
		end
		if shouldAnimate then
			Animator.Play(body, { Size = UDim2.new(1, 0, 0, 0) }, { Scope = scope, OnComplete = finish })
		else
			Animator.Set(body, { Size = UDim2.new(1, 0, 0, 0) })
			finish()
		end
	else
		body.Visible = true
		local measured = self._bodyLayout.AbsoluteContentSize.Y / scale
		local target = if measured > 0 then measured else (self._expandedHeight or 0)
		local function finish()
			if not self._collapsed then
				body.AutomaticSize = Enum.AutomaticSize.Y
				body.Size = UDim2.new(1, 0, 0, 0)
				body.ClipsDescendants = false
			end
		end
		if shouldAnimate then
			Animator.Play(body, { Size = UDim2.new(1, 0, 0, target) }, { Scope = scope, OnComplete = finish })
		else
			Animator.Set(body, { Size = UDim2.new(1, 0, 0, target) })
			finish()
		end
	end
end

function Section.Collapse(self: any)
	self:SetCollapsed(true)
end

function Section.Expand(self: any)
	self:SetCollapsed(false)
end

function Section.Destroy(self: any)
	if self._destroyed then
		return
	end
	self._destroyed = true
	self.Destroying:Fire()
	for _, component: any in table.clone(self.Components) do
		component:Destroy()
	end
	self._maid:Destroy()
	self._scope:Destroy()
	self._tab:_RemoveSection(self)
	self.Destroying:Destroy()
	Util.Retire(self)
end

return Section
end

-- Signal ----------------------------------------------------------------------
definitions["Signal"] = function(...)
--[[
	Signal

	A small event primitive for library-level events (value changes, window
	visibility, tab selection...).

	Every handler runs on its own thread via task.spawn, so a handler that yields
	or errors can never stall or break the code that fired the event. Errors are
	reported through Log, which rate-limits repeats.
]]

local Log = import("Log")

type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

type Signal<T...> = {
	Connect: (self: Signal<T...>, handler: (T...) -> ()) -> Connection,
	Once: (self: Signal<T...>, handler: (T...) -> ()) -> Connection,
	Wait: (self: Signal<T...>) -> T...,
	Fire: (self: Signal<T...>, T...) -> (),
	DisconnectAll: (self: Signal<T...>) -> (),
	Destroy: (self: Signal<T...>) -> (),
}

local Connection = {}
Connection.__index = Connection

function Connection.Disconnect(self: any)
	if not self.Connected then
		return
	end
	self.Connected = false
	local handlers = self._signal._handlers
	local index = table.find(handlers, self)
	if index then
		table.remove(handlers, index)
	end
end

local Signal = {}
Signal.__index = Signal

local function runHandler(handler: (...any) -> ...any, source: string?, ...: any)
	local ok, err = xpcall(handler, debug.traceback, ...)
	if not ok then
		Log.handlerError(err, source)
	end
end

--[[
	Creates a signal. `source` is an optional label used in error reports,
	for example 'Toggle "Enabled" Changed'.
]]
function Signal.new<T...>(source: string?): Signal<T...>
	local self = setmetatable({
		_handlers = {},
		_source = source,
	}, Signal)
	return (self :: any) :: Signal<T...>
end

function Signal.Connect(self: any, handler: (...any) -> ()): Connection
	if type(handler) ~= "function" then
		Log.error("Signal:Connect expects a function, got %s", typeof(handler))
	end
	local connection = setmetatable({
		Connected = not self._destroyed,
		_signal = self,
		_handler = handler,
	}, Connection)
	-- A destroyed signal never fires again, so it does not keep handlers.
	if not self._destroyed then
		table.insert(self._handlers, connection)
	end
	return (connection :: any) :: Connection
end

function Signal.Once(self: any, handler: (...any) -> ()): Connection
	local connection: Connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		handler(...)
	end)
	return connection
end

function Signal.Fire(self: any, ...: any)
	local handlers = self._handlers
	if #handlers == 0 or self._destroyed then
		return
	end
	-- Snapshot so handlers may connect/disconnect while we iterate.
	for _, connection: any in table.clone(handlers) do
		if connection.Connected then
			task.spawn(runHandler, connection._handler, self._source, ...)
		end
	end
end

function Signal.Wait(self: any): ...any
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal.DisconnectAll(self: any)
	for _, connection in self._handlers do
		connection.Connected = false
	end
	table.clear(self._handlers)
end

function Signal.Destroy(self: any)
	self:DisconnectAll()
	self._destroyed = true
end

-- Number of live connections (useful for leak checks in tests).
function Signal.GetConnectionCount(self: any): number
	return #self._handlers
end

return Signal
end

-- Slider ----------------------------------------------------------------------
definitions["Slider"] = function(...)
--[[
	Slider

	    local Slider = Section:AddSlider({
	        Name = "Walk Speed",
	        Min = 0,
	        Max = 100,
	        Default = 16,
	        Increment = 1,      -- step size (optional)
	        Rounding = 0,       -- decimal places (optional, inferred when omitted)
	        Prefix = "",
	        Suffix = " studs",
	        Input = true,       -- click the value to type an exact number
	        Callback = function(value) print(value) end,
	        OnRelease = function(value) end, -- after a drag ends
	    })

	Values are clamped to [Min, Max], snapped to Increment (measured from Min)
	and rounded to Rounding decimal places. While dragging, the callback runs
	only when the rounded value actually changes. With a gamepad, select the
	slider and use the D-pad to move one Increment, or the shoulder buttons to
	move a tenth of the range.
]]

local Animator = import("Animator")
local InputManager = import("InputManager")
local Log = import("Log")
local Theme = import("Theme")
local Util = import("Util")
local Widgets = import("Widgets")

local Base = import("Base")

local Slider = Base.extend("Slider", {
	Min = { Type = "number", Default = 0 },
	Max = { Type = "number", Default = 100 },
	Default = { Type = "number" },
	Increment = {
		Type = "number",
		Validate = function(value)
			return value > 0, "must be greater than zero"
		end,
	},
	Rounding = {
		Type = "number",
		Validate = function(value)
			return value >= 0 and value <= 6 and value % 1 == 0, "must be a whole number from 0 to 6"
		end,
	},
	Prefix = { Type = "string", Default = "" },
	Suffix = { Type = "string", Default = "" },
	Input = { Type = "boolean", Default = true },
	Format = { Type = "function" },
	OnRelease = { Type = "function" },
}, { Value = "Default", Step = "Increment", Minimum = "Min", Maximum = "Max" })
Slider.DefaultName = "Slider"
Slider.Serializable = true

local TRACK_HEIGHT = 4
local KNOB_SIZE = 12
local HIT_HEIGHT = 18

local function inferRounding(min: number, max: number, increment: number?): number
	if increment then
		return Util.DecimalsOf(increment)
	end
	local range = max - min
	local decimals = if range <= 1 then 2 elseif range <= 10 then 1 else 0
	return math.max(decimals, Util.DecimalsOf(min), Util.DecimalsOf(max))
end

function Slider.new(context: any, options: any)
	local self: any = setmetatable({}, Slider)
	local resolved = self:_Init(context, options)

	local min, max = resolved.Min, resolved.Max
	if min > max then
		Log.warn("%s: Min (%s) is greater than Max (%s); swapping them", self:_Describe(), min, max)
		min, max = max, min
	elseif min == max then
		Log.warn("%s: Min and Max are both %s; using Max = Min + 1", self:_Describe(), min)
		max = min + 1
	end
	self.Min, self.Max = min, max
	self.Rounding = resolved.Rounding or inferRounding(min, max, resolved.Increment)
	self.Increment = resolved.Increment or 10 ^ -self.Rounding
	self.Prefix, self.Suffix = resolved.Prefix, resolved.Suffix
	self._format = resolved.Format
	self._onRelease = resolved.OnRelease
	self._dragging = false
	self._hovered = false

	local initial = resolved.Default
	if initial == nil then
		initial = min
	end
	local _, normalized = self:_Normalize(initial)
	self:_InitValue(normalized)

	self:_Build(resolved.Input)
	self:_Mount()
	return self
end

function Slider._Build(self: any, editable: boolean)
	local scope: Theme.Scope = self._scope
	local root = self:_CreateRoot()
	Util.List(root, { Padding = UDim.new(0, 6) })

	local header = Util.Create("Frame", {
		Name = "Header",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		ZIndex = 2,
		Parent = root,
	})
	Util.List(header, {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Top,
		Padding = UDim.new(0, 10),
	})
	self:_BuildTextBlock(header, 1)

	local valueBox = Widgets.Label(scope, {
		Text = "",
		Color = false,
		Weight = Enum.FontWeight.Medium,
		Properties = {
			Name = "Value",
			Size = UDim2.new(0, 0, 0, 18),
			AutomaticSize = Enum.AutomaticSize.X,
			TextXAlignment = Enum.TextXAlignment.Right,
			LayoutOrder = 2,
			ZIndex = 2,
			Parent = header,
		},
	}, if editable then "TextBox" else "TextLabel")
	Util.Create("UISizeConstraint", { MinSize = Vector2.new(24, 0), Parent = valueBox })
	if editable then
		valueBox.ClearTextOnFocus = false
		self._maid:Add(valueBox.Focused:Connect(function()
			if self.Disabled then
				valueBox:ReleaseFocus()
				return
			end
			valueBox.Text = Util.FormatNumber(self.Value, self.Rounding)
			self:_RenderValueText()
		end))
		self._maid:Add(valueBox.FocusLost:Connect(function()
			local text = string.gsub(valueBox.Text, "[^%d%.%-eE]", "")
			local number = tonumber(text)
			if number and not self.Disabled then
				self:SetValue(number)
			end
			self:_RenderValueText()
		end))
	end
	self._valueBox = valueBox

	local area = Util.Create("TextButton", {
		Name = "Track",
		Size = UDim2.new(1, 0, 0, HIT_HEIGHT),
		LayoutOrder = 2,
		Selectable = true,
		ZIndex = 2,
		Parent = root,
	})
	Util.Padding(area, 0, KNOB_SIZE / 2, 0, KNOB_SIZE / 2)
	area.NextSelectionLeft = area
	area.NextSelectionRight = area
	local inner = Util.Create("Frame", {
		Name = "Inner",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = area,
	})
	local track = Util.Create("Frame", {
		Name = "Rail",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, TRACK_HEIGHT),
		ZIndex = 2,
		Parent = inner,
	})
	Util.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })
	local fill = Util.Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		ZIndex = 3,
		Parent = track,
	})
	Util.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })
	local knob = Util.Create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(KNOB_SIZE, KNOB_SIZE),
		ZIndex = 4,
		Parent = inner,
	})
	Util.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })
	self._knobStroke = Util.Create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Thickness = 2,
		Parent = knob,
	})
	self._knobScale = Util.Create("UIScale", { Parent = knob })

	self._area = area
	self._rail = track
	self._fill = fill
	self._knob = knob

	self._maid:Add(area.InputBegan:Connect(function(input: InputObject)
		self:_BeginDrag(input)
	end))
	self._maid:Add(InputManager.TrackState(area, function(state)
		local hovered = state == Enum.GuiState.Hover or state == Enum.GuiState.Press
		if hovered ~= self._hovered then
			self._hovered = hovered
			self:_Render(true)
		end
	end))
	self._maid:Add(self._context.Input:OnSelectedInput(area, function(input: InputObject): boolean
		if self.Disabled then
			return false
		end
		-- D-pad: one Increment. Shoulder buttons: a tenth of the range.
		local key = input.KeyCode
		local coarse = math.max(self.Increment, Util.Snap((self.Max - self.Min) / 10, self.Increment, 0))
		local delta = if key == Enum.KeyCode.DPadLeft
			then -self.Increment
			elseif key == Enum.KeyCode.DPadRight then self.Increment
			elseif key == Enum.KeyCode.ButtonL1 then -coarse
			elseif key == Enum.KeyCode.ButtonR1 then coarse
			else nil
		if delta == nil then
			return false
		end
		self:SetValue(self.Value + delta)
		return true
	end))
	self._maid:Add(scope:Observe(function()
		self:_Render(false)
	end))
end

function Slider._ValueFromPointer(self: any, position: Vector2): number
	local rail: Frame = self._rail
	local width = rail.AbsoluteSize.X
	if width <= 0 then
		return self.Value
	end
	local alpha = math.clamp((position.X - rail.AbsolutePosition.X) / width, 0, 1)
	return self.Min + (self.Max - self.Min) * alpha
end

function Slider._BeginDrag(self: any, input: InputObject)
	if self.Disabled or self._destroyed then
		return
	end
	local inputType = input.UserInputType
	if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then
		return
	end
	local inputManager = self._context.Input
	local started = inputManager:BeginDrag(input, {
		Move = function(position: Vector2)
			self:SetValue(self:_ValueFromPointer(position))
		end,
		End = function()
			self._dragging = false
			self:_Render(true)
			Util.SafeCall(self._onRelease, self:_Describe() .. " OnRelease", self.Value)
		end,
	})
	if started then
		self._dragging = true
		self:SetValue(self:_ValueFromPointer(inputManager:GetPointerPosition(input)))
		self:_Render(true)
	end
end

function Slider._Normalize(self: any, value: any): (boolean, any)
	if type(value) ~= "number" or value ~= value then
		return false, "expected a number, got " .. typeof(value)
	end
	local clamped = math.clamp(value, self.Min, self.Max)
	local snapped = Util.Snap(clamped, self.Increment, self.Min)
	local rounded = Util.Round(math.clamp(snapped, self.Min, self.Max), self.Rounding)
	return true, rounded
end

function Slider._DisplayText(self: any): string
	local text
	if self._format then
		local ok, result = pcall(self._format, self.Value)
		text = if ok then tostring(result) else Util.FormatNumber(self.Value, self.Rounding)
	else
		text = Util.FormatNumber(self.Value, self.Rounding)
	end
	return self.Prefix .. text .. self.Suffix
end

function Slider._RenderValueText(self: any)
	local box = self._valueBox
	local t = self._scope:View()
	local focused = box:IsA("TextBox") and box:IsFocused()
	if not focused then
		box.Text = self:_DisplayText()
	end
	box.TextColor3 = if self.Disabled then t.DisabledText elseif focused or self._dragging then t.Text else t.MutedText
end

function Slider._Render(self: any, animate: boolean)
	local t = self._scope:View()
	local alpha = (self.Value - self.Min) / (self.Max - self.Min)
	local disabled = self.Disabled
	local active = (self._hovered or self._dragging) and not disabled
	local instant = not animate or self._dragging
	local function apply(instance: Instance, goals: { [string]: any }, scale: number?)
		if instant then
			Animator.Set(instance, goals)
		else
			Animator.Play(instance, goals, { Scope = self._scope, DurationScale = scale })
		end
	end
	apply(self._fill, {
		Size = UDim2.fromScale(alpha, 1),
		BackgroundColor3 = if disabled then t.DisabledText else t.SliderFill,
	})
	apply(self._knob, {
		Position = UDim2.fromScale(alpha, 0.5),
		BackgroundColor3 = if disabled then t.DisabledText else t.SliderKnob,
	})
	Animator.Play(self._knobScale, { Scale = if active then 1.2 else 1 }, { Scope = self._scope, DurationScale = 0.8 })
	-- The ring keeps the knob visible on light surfaces too.
	self._knobStroke.Color = if disabled then t.Disabled else t.SliderFill
	self._rail.BackgroundColor3 = if disabled then t.Disabled else t.SliderTrack
	self:_RenderValueText()
end

function Slider._OnDisabledChanged(self: any, disabled: boolean)
	self._area.Interactable = not disabled
	self._area.Selectable = not disabled
	local box = self._valueBox
	if box:IsA("TextBox") then
		box.TextEditable = not disabled
		if disabled and box:IsFocused() then
			box:ReleaseFocus()
		end
	end
end

-- Changes the range. The current value is clamped into it.
function Slider.SetRange(self: any, min: number, max: number)
	if type(min) ~= "number" or type(max) ~= "number" or min >= max then
		Log.warn("%s:SetRange: Min must be a number less than Max", self:_Describe())
		return
	end
	self.Min, self.Max = min, max
	local _, normalized = self:_Normalize(self.Value)
	if not self:_Commit(normalized, false) then
		self:_Render(true)
	end
end

function Slider.SetIncrement(self: any, increment: number)
	if type(increment) ~= "number" or increment <= 0 then
		Log.warn("%s:SetIncrement expects a positive number", self:_Describe())
		return
	end
	self.Increment = increment
	self.Rounding = math.max(self.Rounding, Util.DecimalsOf(increment))
	self:SetValue(self.Value)
end

function Slider.SetPrefix(self: any, prefix: string)
	self.Prefix = prefix or ""
	self:_RenderValueText()
end

function Slider.SetSuffix(self: any, suffix: string)
	self.Suffix = suffix or ""
	self:_RenderValueText()
end

function Slider._OnDestroy(self: any)
	if self._dragging then
		self._context.Input:EndDrag()
	end
end

return Slider
end

-- State -----------------------------------------------------------------------
definitions["State"] = function(...)
--[[
	State

	An observable value. Components keep their value in a State, windows keep
	their open/minimised flags in States, and the configuration system watches
	them for auto-save. Setting a value that is equal to the current one is a
	no-op, so observers only run on real changes.
]]

local Signal = import("Signal")

local State = {}
State.__index = State

type State<T> = {
	Changed: Signal.Signal<T, T>,
	Get: (self: State<T>) -> T,
	Set: (self: State<T>, value: T, silent: boolean?) -> boolean,
	Observe: (self: State<T>, callback: (T) -> ()) -> Signal.Connection,
	Destroy: (self: State<T>) -> (),
}

--[[
	Creates a state. `equals` customises change detection, for example for
	arrays or colours that should compare by content.
]]
function State.new<T>(initial: T, equals: ((T, T) -> boolean)?, source: string?): State<T>
	local self = setmetatable({
		_value = initial,
		_equals = equals,
		Changed = Signal.new(source),
	}, State)
	return (self :: any) :: State<T>
end

function State.Get(self: any): any
	return self._value
end

-- Returns true when the value actually changed. `silent` skips observers.
function State.Set(self: any, value: any, silent: boolean?): boolean
	local previous = self._value
	local equals = self._equals
	if equals then
		if equals(previous, value) then
			return false
		end
	elseif previous == value then
		return false
	end
	self._value = value
	if not silent then
		self.Changed:Fire(value, previous)
	end
	return true
end

-- Calls `callback` with the current value now and after every change.
function State.Observe(self: any, callback: (any) -> ()): Signal.Connection
	task.spawn(callback, self._value)
	return self.Changed:Connect(callback)
end

function State.Destroy(self: any)
	self.Changed:Destroy()
end

return State
end

-- Tab -------------------------------------------------------------------------
definitions["Tab"] = function(...)
--[[
	Tab

	A sidebar entry plus a scrolling page of sections laid out in columns.
	Pages are built once and only shown/hidden on selection (no UI is recreated
	when switching tabs). Column count adapts to the available width: "Auto"
	uses two columns when there is room and one otherwise, and sections are
	re-flowed in creation order when the count changes.
]]

local Animator = import("Animator")
local Icons = import("Icons")
local InputManager = import("InputManager")
local Log = import("Log")
local Maid = import("Maid")
local Options = import("Options")
local Signal = import("Signal")
local Theme = import("Theme")
local Util = import("Util")
local Widgets = import("Widgets")

local Section = import("Section")

local Tab = {}
Tab.__index = Tab

local TAB_HEIGHT = 34
local MIN_COLUMN_WIDTH = 220
local PAGE_PADDING = 14

local SCHEMA: Options.Schema = {
	Name = { Type = "string", Default = "Tab" },
	Icon = { Type = "string" },
	Description = { Type = "string" },
	Visible = { Type = "boolean", Default = true },
	Disabled = { Type = "boolean", Default = false },
	Order = { Type = "number", Default = 0 },
	Columns = {
		Type = "number|string",
		Validate = function(value)
			if value == "Auto" or (type(value) == "number" and value >= 1 and value <= 4) then
				return true
			end
			return false, 'must be "Auto" or a number from 1 to 4'
		end,
	},
	Callback = { Type = "function" },
	Theme = { Type = "table" },
}

local ALIASES = { Title = "Name", OnSelected = "Callback" }

function Tab.new(window: any, rawOptions: any, index: number)
	local options = Options.Resolve("CreateTab", rawOptions, SCHEMA, ALIASES)
	local scope = window._scope:Extend()
	if options.Theme then
		scope:Set(options.Theme)
	end

	local self: any = setmetatable({
		Type = "Tab",
		Name = options.Name,
		Description = options.Description,
		Icon = options.Icon,
		Visible = options.Visible,
		Disabled = options.Disabled,
		Order = options.Order,
		Sections = {},
		Selected = Signal.new("Tab.Selected"),
		Deselected = Signal.new("Tab.Deselected"),
		Destroying = Signal.new("Tab.Destroying"),
		_window = window,
		_scope = scope,
		_maid = Maid.new(),
		_index = index,
		_callback = options.Callback,
		_columnSetting = options.Columns or window._options.Columns,
		_columns = {} :: { Frame },
		_columnCount = 0,
		_sectionCounter = 0,
		_selected = false,
		_compact = false,
		_state = Enum.GuiState.Idle,
		_destroyed = false,
	}, Tab)

	self:_BuildButton()
	self:_BuildPage()
	self:_SetColumnCount(1)
	return self
end

--------------------------------------------------------------------------------
-- Sidebar button
--------------------------------------------------------------------------------

function Tab._BuildButton(self: any)
	local scope: Theme.Scope = self._scope
	local window = self._window
	local button = Util.Create("TextButton", {
		Name = "Tab_" .. self.Name,
		Size = UDim2.new(1, 0, 0, TAB_HEIGHT),
		LayoutOrder = self:_LayoutOrder(),
		Visible = self.Visible,
		ZIndex = 3,
	})
	self._maid:Add(button)
	self._buttonPadding = Util.Padding(button, 0, 8, 0, 12)
	self._buttonList = Util.List(button, {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 10),
	})

	self:_BuildIcon(button)

	self._label = Widgets.Label(scope, {
		Text = self.Name,
		Weight = Enum.FontWeight.Medium,
		Color = false,
		Properties = {
			Name = "Label",
			Size = UDim2.new(0, 0, 0, 18),
			LayoutOrder = 2,
			ZIndex = 3,
			Parent = button,
		},
	})
	Util.Fill(self._label)

	self._maid:Add(InputManager.TrackState(button, function(state)
		if state ~= self._state then
			self._state = state
			self:_RenderButton(true)
		end
	end))
	self._maid:Add(button.Activated:Connect(function()
		if not self.Disabled then
			window:SelectTab(self)
		end
	end))
	self._maid:Add(window._tooltips:Attach(button, function()
		if self._compact then
			return self.Name
		end
		return self.Description
	end))
	self._maid:Add(scope:Observe(function()
		self:_RenderButton(false)
	end))

	self._button = button
	button.Parent = window._tabButtons
end

function Tab._BuildIcon(self: any, button: GuiObject)
	if self._icon then
		self._icon:Destroy()
		self._icon = nil
		self._recolorIcon = nil
	end
	local source = self.Icon
	if source then
		local visual, recolor = Icons.Visual(source, { Size = 16, LayoutOrder = 1, ZIndex = 3, Parent = button })
		visual.ZIndex = 3
		self._icon = visual
		self._recolorIcon = recolor
	else
		-- Monogram used in the compact sidebar when no icon is provided.
		local monogram = Widgets.Label(self._scope, {
			Text = string.upper(string.sub(self.Name, 1, 1)),
			Weight = Enum.FontWeight.Bold,
			Color = false,
			Properties = {
				Name = "Monogram",
				Size = UDim2.fromOffset(18, 18),
				TextXAlignment = Enum.TextXAlignment.Center,
				Visible = self._compact,
				LayoutOrder = 1,
				ZIndex = 3,
				Parent = button,
			},
		})
		self._icon = monogram
		self._recolorIcon = function(color: Color3)
			monogram.TextColor3 = color
		end
	end
end

function Tab._LayoutOrder(self: any): number
	return self.Order * 10000 + self._index
end

function Tab._RenderButton(self: any, animate: boolean)
	local t = self._scope:View()
	local color
	if self.Disabled then
		color = t.DisabledText
	elseif self._selected then
		color = t.Text
	elseif self._state == Enum.GuiState.Hover or self._state == Enum.GuiState.Press then
		color = t.MutedText:Lerp(t.Text, 0.6)
	else
		color = t.MutedText
	end
	if animate then
		Animator.Play(self._label, { TextColor3 = color }, { Scope = self._scope, DurationScale = 0.7 })
	else
		Animator.Set(self._label, { TextColor3 = color })
	end
	if self._recolorIcon then
		self._recolorIcon(if self._selected and not self.Disabled then t.Accent else color)
	end
end

function Tab._SetCompact(self: any, compact: boolean)
	self._compact = compact
	self._label.Visible = not compact
	if self._icon and self._icon.Name == "Monogram" then
		self._icon.Visible = compact
	end
	self._buttonList.HorizontalAlignment = if compact
		then Enum.HorizontalAlignment.Center
		else Enum.HorizontalAlignment.Left
	self._buttonPadding.PaddingLeft = UDim.new(0, if compact then 0 else 12)
	self._buttonPadding.PaddingRight = UDim.new(0, if compact then 0 else 8)
end

--------------------------------------------------------------------------------
-- Page
--------------------------------------------------------------------------------

function Tab._BuildPage(self: any)
	local scope: Theme.Scope = self._scope
	local window = self._window
	local page = Util.Create("Frame", {
		Name = "Page_" .. self.Name,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 2,
	})
	self._maid:Add(page)
	Util.List(page)
	self._page = page

	if window._options.TabHeader then
		local header = Util.Create("Frame", {
			Name = "Header",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 1,
			ZIndex = 2,
			Parent = page,
		})
		Util.Padding(header, 16, PAGE_PADDING + 4, 4, PAGE_PADDING + 4)
		Util.List(header, { Padding = UDim.new(0, 3) })
		self._title = Widgets.Label(scope, {
			Text = self.Name,
			Style = "Title",
			Weight = Enum.FontWeight.SemiBold,
			Properties = {
				Name = "Title",
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = 1,
				ZIndex = 2,
				Parent = header,
			},
		})
		self._descriptionLabel = Widgets.Label(scope, {
			Text = self.Description or "",
			Style = "Small",
			Color = "MutedText",
			Wrapped = true,
			Properties = {
				Name = "Description",
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Visible = self.Description ~= nil and self.Description ~= "",
				LayoutOrder = 2,
				ZIndex = 2,
				Parent = header,
			},
		})
		self._header = header
	end

	local scroll = Util.Create("ScrollingFrame", {
		Name = "Scroll",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		LayoutOrder = 2,
		ZIndex = 2,
		Parent = page,
	})
	Util.Fill(scroll)
	scope:Bind(scroll, "ScrollBarImageColor3", "ScrollBar")
	self._scroll = scroll
	self._maid:Add(scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		if window._popups:HasOpen() then
			window._popups:CloseAll()
		end
		window._tooltips:Hide()
	end))

	local container = Util.Create("Frame", {
		Name = "Container",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 2,
		Parent = scroll,
	})
	Util.Padding(
		container,
		if window._options.TabHeader then 10 else PAGE_PADDING,
		PAGE_PADDING,
		PAGE_PADDING,
		PAGE_PADDING
	)
	local columnsLayout = Util.List(container, { FillDirection = Enum.FillDirection.Horizontal })
	scope:Bind(columnsLayout, "Padding", function(t)
		return UDim.new(0, t.SectionSpacing)
	end)
	self._container = container
	-- Column widths depend on the SectionSpacing token.
	self._maid:Add(scope:Observe(function()
		if self._columnCount > 0 then
			self:_UpdateColumnSizes()
		end
	end, false))

	page.Parent = window._content
end

-- Number of columns that fit `contentWidth` for this tab's column setting.
function Tab._ColumnsFor(self: any, contentWidth: number): number
	local setting = self._columnSetting
	local available = contentWidth - PAGE_PADDING * 2
	local gap = self._scope:Get("SectionSpacing")
	local fit = math.max(1, math.floor((available + gap) / (MIN_COLUMN_WIDTH + gap)))
	if setting == "Auto" or setting == nil then
		return math.min(2, fit)
	end
	return math.max(1, math.min(setting, fit))
end

-- Upper bound on columns, used to assign sections a "home" column.
function Tab._MaxColumns(self: any): number
	local setting = self._columnSetting
	if setting == "Auto" or setting == nil then
		return 2
	end
	return setting
end

function Tab._SetContentWidth(self: any, contentWidth: number)
	self._contentWidth = contentWidth
	self:_SetColumnCount(self:_ColumnsFor(contentWidth))
end

function Tab._SetColumnCount(self: any, count: number)
	if count == self._columnCount then
		return
	end
	self._columnCount = count
	local scope: Theme.Scope = self._scope
	local columns: { Frame } = self._columns
	for index = #columns + 1, count do
		local column = Util.Create("Frame", {
			Name = "Column" .. index,
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = index,
			ZIndex = 2,
			Parent = self._container,
		})
		local layout = Util.List(column)
		scope:Bind(layout, "Padding", function(t)
			return UDim.new(0, t.SectionSpacing)
		end)
		columns[index] = column
	end
	for index = #columns, count + 1, -1 do
		local column = columns[index]
		columns[index] = nil
		-- Move any sections out before removing the column.
		for _, section in self.Sections do
			if section._frame.Parent == column then
				section._frame.Parent = columns[1]
			end
		end
		scope:Unbind(column)
		column:Destroy()
	end
	self:_UpdateColumnSizes()
	for _, section in self.Sections do
		self:_PlaceSection(section)
	end
end

function Tab._UpdateColumnSizes(self: any)
	local count = self._columnCount
	local gap = self._scope:Get("SectionSpacing")
	for _, column in self._columns do
		column.Size = UDim2.new(1 / count, -gap * (count - 1) / count, 0, 0)
	end
end

function Tab._PlaceSection(self: any, section: any)
	local count = self._columnCount
	local home = section._home or 1
	local column = if count <= 1 then 1 else ((home - 1) % count) + 1
	section._frame.Parent = self._columns[column]
end

-- Chooses the home column for a new section: explicit side, else least used.
function Tab._AssignHome(self: any, preference: any): number
	local maxColumns = self:_MaxColumns()
	if preference == "Left" then
		return 1
	elseif preference == "Right" then
		return math.min(2, maxColumns)
	elseif type(preference) == "number" then
		return math.clamp(math.floor(preference), 1, maxColumns)
	end
	local counts = table.create(maxColumns, 0)
	for _, section in self.Sections do
		local home = section._home
		if home and counts[home] then
			counts[home] += 1
		end
	end
	local best = 1
	for index = 2, maxColumns do
		if counts[index] < counts[best] then
			best = index
		end
	end
	return best
end

--------------------------------------------------------------------------------
-- Sections
--------------------------------------------------------------------------------

function Tab.CreateSection(self: any, options: any)
	if self._destroyed then
		Log.warn("CreateSection called on a destroyed tab")
		return nil
	end
	if type(options) == "string" then
		options = { Name = options }
	end
	self._sectionCounter += 1
	local section = Section.new(self, options or {}, self._sectionCounter)
	table.insert(self.Sections, section)
	self:_PlaceSection(section)
	return section
end

-- Shortcuts for a section in the left or right column.
function Tab.AddLeftGroupbox(self: any, options: any)
	return self:_CreateSideSection(options, "Left")
end

function Tab.AddRightGroupbox(self: any, options: any)
	return self:_CreateSideSection(options, "Right")
end

function Tab._CreateSideSection(self: any, options: any, side: string)
	local resolved: { [string]: any } = if type(options) == "table" then table.clone(options) else { Name = options }
	resolved.Side = side
	return self:CreateSection(resolved)
end

function Tab.GetSections(self: any): { any }
	return table.clone(self.Sections)
end

function Tab._RemoveSection(self: any, section: any)
	local index = table.find(self.Sections, section)
	if index then
		table.remove(self.Sections, index)
	end
end

--------------------------------------------------------------------------------
-- Selection
--------------------------------------------------------------------------------

function Tab._IsSelectable(self: any): boolean
	return self.Visible and not self.Disabled and not self._destroyed
end

function Tab._SetSelected(self: any, selected: boolean, animate: boolean)
	if self._selected == selected then
		return
	end
	self._selected = selected
	self:_RenderButton(animate)
	local page: Frame = self._page
	if selected then
		page.Visible = true
		if animate then
			page.Position = UDim2.fromOffset(0, 10)
			Animator.Play(page, { Position = UDim2.new() }, { Scope = self._scope, DurationScale = 1.6 })
		else
			Animator.Set(page, { Position = UDim2.new() })
		end
		Util.SafeCall(self._callback, Util.Describe("Tab", self.Name) .. " callback", self)
		self.Selected:Fire()
	else
		Animator.Cancel(page)
		page.Visible = false
		self.Deselected:Fire()
	end
end

function Tab.Select(self: any)
	self._window:SelectTab(self)
end

function Tab.IsSelected(self: any): boolean
	return self._selected
end

--------------------------------------------------------------------------------
-- Properties
--------------------------------------------------------------------------------

function Tab.SetName(self: any, name: string)
	self.Name = name
	self._label.Text = name
	if self._title then
		self._title.Text = name
	end
	if self._icon and self._icon.Name == "Monogram" then
		self._icon.Text = string.upper(string.sub(name, 1, 1))
	end
end

function Tab.SetDescription(self: any, description: string?)
	self.Description = description
	if self._descriptionLabel then
		self._descriptionLabel.Text = description or ""
		self._descriptionLabel.Visible = description ~= nil and description ~= ""
	end
end

function Tab.SetIcon(self: any, icon: string?)
	self.Icon = icon
	self:_BuildIcon(self._button)
	self:_SetCompact(self._compact)
	self:_RenderButton(false)
end

function Tab.SetVisible(self: any, visible: boolean)
	self.Visible = visible
	self._button.Visible = visible
	self._window:_EnsureSelection()
end

function Tab.SetDisabled(self: any, disabled: boolean)
	self.Disabled = disabled
	self._button.Interactable = not disabled
	self:_RenderButton(true)
	self._window:_EnsureSelection()
end

function Tab.SetOrder(self: any, order: number)
	self.Order = order
	self._button.LayoutOrder = self:_LayoutOrder()
	self._window:_UpdateSelection(true)
end

function Tab.SetTheme(self: any, overrides: { [string]: any })
	self._scope:Set(overrides)
end

-- Scrolls the page so a section or a component is at the top.
function Tab.ScrollTo(self: any, target: any)
	local found = type(target) == "table" and (rawget(target, "_frame") or rawget(target, "Instance"))
	if typeof(found) ~= "Instance" or not (found :: Instance):IsA("GuiObject") then
		Log.warn("Tab:ScrollTo expects a section or a component")
		return
	end
	local frame = found :: GuiObject
	local scale = self._window:_GetScale()
	local offset = (frame.AbsolutePosition.Y - self._scroll.AbsolutePosition.Y) / scale
	self._scroll.CanvasPosition = Vector2.new(0, math.max(0, self._scroll.CanvasPosition.Y + offset - 8))
end

function Tab.Destroy(self: any)
	if self._destroyed then
		return
	end
	self._destroyed = true
	self.Destroying:Fire()
	for _, section: any in table.clone(self.Sections) do
		section:Destroy()
	end
	if self._selected then
		self._selected = false
	end
	self._maid:Destroy()
	self._scope:Destroy()
	self.Selected:Destroy()
	self.Deselected:Destroy()
	self._window:_RemoveTab(self)
	self.Destroying:Destroy()
	Util.Retire(self)
end

return Tab
end

-- Theme -----------------------------------------------------------------------
definitions["Theme"] = function(...)
--[[
	Theme

	Design tokens with hierarchical scopes.

	Every visual property in the library comes from a token (Accent, Background,
	CornerRadius, TextSize, AnimationDuration...). Tokens are resolved through a
	chain of scopes:

	    component scope -> section scope -> tab scope -> window scope -> library root

	The first scope that overrides a token wins; otherwise the token's default is
	used. Defaults may be functions of other tokens ("derived" tokens), evaluated
	in the asking scope, so overriding Accent on a single toggle also recolours
	that toggle's ToggleOn colour, which derives from Accent.

	Instances never read colours directly. They *bind* properties to tokens:

	    scope:Bind(label, "TextColor3", "MutedText")
	    scope:Bind(corner, "CornerRadius", function(t) return UDim.new(0, t.CornerRadius) end)

	When any scope changes, it re-applies its bindings and observers and then
	refreshes its descendants, so existing UI updates automatically.
]]

local Log = import("Log")
local Util = import("Util")
local Options = import("Options")
local Themes = import("Themes")

local Theme = {}

type View = { [string]: any }
type Resolver = (View) -> any
type Observer = (View) -> ...any
type TokenSpec = { Type: string, Default: any, Description: string? }

local function mix(a: Color3, b: Color3, alpha: number): Color3
	return a:Lerp(b, alpha)
end

local DEFAULT_FONT = Font.new("rbxasset://fonts/families/BuilderSans.json")

-- Ordered so documentation and GetTheme() output read naturally.
local TOKEN_LIST: { { any } } = {
	-- Palette
	{ "Accent", "Color3", Color3.fromRGB(96, 145, 255), "Primary accent colour" },
	{
		"AccentText",
		"Color3",
		function(t: View)
			return Util.ContrastText(t.Accent)
		end,
		"Text drawn on top of the accent colour",
	},
	{ "Background", "Color3", Color3.fromRGB(16, 17, 20), "Window background" },
	{
		"TopBar",
		"Color3",
		function(t: View)
			return t.Background
		end,
		"Window title bar",
	},
	{
		"Sidebar",
		"Color3",
		function(t: View)
			return mix(t.Background, t.Secondary, 0.35)
		end,
		"Tab list background",
	},
	{ "Secondary", "Color3", Color3.fromRGB(22, 23, 27), "Section / card background" },
	{ "Tertiary", "Color3", Color3.fromRGB(31, 33, 38), "Control surfaces (buttons, fields, tracks)" },
	{
		"Hover",
		"Color3",
		function(t: View)
			return mix(t.Tertiary, t.Text, 0.05)
		end,
		"Hovered control surface",
