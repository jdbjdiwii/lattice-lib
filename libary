-- Components and flags
--------------------------------------------------------------------------------

--[[
	Registers a component type so it can be created with Section:Add(name, ...)
	and Section:Add<Name>(...). See Components/Base.luau for how to write one.
]]
function Library.RegisterComponent(self: any, name: string, class: any)
	if type(name) ~= "string" or not string.match(name, "^%a%w*$") then
		Log.warn('RegisterComponent: name must be an identifier like "Stepper"')
		return
	end
	if type(class) ~= "table" or type(class.new) ~= "function" then
		Log.warn('RegisterComponent: "%s" must be a class with a new(context, options) function', name)
		return
	end
	if self._components[name] and BUILT_IN_COMPONENTS[name] then
		Log.warn('RegisterComponent: replacing the built-in "%s" component', name)
	end
	self._components[name] = class
end

function Library._GetComponentClass(self: any, name: string): any
	return self._components[name]
end

function Library._RegisterFlag(self: any, component: any, explicit: string?, path: string): string?
	local flags = self.Flags
	local flag = explicit
	if flag ~= nil then
		local existing = flags[flag]
		if existing ~= nil and existing ~= component then
			Log.warn(
				'Flag "%s" is already used by %s; %s will not be registered',
				flag,
				existing:_Describe(),
				component:_Describe()
			)
			return nil
		end
	else
		local base = path .. "/" .. (if component.Name ~= "" then component.Name else component.Type)
		flag = base
		local suffix = 2
		while flags[flag] ~= nil do
			flag = base .. "#" .. suffix
			suffix += 1
		end
	end
	flags[flag :: string] = component
	component.Flag = flag
	self._flagCounter = (self._flagCounter or 0) + 1
	component._flagOrder = self._flagCounter
	return flag
end

function Library._UnregisterFlag(self: any, component: any)
	local flag = component.Flag
	if flag and self.Flags[flag] == component then
		self.Flags[flag] = nil
	end
end

function Library._OnComponentChanged(self: any, component: any)
	self.Config:_OnValueChanged(component)
	if component.Flag then
		self.FlagChanged:Fire(component.Flag, component.Value)
	end
end

-- The component registered under `flag`, or nil.
function Library.GetFlag(self: any, flag: string): Component?
	return self.Flags[flag]
end

-- Shorthand for Flags[flag]:GetValue().
function Library.GetValue(self: any, flag: string): any
	local component = self.Flags[flag]
	if component == nil then
		Log.warn('GetValue: no component with flag "%s"', tostring(flag))
		return nil
	end
	return component:GetValue()
end

-- Shorthand for Flags[flag]:SetValue(value).
function Library.SetValue(self: any, flag: string, value: any): boolean
	local component = self.Flags[flag]
	if component == nil then
		Log.warn('SetValue: no component with flag "%s"', tostring(flag))
		return false
	end
	return component:SetValue(value)
end

