		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(18, 18),
		Visible = self._options.Resizable,
		Selectable = false,
		ZIndex = 8,
		Parent = body,
	})
	local icon = Icons.Create("Grip", {
		Size = 14,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 8,
		Parent = grip,
	})
	local hovered = false
	local function render()
		local t = scope:View()
		icon:SetColor(if hovered then t.Text else t.MutedText)
		icon:SetTransparency(if hovered then 0.1 else 0.45)
	end
	self._maid:Add(scope:Observe(render))
	self._maid:Add(InputManager.TrackState(grip, function(state)
		hovered = state == Enum.GuiState.Hover or state == Enum.GuiState.Press
		render()
	end))
	self._maid:Add(grip.InputBegan:Connect(function(input: InputObject)
		if not self._options.Resizable or self._minimized:Get() then
			return
		end
		self:_BeginResize(input)
	end))
	self._grip = grip
end

--------------------------------------------------------------------------------
-- Toggle key / toggle button
--------------------------------------------------------------------------------

--[[
	Sets the key that shows/hides the window. Accepts an Enum.KeyCode, a key
	name string, or false/nil to disable.
]]
function Window.SetToggleKey(self: any, key: any)
	self._maid:Clear("ToggleKey")
	if key == nil or key == false then
		self._toggleKey = nil
		return
	end
	local parsed = Util.ParseKey(key)
	if parsed == nil then
		Log.warn("Window:SetToggleKey: unrecognised key %s", tostring(key))
		self._toggleKey = nil
		return
	end
	self._toggleKey = parsed
	self._maid:Set(
		"ToggleKey",
		self._input:OnKey({
			Began = function(input: InputObject, processed: boolean)
				if self._input:IsTyping() then
					return
				end
				local key = InputManager.KeyOf(input)
				-- Mouse buttons pressed over GUI are "processed"; keyboard keys are
				-- only ignored while typing (shift-lock and similar bindings report
				-- processed input too, which would make the key feel unreliable).
				if processed and key and key.EnumType == Enum.UserInputType then
					return
				end
				if key == self._toggleKey then
					self:Toggle()
				end
			end,
		})
	)
end

function Window.GetToggleKey(self: any): EnumItem?
	return self._toggleKey
end

function Window._SetupToggleButton(self: any)
	local setting = self._options.ToggleButton
	local show = setting == true or type(setting) == "table" or (setting == "Auto" and self._input:IsTouchDevice())
	if show then
		self:SetToggleButtonVisible(true)
	end
end

--[[
	Shows or hides the floating button that toggles the window. The button is
	draggable and is shown automatically on touch devices.
]]
function Window.SetToggleButtonVisible(self: any, visible: boolean)
	if visible and self._toggleButton == nil then
		self:_BuildToggleButton()
	end
	if self._toggleButton then
		self._toggleButton.Visible = visible
	end
end

function Window._BuildToggleButton(self: any)
	local scope: Theme.Scope = self._scope
	local setting = if type(self._options.ToggleButton) == "table" then self._options.ToggleButton else {}

	local holder = Util.Create("Frame", {
		Name = "ToggleButton",
		Size = UDim2.fromOffset(46, 46),
		Position = setting.Position or UDim2.new(0, 18, 0.5, -23),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = self._gui,
	})
	Util.Create("UIScale", { Scale = self._scale, Parent = holder })
	Widgets.Shadow(scope, holder, "WindowCornerRadius", 20)
	local button, _, _ = Widgets.Surface(scope, {
		Background = "Secondary",
		Transparency = "SecondaryTransparency",
		Radius = "WindowCornerRadius",
		Properties = {
			Name = "Button",
			Size = UDim2.fromScale(1, 1),
			ZIndex = 21,
			Parent = holder,
		},
	}, "TextButton")
	local glyph = setting.Icon or self._options.Icon
	if glyph then
		local visual, recolor = Icons.Visual(glyph, {
			Size = 20,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			ZIndex = 22,
			Parent = button,
		})
		visual.ZIndex = 22
		self._maid:Add(scope:Observe(function(t)
			recolor(t.Accent)
		end))
	else
		local text = setting.Text or string.upper(string.sub(self.Title, 1, 1))
		Widgets.Label(scope, {
			Text = text,
			Style = "Title",
			Weight = Enum.FontWeight.Bold,
			Color = "Accent",
			Properties = {
				Size = UDim2.fromScale(1, 1),
				TextXAlignment = Enum.TextXAlignment.Center,
				ZIndex = 22,
				Parent = button,
			},
		})
	end

	-- Tap toggles, drag moves. Gamepad activation toggles too.
	self._maid:Add(button.InputBegan:Connect(function(input: InputObject)
		local inputType = input.UserInputType
		if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then
			return
		end
		local start = holder.Position
		local moved = false
		self._input:BeginDrag(input, {
			Move = function(_, delta: Vector2)
				if not moved and delta.Magnitude < 6 then
					return
				end
				moved = true
				holder.Position =
					UDim2.new(start.X.Scale, start.X.Offset + delta.X, start.Y.Scale, start.Y.Offset + delta.Y)
			end,
			End = function()
				if not moved then
					self:Toggle()
				end
			end,
		})
	end))
	self._maid:Add(button.Activated:Connect(function(input: InputObject?)
		if input and string.find(input.UserInputType.Name, "Gamepad") then
			self:Toggle()
		end
	end))
	self._toggleButton = holder
end

function Window._ShowHideHint(self: any)
	local buttonVisible = self._toggleButton ~= nil and self._toggleButton.Visible
	if self._toggleKey == nil and not buttonVisible then
		-- Never leave the user without a way back.
		self:SetToggleButtonVisible(true)
		return
	end
	if self._options.HideHint and self._toggleKey and not self._hintShown then
		self._hintShown = true
		self._library:Notify({
			Title = self.Title .. " hidden",
			Description = string.format("Press %s to show it again.", Util.KeyName(self._toggleKey)),
			Duration = 3,
		})
	end
end

--------------------------------------------------------------------------------
-- Layout, scaling and breakpoints
--------------------------------------------------------------------------------

function Window._GetScale(self: any): number
	return self._uiScale.Scale * self._animScale.Scale
end

function Window._Viewport(self: any): Vector2
	local size = self._gui.AbsoluteSize
	if size.X <= 0 or size.Y <= 0 then
		return Vector2.new(1920, 1080)
	end
	return size
end

-- Recomputes scale and size from the viewport, then applies breakpoints.
function Window._Layout(self: any)
	if self._destroyed then
		return
	end
	local viewport = self:_Viewport()
	local margin = SCREEN_MARGIN * 2
	local scale = self._userScale
	if self._options.AutoScale then
		scale *= math.clamp(viewport.Y / REFERENCE_HEIGHT, 1, 2)
	end
	local minSize: Vector2 = self._minSize
	local fit = math.min((viewport.X - margin) / minSize.X, (viewport.Y - margin) / minSize.Y)
	scale = math.max(math.min(scale, fit), 0.4)
	self._scale = scale
	self._uiScale.Scale = scale
	if self._toggleButton then
		local toggleScale = self._toggleButton:FindFirstChildOfClass("UIScale")
		if toggleScale then
			toggleScale.Scale = scale
		end
	end
	self:_ApplySize(self._desiredSize, false)
	self:_ClampPosition()
end

-- Clamps `size` to the min/max size and the space available on screen.
function Window._FitSize(self: any, size: Vector2): Vector2
	local viewport = self:_Viewport()
	local available = (viewport - Vector2.new(SCREEN_MARGIN * 2, SCREEN_MARGIN * 2)) / self._scale
	local minSize: Vector2 = self._minSize
	local maxSize: Vector2 = self._maxSize
	local width = math.clamp(size.X, minSize.X, math.max(minSize.X, math.min(maxSize.X, available.X)))
	local height = math.clamp(size.Y, minSize.Y, math.max(minSize.Y, math.min(maxSize.Y, available.Y)))
	return Vector2.new(math.floor(width + 0.5), math.floor(height + 0.5))
end

function Window._ApplySize(self: any, desired: Vector2, animate: boolean)
	self._size = self:_FitSize(desired)
	local height = if self._minimized:Get() then self._topBarHeight else self._size.Y
	local target = UDim2.fromOffset(self._size.X, height)
	if animate then
		Animator.Play(self._root, { Size = target }, { Scope = self._scope })
	else
		Animator.Set(self._root, { Size = target })
	end
	self:_ApplyBreakpoints()
end

function Window._ApplyBreakpoints(self: any)
	local width = self._size.X
	local compact = width < COMPACT_BREAKPOINT
	if compact ~= self._compact then
		self._compact = compact
		local sidebarWidth = if compact then COMPACT_SIDEBAR_WIDTH else self._sidebarWidth
		self._sidebar.Size = UDim2.new(0, sidebarWidth, 1, 0)
		self._sidebarLine.Position = UDim2.fromOffset(sidebarWidth, 0)
		self._content.Position = UDim2.fromOffset(sidebarWidth + 1, 0)
		self._content.Size = UDim2.new(1, -(sidebarWidth + 1), 1, 0)
		for _, tab in self.Tabs do
			tab:_SetCompact(compact)
		end
		self:_UpdateSelection(false)
	end
	local contentWidth = width - (if compact then COMPACT_SIDEBAR_WIDTH else self._sidebarWidth) - 1
	self._contentWidth = contentWidth
	for _, tab in self.Tabs do
		tab:_SetContentWidth(contentWidth)
	end
end

function Window._ClampPosition(self: any)
	local root: Frame = self._root
	if root.AnchorPoint ~= Vector2.zero or root.Position.X.Scale ~= 0 or root.Position.Y.Scale ~= 0 then
		return -- Scale-based positions (e.g. centred) stay on screen by construction.
	end
	local viewport = self:_Viewport()
	local size = Vector2.new(self._size.X, self._topBarHeight) * self._scale
	local keep = math.min(120 * self._scale, size.X)
	local x = math.clamp(root.Position.X.Offset, keep - size.X, viewport.X - keep)
	local y = math.clamp(root.Position.Y.Offset, 0, math.max(0, viewport.Y - size.Y))
	root.Position = UDim2.fromOffset(x, y)
end

-- Converts any position to a top-left offset so dragging/resizing is stable.
function Window._NormalizePosition(self: any)
	local root: Frame = self._root
	if root.AnchorPoint == Vector2.zero and root.Position.X.Scale == 0 and root.Position.Y.Scale == 0 then
		return
	end
	local viewport = self:_Viewport()
	local size = Vector2.new(self._size.X, root.Size.Y.Offset) * self._scale
	local position = root.Position
	local anchor = root.AnchorPoint
	local x = position.X.Scale * viewport.X + position.X.Offset - anchor.X * size.X
	local y = position.Y.Scale * viewport.Y + position.Y.Offset - anchor.Y * size.Y
	root.AnchorPoint = Vector2.zero
	root.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
end

function Window._BeginMove(self: any, input: InputObject)
	self:_NormalizePosition()
	self._popups:CloseAll()
	self._tooltips:Hide()
	local root: Frame = self._root
	local start = Vector2.new(root.Position.X.Offset, root.Position.Y.Offset)
	self._input:BeginDrag(input, {
		Move = function(_, delta: Vector2)
			local position = start + delta
			root.Position = UDim2.fromOffset(position.X, position.Y)
			self:_ClampPosition()
		end,
	})
end

function Window._BeginResize(self: any, input: InputObject)
	local inputType = input.UserInputType
	if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then
		return
	end
	self:_NormalizePosition()
	self._popups:CloseAll()
	self._tooltips:Hide()
	local start: Vector2 = self._size
	self._input:BeginDrag(input, {
		Move = function(_, delta: Vector2)
			self._desiredSize = self:_FitSize(start + delta / self._scale)
			self:_ApplySize(self._desiredSize, false)
		end,
	})
end

--------------------------------------------------------------------------------
-- Tabs
--------------------------------------------------------------------------------

function Window.CreateTab(self: any, options: any)
	if self._destroyed then
		Log.warn("CreateTab called on a destroyed window")
		return nil
	end
	if type(options) == "string" then
		options = { Name = options }
	end
	self._tabCounter += 1
	local tab = Tab.new(self, options, self._tabCounter)
	table.insert(self.Tabs, tab)
	tab:_SetCompact(self._compact)
	tab:_SetContentWidth(self._contentWidth or (self._size.X - self._sidebarWidth - 1))
	if self._selected == nil and tab:_IsSelectable() then
		self:SelectTab(tab, false)
	else
		self:_UpdateSelection(false)
	end
	return tab
end

-- Shortcut: Window:AddTab("Main", "Home") is CreateTab({ Name = "Main", Icon = "Home" }).
function Window.AddTab(self: any, options: any, icon: string?)
	if type(options) == "string" then
		options = { Name = options, Icon = icon }
	end
	return self:CreateTab(options)
end

-- Tabs that are visible, in display order.
function Window._OrderedTabs(self: any): { any }
	local ordered = {}
	for _, tab in self.Tabs do
		if tab.Visible then
			table.insert(ordered, tab)
		end
	end
	table.sort(ordered, function(a, b)
		if a.Order ~= b.Order then
			return a.Order < b.Order
		end
		return a._index < b._index
	end)
	return ordered
end

function Window.GetTab(self: any, name: string): any?
	for _, tab in self.Tabs do
		if tab.Name == name then
			return tab
		end
	end
	return nil
end

-- Every tab, in display order.
function Window.GetTabs(self: any): { any }
	return self:_OrderedTabs()
end

--[[
	Selects a tab (object or name). Disabled or hidden tabs cannot be selected.
]]
function Window.SelectTab(self: any, target: any, animate: boolean?)
	local tab = if type(target) == "string" then self:GetTab(target) else target
	if tab == nil then
		Log.warn("SelectTab: no tab named %s", tostring(target))
		return
	end
	if not tab:_IsSelectable() then
		return
	end
	local previous = self._selected
	if previous == tab then
		return
	end
	self._popups:CloseAll()
	self._tooltips:Hide()
	self._selected = tab
	local shouldAnimate = animate ~= false and self._open:Get()
	if previous then
		previous:_SetSelected(false, shouldAnimate)
	end
	tab:_SetSelected(true, shouldAnimate)
	self:_UpdateSelection(shouldAnimate)
	self.TabChanged:Fire(tab, previous)
end

function Window.GetSelectedTab(self: any): any?
	return self._selected
end

-- Picks a new tab when the selected one is hidden, disabled or destroyed.
function Window._EnsureSelection(self: any)
	local selected = self._selected
	if selected and selected:_IsSelectable() then
		self:_UpdateSelection(true)
		return
	end
	if selected then
		selected:_SetSelected(false, false)
		self._selected = nil
	end
	for _, tab in self:_OrderedTabs() do
		if tab:_IsSelectable() then
			self:SelectTab(tab, false)
			return
		end
	end
	self:_UpdateSelection(false)
end

-- Moves the selection highlight behind the selected tab's button.
function Window._UpdateSelection(self: any, animate: boolean)
	local pill: Frame = self._pill
	local selected = self._selected
	local index = nil
	if selected then
		for position, tab in self:_OrderedTabs() do
			if tab == selected then
				index = position
				break
			end
		end
	end
	if index == nil then
		pill.Visible = false
		return
	end
	pill.Visible = true
	local inset = if self._compact then 6 else 8
	local target = {
		Position = UDim2.fromOffset(inset, 10 + (index - 1) * (TAB_HEIGHT + TAB_GAP)),
		Size = UDim2.new(1, -inset * 2, 0, TAB_HEIGHT),
		BackgroundTransparency = 0,
	}
	if animate then
		Animator.Play(pill, target, { Scope = self._scope, DurationScale = 1.2 })
	else
		Animator.Set(pill, target)
	end
end

function Window._RemoveTab(self: any, tab: any)
	local index = table.find(self.Tabs, tab)
	if index then
		table.remove(self.Tabs, index)
	end
	if self._selected == tab then
		self._selected = nil
	end
	if not self._destroyed then
		self:_EnsureSelection()
	end
end

--------------------------------------------------------------------------------
-- Visibility
--------------------------------------------------------------------------------

function Window.Open(self: any)
	if self._destroyed or self._open:Get() then
		return
	end
	self._open:Set(true)
	local scope = self._scope
	self._root.Visible = true
	local options = { Scope = scope, DurationScale = 1.5 }
	if self._options.FadeEffects then
		Animator.Play(self._body, { GroupTransparency = 0 }, options)
	end
	Animator.Play(self._borderStroke, { Transparency = scope:Get("BorderTransparency") }, options)
	Animator.Play(self._animScale, { Scale = 1 }, options)
	self._setShadow(1, true)
	if self._dim then
		self._dim.Visible = true
		local value = self._options.Dim
		local transparency = if type(value) == "number" then value else scope:Get("OverlayTransparency")
		Animator.Play(self._dim, { BackgroundTransparency = transparency }, options)
	end
	if self._blur then
		self._blur.Enabled = true
		local size = if type(self._options.Blur) == "number" then self._options.Blur else 14
		Animator.Play(self._blur, { Size = size }, options)
	end
	self.Opened:Fire()
end

function Window.Close(self: any)
	if self._destroyed or not self._open:Get() then
		return
	end
	self._open:Set(false)
	self._popups:CloseAll()
	self._dialogs:CloseAll()
	self._tooltips:Hide()
	self._input:EndDrag()
	local scope = self._scope
	local options = { Scope = scope, DurationScale = 1.2 }
	if self._options.FadeEffects then
		Animator.Play(self._body, { GroupTransparency = 1 }, options)
	end
	Animator.Play(self._borderStroke, { Transparency = 1 }, options)
	self._setShadow(0, true)
	if self._dim then
		Animator.Play(self._dim, { BackgroundTransparency = 1 }, {
			Scope = scope,
			DurationScale = 1.2,
			OnComplete = function()
				if not self._open:Get() and self._dim then
					self._dim.Visible = false
				end
			end,
		})
	end
	if self._blur then
		Animator.Play(self._blur, { Size = 0 }, {
			Scope = scope,
			DurationScale = 1.2,
			OnComplete = function()
				if not self._open:Get() and self._blur then
					self._blur.Enabled = false
				end
			end,
		})
	end
	Animator.Play(self._animScale, { Scale = 0.96 }, {
		Scope = scope,
		DurationScale = 1.2,
		OnComplete = function()
			if not self._open:Get() then
				self._root.Visible = false
			end
		end,
	})
	self.Closed:Fire()
end

function Window.Toggle(self: any)
	if self._open:Get() then
		self:Close()
	else
		self:Open()
	end
end

function Window.IsOpen(self: any): boolean
	return self._open:Get()
end

function Window.SetMinimized(self: any, minimized: boolean)
	if self._destroyed or self._minimized:Get() == minimized then
		return
	end
	self._minimized:Set(minimized)
	self._popups:CloseAll()
	self._dialogs:CloseAll()
	self._tooltips:Hide()
	self._grip.Visible = self._options.Resizable and not minimized
	self:_ApplySize(self._desiredSize, true)
end

function Window.Minimize(self: any)
	self:SetMinimized(true)
end

function Window.Restore(self: any)
	self:SetMinimized(false)
end

function Window.IsMinimized(self: any): boolean
	return self._minimized:Get()
end

--------------------------------------------------------------------------------
-- Appearance
--------------------------------------------------------------------------------

function Window.SetTitle(self: any, title: string)
	self.Title = title
	self._titleLabel.Text = title
end

function Window.SetSubtitle(self: any, subtitle: string?)
	self.Subtitle = subtitle
	self._subtitleLabel.Text = subtitle or ""
	self._subtitleLabel.Visible = subtitle ~= nil and subtitle ~= ""
end

-- Sets the window size (UDim2 or Vector2). The size is clamped to MinSize/MaxSize.
function Window.SetSize(self: any, size: UDim2 | Vector2)
	if typeof(size) ~= "UDim2" and typeof(size) ~= "Vector2" then
		Log.warn("Window:SetSize expects a UDim2 or Vector2, got %s", typeof(size))
		return
	end
	self._desiredSize = toVector2(size, self:_Viewport())
	self:_ApplySize(self._desiredSize, true)
	self:_ClampPosition()
end

function Window.GetSize(self: any): Vector2
	return self._size
end

function Window.SetPosition(self: any, position: UDim2, anchorPoint: Vector2?)
	self._root.AnchorPoint = anchorPoint or Vector2.zero
	self._root.Position = position
	self:_ClampPosition()
end

function Window.Center(self: any)
	self._root.AnchorPoint = Vector2.new(0.5, 0.5)
	self._root.Position = UDim2.fromScale(0.5, 0.5)
end

-- Multiplies the automatic scale (1 = default).
function Window.SetScale(self: any, scale: number)
	if type(scale) ~= "number" or scale <= 0 then
		Log.warn("Window:SetScale expects a positive number")
		return
	end
	self._userScale = scale
	self:_Layout()
end

function Window.GetScale(self: any): number
	return self._scale
end

function Window.SetTheme(self: any, overrides: { [string]: any } | string)
	if type(overrides) == "string" then
		local preset = self._library:_GetPreset(overrides)
		if preset == nil then
			Log.warn('Window:SetTheme: unknown preset "%s"', overrides)
			return
		end
		self._scope:Set(preset, true)
	else
		self._scope:Set(overrides)
	end
end

--[[
	Adds a button to the top bar. Icon is a built-in icon name ("Search",
	"Plus", "Menu"...) or an image asset id. Returns a handle with Destroy().
]]
function Window.AddTopBarButton(self: any, options: { Icon: string?, Tooltip: string?, Callback: (() -> ())? })
	if type(options) ~= "table" then
		Log.warn("AddTopBarButton expects a table")
		return nil
	end
	self._customButtons += 1
	local callback = options.Callback
	local tooltip = options.Tooltip
	local button, maid = self:_CreateControlButton(
		options.Icon or "Dot",
		if tooltip
			then function()
				return tooltip
			end
			else nil,
		function()
			Util.SafeCall(callback, "top bar button")
		end,
		self._customButtons
	)
	return {
		Instance = button,
		Destroy = function()
			self._maid:Remove(maid)
			maid:Destroy()
		end,
	}
end

--------------------------------------------------------------------------------
-- Dialogs & notifications
--------------------------------------------------------------------------------

--[[
	Shows a modal dialog over this window.

	Window:Dialog({
	    Title = "Reset settings?",
	    Description = "This cannot be undone.",
	    Buttons = {
	        { Name = "Cancel" },
	        { Name = "Reset", Variant = "Danger", Callback = reset },
	    },
	})
]]
function Window.Dialog(self: any, options: any)
	if type(options) ~= "table" then
		Log.warn("Window:Dialog expects a table")
		return nil
	end
	if not self._open:Get() then
		self:Open()
	end
	return self._dialogs:Show(options)
end

-- Confirmation dialog: callback(true) when confirmed, callback(false) otherwise.
function Window.Confirm(self: any, options: any, callback: (boolean) -> ())
	if not self._open:Get() then
		self:Open()
	end
	return self._dialogs:Confirm(options or {}, callback)
end

function Window.Notify(self: any, ...: any)
	return self._library:Notify(...)
end

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

function Window.Destroy(self: any)
	if self._destroyed then
		return
	end
	self.Destroying:Fire()
	self._destroyed = true
	for _, tab: any in table.clone(self.Tabs) do
		tab:Destroy()
	end
	self._popups:Destroy()
	self._dialogs:Destroy()
	self._tooltips:Destroy()
	self._input:EndDrag()
	self._maid:Destroy()
	self._scope:Destroy()
	self._open:Destroy()
	self._minimized:Destroy()
	self.Opened:Destroy()
	self.Closed:Destroy()
	self.TabChanged:Destroy()
	self.Destroying:Destroy()
	self._library:_OnWindowDestroyed(self)
	Util.Retire(self)
end

function Window.IsDestroyed(self: any): boolean
	return self._destroyed
end

return Window
