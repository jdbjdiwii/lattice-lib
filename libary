-- Log -------------------------------------------------------------------------
definitions["Log"] = function(...)
--[[
	Log

	Centralised diagnostics. Every warning the library prints goes through here so
	messages share one prefix and identical messages are rate-limited: a callback
	that errors every frame produces one warning, not thousands.
]]

local Log = {}

Log.Prefix = "[Lattice]"

-- When true, callback errors include a full traceback instead of the first line.
Log.Verbose = false

local COOLDOWN_SECONDS = 8
local MAX_TRACKED = 256

local lastEmitted: { [string]: number } = {}
local trackedCount = 0

local function shouldEmit(key: string): boolean
	local now = os.clock()
	local last = lastEmitted[key]
	if last ~= nil and now - last < COOLDOWN_SECONDS then
		return false
	end
	if last == nil then
		trackedCount += 1
		if trackedCount > MAX_TRACKED then
			table.clear(lastEmitted)
			trackedCount = 1
		end
	end
	lastEmitted[key] = now
	return true
end

local function format(message: string, ...: any): string
	if select("#", ...) == 0 then
		return message
	end
	local ok, result = pcall(string.format, message, ...)
	return if ok then result else message
end

--[[
	Prints a de-duplicated warning. Use for recoverable misuse: the library
	continues with a sensible fallback after warning.
]]
function Log.warn(message: string, ...: any)
	local text = format(message, ...)
	if shouldEmit(text) then
		warn(Log.Prefix .. " " .. text)
	end
end

--[[
	Raises an error with the library prefix. Use only for misuse that cannot be
	recovered from (for example, creating a window with no place to parent it).
]]
function Log.error(message: string, ...: any): never
	error(Log.Prefix .. " " .. format(message, ...), 3)
end

--[[
	Reports an error raised inside user code (callbacks, signal handlers).
	The first line is printed by default; enable Log.Verbose for tracebacks.
]]
function Log.handlerError(err: any, source: string?)
	local text = tostring(err)
	local firstLine = string.match(text, "^[^\n]*") or text
	local where = source or "a handler"
	if shouldEmit(where .. "\0" .. firstLine) then
		warn(string.format("%s Error in %s: %s", Log.Prefix, where, if Log.Verbose then text else firstLine))
	end
end

-- Clears the de-duplication memory (used by tests).
function Log.reset()
	table.clear(lastEmitted)
	trackedCount = 0
end

return Log
end

-- Maid ------------------------------------------------------------------------
definitions["Maid"] = function(...)
--[[
	Maid

	Owns resources and releases them deterministically. Every window, tab,
	section and component has one, which is how the library guarantees that
	destroying a parent leaves no orphaned instances or connections behind.

	Accepted items:
	  RBXScriptConnection      -> :Disconnect()
	  Instance                 -> :Destroy()
	  function                 -> called
	  thread                   -> task.cancel (unless it is the running thread)
	  table with Destroy       -> :Destroy()
	  table with Disconnect    -> :Disconnect()
]]

local Maid = {}
Maid.__index = Maid

type Maid = typeof(setmetatable(
	{} :: {
		_items: { any },
		_keyed: { [any]: any },
		_cleaning: boolean,
	},
	Maid
))

function Maid.new(): Maid
	return setmetatable({
		_items = {},
		_keyed = {},
		_cleaning = false,
	}, Maid)
end

local function release(item: any)
	local kind = typeof(item)
	if kind == "RBXScriptConnection" then
		item:Disconnect()
	elseif kind == "Instance" then
		item:Destroy()
	elseif kind == "function" then
		item()
	elseif kind == "thread" then
		if coroutine.status(item) ~= "running" then
			pcall(task.cancel, item)
		end
	elseif kind == "table" then
		if type(item.Destroy) == "function" then
			item:Destroy()
		elseif type(item.Disconnect) == "function" then
			item:Disconnect()
		end
	end
end

-- Adds an item and returns it, so creation and ownership can be one expression.
function Maid.Add<T>(self: Maid, item: T): T
	table.insert(self._items, item)
	return item
end

-- Stores an item under a key, releasing whatever previously occupied the key.
function Maid.Set(self: Maid, key: any, item: any?)
	local previous = self._keyed[key]
	if previous == item then
		return
	end
	self._keyed[key] = item
	if previous ~= nil then
		release(previous)
	end
end

function Maid.Get(self: Maid, key: any): any?
	return self._keyed[key]
end

-- Releases the item stored under a key (if any).
function Maid.Clear(self: Maid, key: any)
	self:Set(key, nil)
end

-- Stops tracking an item without releasing it.
function Maid.Remove(self: Maid, item: any)
	local index = table.find(self._items, item)
	if index then
		table.remove(self._items, index)
	end
end

-- Releases everything, newest first. Items added during cleanup are released too.
function Maid.Clean(self: Maid)
	if self._cleaning then
		return
	end
	self._cleaning = true
	while next(self._keyed) ~= nil or #self._items > 0 do
		local keyed = self._keyed
		self._keyed = {}
		for _, item in keyed do
			release(item)
		end
		local items = self._items
		self._items = {}
		for index = #items, 1, -1 do
			release(items[index])
		end
	end
	self._cleaning = false
end

Maid.Destroy = Maid.Clean

return Maid
end

-- Notifications ---------------------------------------------------------------
definitions["Notifications"] = function(...)
--[[
	Notifications

	    Lattice:Notify({
	        Title = "Saved",
	        Description = "Your settings were saved.",
	        Type = "Success",       -- "Info" | "Success" | "Warning" | "Error"
	        Duration = 4,           -- seconds; 0 keeps it until dismissed
	        Icon = "rbxassetid://...", -- optional custom icon (or a built-in icon name)
	        Accent = Color3.fromRGB(255, 120, 60), -- optional custom accent
	        Actions = { { Name = "Undo", Callback = undo } },
	    })

	    Lattice:Notify("Short message", 3)      -- shorthand

	    Lattice:ConfigureNotifications({
	        Position = "TopRight",  -- TopRight | TopLeft | BottomRight | BottomLeft | Top | Bottom
	        MaxVisible = 4,         -- extra notifications wait in a queue
	        Width = 320,
	        Animation = "Slide",    -- "Slide" | "Fade"
	    })

	Notifications stack and reflow smoothly: an entering card grows its slot
	while sliding in, and a leaving card slides out before its slot collapses.
	Hovering pauses the countdown. Each notification returns a handle with
	Dismiss(), SetTitle(), SetDescription() and a Dismissed signal.
]]

local Animator = import("Animator")
local Environment = import("Environment")
local Icons = import("Icons")
local Log = import("Log")
local Maid = import("Maid")
local Options = import("Options")
local Signal = import("Signal")
local Theme = import("Theme")
local Util = import("Util")
local Widgets = import("Widgets")

local Notifications = {}
Notifications.__index = Notifications

local TYPES = { Info = "Info", Success = "Success", Warning = "Warning", Error = "Error" }
local TYPE_ICONS = { Info = "Info", Success = "Check", Warning = "Alert", Error = "Close" }
local POSITIONS = {
	TopRight = true,
	TopLeft = true,
	BottomRight = true,
	BottomLeft = true,
	Top = true,
	Bottom = true,
}

local NOTIFY_SCHEMA: Options.Schema = {
	Title = { Type = "string" },
	Description = { Type = "string" },
	Duration = { Type = "number", Default = 4, Validate = Options.Validators.NonNegative },
	Icon = { Type = "string" },
	Type = {
		Type = "string",
		Default = "Info",
		Validate = function(value)
			return TYPES[value] ~= nil, 'must be "Info", "Success", "Warning" or "Error"'
		end,
	},
	Accent = { Type = "Color3|string" },
	Closable = { Type = "boolean", Default = true },
	Callback = { Type = "function" },
	Actions = { Type = "table" },
}

local SETTINGS_SCHEMA: Options.Schema = {
	Position = {
		Type = "string",
		Validate = function(value)
			return POSITIONS[value] == true, "must be TopRight, TopLeft, BottomRight, BottomLeft, Top or Bottom"
		end,
	},
	MaxVisible = { Type = "number", Validate = Options.Validators.Positive },
	Width = { Type = "number", Validate = Options.Validators.Positive },
	Spacing = { Type = "number", Validate = Options.Validators.NonNegative },
	Margin = { Type = "number", Validate = Options.Validators.NonNegative },
	Animation = {
		Type = "string",
		Validate = function(value)
			return value == "Slide" or value == "Fade", 'must be "Slide" or "Fade"'
		end,
	},
	PauseOnHover = { Type = "boolean" },
	DisplayOrder = { Type = "number" },
	Parent = { Type = "Instance" },
}

local DEFAULT_SETTINGS = {
	Position = "BottomRight",
	MaxVisible = 5,
	Width = 300,
	Spacing = 8,
	Margin = 16,
	Animation = "Slide",
	PauseOnHover = true,
	DisplayOrder = 1000,
}

function Notifications.new(library: any)
	return setmetatable({
		_library = library,
		_scope = library._theme:Extend(),
		_settings = table.clone(DEFAULT_SETTINGS),
		_active = {} :: { any },
		_queue = {} :: { any },
		_counter = 0,
		_maid = Maid.new(),
		_gui = nil :: ScreenGui?,
		_holder = nil :: Frame?,
	}, Notifications)
end

--------------------------------------------------------------------------------
-- Container
--------------------------------------------------------------------------------

function Notifications._EnsureGui(self: any): boolean
	if self._gui then
		return true
	end
	local parent = self._settings.Parent or Environment.GuiParent()
	if parent == nil then
		Log.warn("Notify: there is no player to show notifications to; set a Parent with ConfigureNotifications")
		return false
	end
	local gui = Util.Create("ScreenGui", {
		Name = "LatticeNotifications",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = self._settings.DisplayOrder,
	})
	self._maid:Add(gui)
	local holder = Util.Create("Frame", {
		Name = "Stack",
		BackgroundTransparency = 1,
		Parent = gui,
	})
	self._scale = Util.Create("UIScale", { Parent = holder })
	self._layout = Util.List(holder)
	self._gui = gui
	self._holder = holder
	self._maid:Add(gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_Layout()
	end))
	gui.Parent = parent
	self:_Layout()
	return true
end

function Notifications._Layout(self: any)
	local holder = self._holder
	if holder == nil then
		return
	end
	local settings = self._settings
	local viewport = (self._gui :: ScreenGui).AbsoluteSize
	if viewport.X <= 0 then
		viewport = Vector2.new(1920, 1080)
	end
	local scale = math.clamp(viewport.Y / 1080, 1, 2)
	local margin = settings.Margin
	local width = math.min(settings.Width, (viewport.X - margin * 2) / scale)
	scale = math.min(scale, (viewport.X - margin * 2) / math.max(width, 1))
	self._scale.Scale = scale
	self._width = width

	local position = settings.Position
	local right = string.find(position, "Right") ~= nil
	local left = string.find(position, "Left") ~= nil
	local top = string.sub(position, 1, 3) == "Top"
	local anchorX = if right then 1 elseif left then 0 else 0.5
	local anchorY = if top then 0 else 1
	holder.AnchorPoint = Vector2.new(anchorX, anchorY)
	holder.Position = UDim2.new(
		anchorX,
		if right then -margin elseif left then margin else 0,
		anchorY,
		if top then margin else -margin
	)
	holder.Size = UDim2.new(0, width, 0, math.max(0, (viewport.Y - margin * 2) / scale))
	local layout: UIListLayout = self._layout
	layout.VerticalAlignment = if top then Enum.VerticalAlignment.Top else Enum.VerticalAlignment.Bottom
	layout.Padding = UDim.new(0, settings.Spacing)
end

-- Updates notification settings. Applies to new and existing notifications.
function Notifications.Configure(self: any, settings: any)
	local resolved = Options.Resolve("ConfigureNotifications", settings, SETTINGS_SCHEMA)
	for key, value in resolved do
		self._settings[key] = value
	end
	if resolved.DisplayOrder and self._gui then
		self._gui.DisplayOrder = resolved.DisplayOrder
	end
	self:_Layout()
	self:_Pump()
end

--------------------------------------------------------------------------------
-- Notify
--------------------------------------------------------------------------------

local Handle = {}
Handle.__index = Handle

function Handle.Dismiss(self: any)
	self._service:_Dismiss(self)
end

function Handle.SetTitle(self: any, title: string)
	self.Title = title
	if self._titleLabel then
		self._titleLabel.Text = title
		self._titleLabel.Visible = title ~= ""
	end
end

function Handle.SetDescription(self: any, description: string)
	self.Description = description
	if self._descriptionLabel then
		self._descriptionLabel.Text = description
		self._descriptionLabel.Visible = description ~= ""
	end
end

function Handle.IsVisible(self: any): boolean
	return self._shown and not self._dismissed
end

--[[
	Shows a notification. Accepts an options table, or (description, duration)
	as a shorthand. Returns a handle.
]]
function Notifications.Notify(self: any, options: any, duration: number?): any
	if type(options) == "string" or type(options) == "number" then
		options = { Description = tostring(options), Duration = duration }
	elseif type(options) ~= "table" then
		Log.warn("Notify expects an options table or a message string, got %s", typeof(options))
		options = {}
	end
	local resolved = Options.Resolve(
		"Notify",
		options,
		NOTIFY_SCHEMA,
		{ Content = "Description", Text = "Description", Kind = "Type" }
	)
	if
		(resolved.Title == nil or resolved.Title == "") and (resolved.Description == nil or resolved.Description == "")
	then
		Log.warn("Notify: provide a Title or a Description")
	end
	self._counter += 1
	local handle = setmetatable({
		Title = resolved.Title or "",
		Description = resolved.Description or "",
		Dismissed = Signal.new("Notification.Dismissed"),
		_service = self,
		_options = resolved,
		_order = self._counter,
		_shown = false,
		_dismissed = false,
	}, Handle)

	if #self._active < self._settings.MaxVisible then
		self:_Show(handle)
	else
		table.insert(self._queue, handle)
	end
	return handle
end

function Notifications._Pump(self: any)
	while #self._queue > 0 and #self._active < self._settings.MaxVisible do
		local nextHandle = table.remove(self._queue, 1)
		if not nextHandle._dismissed then
			self:_Show(nextHandle)
		end
	end
end

function Notifications._Show(self: any, handle: any)
	if not self:_EnsureGui() then
		return
	end
	local options = handle._options
	local settings = self._settings
	local scope: Theme.Scope = self._scope:Extend()
	local maid = Maid.new()
	handle._maid = maid
	handle._scope = scope
	handle._shown = true
	table.insert(self._active, handle)
	maid:Add(function()
		scope:Destroy()
	end)

	local top = string.sub(settings.Position, 1, 3) == "Top"
	local container = Util.Create("Frame", {
		Name = "Notification",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = if top then -handle._order else handle._order,
	})
	maid:Add(container)
	handle._container = container

	local holder = Util.Create("Frame", {
		Name = "Holder",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = container,
	})
	handle._holder = holder
	local _, setShadow = Widgets.Shadow(scope, holder, "WindowCornerRadius", 1)
	setShadow(0)
	handle._setShadow = setShadow

	local card = Util.Create("CanvasGroup", {
		Name = "Card",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		GroupTransparency = 1,
		ZIndex = 2,
		Parent = holder,
	})
	scope:Bind(card, "BackgroundColor3", "NotificationBackground")
	scope:Bind(card, "BackgroundTransparency", "SecondaryTransparency")
	Widgets.Corner(scope, card, "WindowCornerRadius")
	Util.Padding(card, 12, 12, 14, 14)
	handle._card = card

	local border = Util.Create("Frame", {
		Name = "Border",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
		Parent = holder,
	})
	Widgets.Corner(scope, border, "WindowCornerRadius")
	local borderStroke = Util.Create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Transparency = 1,
		Parent = border,
	})
	scope:Bind(borderStroke, "Color", "Border")
	scope:Bind(borderStroke, "Thickness", "StrokeThickness")
	handle._borderStroke = borderStroke

	local accent: Color3
	local customAccent = options.Accent and Util.ToColor3(options.Accent)
	if customAccent then
		accent = customAccent
	else
		accent = scope:Get(TYPES[options.Type])
	end

	local row = Util.Create("Frame", {
		Name = "Row",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 2,
		Parent = card,
	})
	Util.List(row, {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Top,
		Padding = UDim.new(0, 10),
	})

	local iconSource = options.Icon or TYPE_ICONS[options.Type]
	local badge = Util.Create("Frame", {
		Name = "Badge",
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = accent,
		BackgroundTransparency = 0.82,
		LayoutOrder = 1,
		ZIndex = 2,
		Parent = row,
	})
	Util.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = badge })
	local icon, recolor = Icons.Visual(iconSource, {
		Size = 14,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 2,
		Parent = badge,
	})
	icon.ZIndex = 2
	recolor(accent)

	local text = Util.Create("Frame", {
		Name = "Text",
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		ZIndex = 2,
		Parent = row,
	})
	Util.Fill(text)
	Util.List(text, { Padding = UDim.new(0, 3) })
	handle._titleLabel = Widgets.Label(scope, {
		Text = handle.Title,
		Weight = Enum.FontWeight.SemiBold,
		Wrapped = true,
		Properties = {
			Name = "Title",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Visible = handle.Title ~= "",
			LayoutOrder = 1,
			ZIndex = 2,
			Parent = text,
		},
	})
	handle._descriptionLabel = Widgets.Label(scope, {
		Text = handle.Description,
		Style = "Small",
		Color = "MutedText",
		Wrapped = true,
		Properties = {
			Name = "Description",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Visible = handle.Description ~= "",
			LayoutOrder = 2,
			ZIndex = 2,
			Parent = text,
		},
	})

	local actions = options.Actions
	if type(actions) == "table" and #actions > 0 then
		local actionRow = Util.Create("Frame", {
			Name = "Actions",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 3,
			ZIndex = 2,
			Parent = text,
		})
		Util.Create("UIPadding", { PaddingTop = UDim.new(0, 6), Parent = actionRow })
		Util.List(actionRow, { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) })
		for index, action in actions do
			if type(action) ~= "table" or type(action.Name) ~= "string" then
				Log.warn("Notify: each action needs a Name")
				continue
			end
			local widget = Widgets.Button(scope, {
				Text = action.Name,
				Variant = action.Variant or (if index == 1 then "Primary" else "Default"),
				AutoWidth = true,
				LayoutOrder = index,
				Parent = actionRow,
			})
			maid:Add(widget)
			maid:Add(widget.Activated:Connect(function()
				Util.SafeCall(action.Callback, string.format('notification action "%s"', action.Name))
				self:_Dismiss(handle)
			end))
		end
	end

	if options.Closable then
		local close = Util.Create("TextButton", {
			Name = "Close",
			Size = UDim2.fromOffset(18, 18),
			LayoutOrder = 3,
			ZIndex = 2,
			Parent = row,
		})
		local closeIcon = Icons.Create("Close", {
			Size = 14,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			ZIndex = 2,
			Parent = close,
		})
		local hovered = false
		local function render()
			local t = scope:View()
			closeIcon:SetColor(if hovered then t.Text else t.MutedText)
		end
		maid:Add(scope:Observe(render))
		maid:Add(close.MouseEnter:Connect(function()
			hovered = true
			render()
		end))
		maid:Add(close.MouseLeave:Connect(function()
			hovered = false
			render()
		end))
		maid:Add(close.Activated:Connect(function()
			self:_Dismiss(handle)
		end))
	end

	-- Clicking the card runs the optional callback.
	if options.Callback then
		local hit = Util.Create("TextButton", {
			Name = "Hit",
			Size = UDim2.fromScale(1, 1),
			ZIndex = 1,
			Parent = holder,
		})
		maid:Add(hit.Activated:Connect(function()
			Util.SafeCall(options.Callback, "notification callback")
			self:_Dismiss(handle)
		end))
	end

	-- Countdown bar.
	local persistent = options.Duration <= 0 or options.Duration == math.huge
	if not persistent then
		local inset = scope:Get("WindowCornerRadius")
		local track = Util.Create("Frame", {
			Name = "Progress",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, inset, 1, -1),
			Size = UDim2.new(1, -inset * 2, 0, 2),
			BackgroundTransparency = 1,
			ZIndex = 4,
			Parent = holder,
		})
		local bar = Util.Create("Frame", {
			Name = "Bar",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = accent,
			BackgroundTransparency = 0.2,
			ZIndex = 4,
			Parent = track,
		})
		Util.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bar })
		handle._bar = bar
	end

	if settings.PauseOnHover and not persistent then
		maid:Add(holder.MouseEnter:Connect(function()
			if handle._timer and handle._timer.PlaybackState == Enum.PlaybackState.Playing then
				handle._timer:Pause()
			end
		end))
		maid:Add(holder.MouseLeave:Connect(function()
			if handle._timer and handle._timer.PlaybackState == Enum.PlaybackState.Paused then
				handle._timer:Play()
			end
		end))
	end

	container.Parent = self._holder
	self:_Enter(handle, persistent)
end

function Notifications._Enter(self: any, handle: any, persistent: boolean)
	local settings = self._settings
	local scope = handle._scope
	local holder: Frame = handle._holder
	local container: Frame = handle._container
	local slide = settings.Animation == "Slide"
	local position = settings.Position
	local horizontal = position ~= "Top" and position ~= "Bottom"
	local direction = if string.find(position, "Left") then -1 else 1

	if slide and horizontal then
		holder.Position = UDim2.fromOffset(direction * (self._width + settings.Margin), 0)
	else
		holder.Position = UDim2.fromOffset(0, if string.sub(position, 1, 3) == "Top" then -8 else 8)
	end

	local function startTimer()
		if persistent or handle._dismissed or handle._bar == nil then
			return
		end
		handle._timer = Animator.Timer(
			handle._bar,
			{ Size = UDim2.fromScale(0, 1) },
			handle._options.Duration,
			function()
				self:_Dismiss(handle)
			end
		)
	end

	-- Let the layout settle, then grow the slot while the card comes in.
	task.defer(function()
		if handle._dismissed or self._destroyed then
			return
		end
		local scale = math.max(self._scale.Scale, 0.01)
		local height = holder.AbsoluteSize.Y / scale
		local options = { Scope = scope, DurationScale = 1.6 }
		local function settle()
			if not handle._dismissed then
				container.AutomaticSize = Enum.AutomaticSize.Y
				container.Size = UDim2.new(1, 0, 0, 0)
			end
		end
		if height > 0 then
			Animator.Play(container, { Size = UDim2.new(1, 0, 0, height) }, {
				Scope = scope,
				DurationScale = 1.6,
				OnComplete = settle,
			})
		else
			settle()
		end
		Animator.Play(holder, { Position = UDim2.new() }, options)
		Animator.Play(handle._card, { GroupTransparency = 0 }, options)
		Animator.Play(handle._borderStroke, { Transparency = scope:Get("BorderTransparency") }, options)
		handle._setShadow(1, true)
		startTimer()
	end)
end

function Notifications._Dismiss(self: any, handle: any)
	if handle._dismissed then
		return
	end
	handle._dismissed = true
	if not handle._shown then
		local index = table.find(self._queue, handle)
		if index then
			table.remove(self._queue, index)
		end
		handle.Dismissed:Fire()
		handle.Dismissed:Destroy()
		return
	end
	if handle._timer then
		handle._timer:Cancel()
		handle._timer = nil
	end
	local settings = self._settings
	local scope = handle._scope
	local holder: Frame = handle._holder
	local container: Frame = handle._container
	local position = settings.Position
	local horizontal = position ~= "Top" and position ~= "Bottom"
	local direction = if string.find(position, "Left") then -1 else 1
	local target = if settings.Animation == "Slide" and horizontal
		then UDim2.fromOffset(direction * (self._width + settings.Margin), 0)
		else UDim2.fromOffset(0, if string.sub(position, 1, 3) == "Top" then -8 else 8)

	local function remove()
		if self._destroyed then
			return
		end
		local index = table.find(self._active, handle)
		if index then
			table.remove(self._active, index)
		end
		handle._maid:Destroy()
		handle.Dismissed:Fire()
		handle.Dismissed:Destroy()
		self:_Pump()
	end

	local function collapse()
		if self._destroyed then
			return
		end
		local scale = math.max(self._scale.Scale, 0.01)
		container.AutomaticSize = Enum.AutomaticSize.None
		container.Size = UDim2.new(1, 0, 0, container.AbsoluteSize.Y / scale)
		Animator.Play(container, { Size = UDim2.new(1, 0, 0, 0) }, {
			Scope = scope,
			DurationScale = 1.2,
			OnComplete = remove,
		})
	end

	handle._setShadow(0, true)
	Animator.Play(handle._borderStroke, { Transparency = 1 }, { Scope = scope })
	Animator.Play(handle._card, { GroupTransparency = 1 }, { Scope = scope })
	Animator.Play(holder, { Position = target }, { Scope = scope, DurationScale = 1.3, OnComplete = collapse })
end

function Notifications.DismissAll(self: any)
	for _, handle in table.clone(self._queue) do
		self:_Dismiss(handle)
	end
	for _, handle in table.clone(self._active) do
		self:_Dismiss(handle)
	end
end

function Notifications.Destroy(self: any)
	self._destroyed = true
	for _, handle in self._active do
		if handle._timer then
			handle._timer:Cancel()
		end
		handle._dismissed = true
		handle._maid:Destroy()
		handle.Dismissed:Destroy()
	end
	for _, handle in self._queue do
		handle._dismissed = true
		handle.Dismissed:Destroy()
	end
	table.clear(self._active)
	table.clear(self._queue)
	self._maid:Destroy()
	self._scope:Destroy()
	self._gui = nil
	self._holder = nil
end

return Notifications
end

-- Options ---------------------------------------------------------------------
definitions["Options"] = function(...)
--[[
	Options

	Declarative option validation. Each public constructor describes its options
	as a schema; Resolve() fills in defaults and reports mistakes without
	throwing, so a typo never takes the whole UI down:

	  [Lattice] AddToggle: unknown option "Defualt" (did you mean "Default"?)
	  [Lattice] AddSlider: option "Max" expects number, got string; using the default
]]

local Log = import("Log")

local Options = {}

type Field = {
	-- typeof() names separated by "|", e.g. "string", "boolean|string|table", "any".
	Type: string?,
	Default: any?,
	-- Extra check after the type check. Return false plus a short reason to reject.
	Validate: ((value: any) -> (boolean, string?))?,
}

type Schema = { [string]: Field }

local function typeMatches(value: any, expected: string): boolean
	if expected == "any" then
		return true
	end
	local actual = typeof(value)
	for option in string.gmatch(expected, "[^|]+") do
		if option == actual then
			return true
		end
	end
	return false
end

-- Edit distance (case-insensitive, adjacent transpositions count once), used
-- for "did you mean" suggestions.
local function distance(a: string, b: string): number
	a, b = string.lower(a), string.lower(b)
	local lengthA, lengthB = #a, #b
	if lengthA == 0 then
		return lengthB
	end
	if lengthB == 0 then
		return lengthA
	end
	local rows: { { number } } = {}
	for i = 0, lengthA do
		local row = table.create(lengthB + 1, 0)
		row[1] = i
		rows[i + 1] = row
	end
	for j = 0, lengthB do
		rows[1][j + 1] = j
	end
	for i = 1, lengthA do
		local charA = string.byte(a, i)
		for j = 1, lengthB do
			local charB = string.byte(b, j)
			local cost = if charA == charB then 0 else 1
			local best = math.min(rows[i][j + 1] + 1, rows[i + 1][j] + 1, rows[i][j] + cost)
			if i > 1 and j > 1 and charA == string.byte(b, j - 1) and string.byte(a, i - 1) == charB then
				best = math.min(best, rows[i - 1][j - 1] + 1)
			end
			rows[i + 1][j + 1] = best
		end
	end
	return rows[lengthA + 1][lengthB + 1]
end

-- Returns the candidate key closest to `name`, if it is plausibly a typo.
function Options.Suggest(name: string, candidates: { [string]: any }): string?
	local best, bestDistance = nil, math.huge
	for candidate in candidates do
		local d = distance(name, candidate)
		if d < bestDistance or (d == bestDistance and best ~= nil and candidate < best) then
			best, bestDistance = candidate, d
		end
	end
	if best == nil then
		return nil
	end
	-- Close enough to be a typo: a couple of edits, or mostly the same letters.
	if bestDistance <= 2 or bestDistance / math.max(#name, #best) <= 0.6 then
		return best
	end
	return nil
end

local function describeType(expected: string): string
	return (string.gsub(expected, "|", " or "))
end

--[[
	Validates `input` against `schema` and returns a new table with defaults
	applied. `aliases` maps alternative option names to schema names, e.g.
	{ Text = "Name" } so both spellings work.
]]
function Options.Resolve(owner: string, input: any, schema: Schema, aliases: { [string]: string }?): { [string]: any }
	local resolved: { [string]: any } = {}
	if input ~= nil and type(input) ~= "table" then
		Log.warn("%s: options must be a table, got %s", owner, typeof(input))
		input = nil
	end
	if input then
		for key, value in input :: { [any]: any } do
			if type(key) ~= "string" then
				Log.warn("%s: ignoring non-string option key %s", owner, tostring(key))
				continue
			end
			local name = if aliases and aliases[key] then aliases[key] else key
			local field = schema[name]
			if field == nil then
				local suggestion = Options.Suggest(key, schema)
				if suggestion then
					Log.warn('%s: unknown option "%s" (did you mean "%s"?)', owner, key, suggestion)
				else
					Log.warn('%s: unknown option "%s"', owner, key)
				end
			elseif field.Type and not typeMatches(value, field.Type) then
				Log.warn(
					'%s: option "%s" expects %s, got %s; using the default',
					owner,
					name,
					describeType(field.Type),
					typeof(value)
				)
			elseif field.Validate then
				local ok, reason = field.Validate(value)
				if ok then
					resolved[name] = value
				else
					Log.warn('%s: option "%s" %s; using the default', owner, name, reason or "is invalid")
				end
			else
				resolved[name] = value
			end
		end
	end
	for name, field in schema do
		if resolved[name] == nil and field.Default ~= nil then
			local default = field.Default
			resolved[name] = if type(default) == "table" then table.clone(default) else default
		end
	end
	return resolved
end

-- Merges several schemas into a new one (later schemas win).
function Options.Extend(...: Schema): Schema
	local result: Schema = {}
	for index = 1, select("#", ...) do
		local schema = select(index, ...)
		for key, field in schema do
			result[key] = field
		end
	end
	return result
end

-- Common validators.
Options.Validators = {
	NonNegative = function(value: any): (boolean, string?)
		if value >= 0 then
			return true
		end
		return false, "must not be negative"
	end,
	Positive = function(value: any): (boolean, string?)
		if value > 0 then
			return true
		end
		return false, "must be greater than zero"
	end,
	Unit = function(value: any): (boolean, string?)
		if value >= 0 and value <= 1 then
			return true
		end
		return false, "must be between 0 and 1"
	end,
}

return Options
end

-- Overlay ---------------------------------------------------------------------
definitions["Overlay"] = function(...)
--[[
	Overlay

	On-screen extras that live outside any window:

	    Lattice:SetWatermark("My Script | v1.0")  -- small draggable label
	    Lattice:SetWatermarkVisible(false)
	    Lattice:SetKeybindListVisible(true)       -- live list of bound keys

	The keybind list shows every bound keybind (except ones created with
	ShowInList = false) with its key and state, and updates as keys are
	pressed or rebound. While hidden it does no work. Both panels can be
	dragged anywhere on screen.
]]

local GuiService = game:GetService("GuiService")

local Environment = import("Environment")
local Log = import("Log")
local Maid = import("Maid")
local Theme = import("Theme")
local Util = import("Util")
local Widgets = import("Widgets")

local Overlay = {}
Overlay.__index = Overlay

type Row = {
	Frame: Frame,
	Key: TextLabel,
	Name: TextLabel,
	State: TextLabel,
}

local MARGIN = 12
local LIST_WIDTH = 200

function Overlay.new(library: any)
	return setmetatable({
		_library = library,
		_scope = library._theme:Extend(),
		_maid = Maid.new(),
		_gui = nil :: ScreenGui?,
		_watermark = nil :: Frame?,
		_watermarkLabel = nil :: TextLabel?,
		_watermarkText = "",
		_watermarkVisible = false,
		_list = nil :: Frame?,
		_empty = nil :: TextLabel?,
		_listVisible = false,
		_keybinds = {} :: { any },
		_rows = {} :: { [any]: Row },
	}, Overlay)
end

--------------------------------------------------------------------------------
-- Container
--------------------------------------------------------------------------------

function Overlay._EnsureGui(self: any): ScreenGui?
	if self._gui then
		return self._gui
	end
	local parent = Environment.GuiParent()
	if parent == nil then
		Log.warn("There is no player to show the watermark or keybind list to")
		return nil
	end
	local gui = Util.Create("ScreenGui", {
		Name = "LatticeOverlay",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 900,
	})
	self._maid:Add(gui)
	gui.Parent = parent
	self._gui = gui
	return gui
end

-- A draggable panel that grows on high-resolution screens like windows do.
function Overlay._Panel(
	self: any,
	name: string,
	radiusToken: string,
	position: UDim2,
	size: UDim2,
	automaticSize: Enum.AutomaticSize
): Frame?
	local gui = self:_EnsureGui()
	if gui == nil then
		return nil
	end
	local scope: Theme.Scope = self._scope
	local frame = Widgets.Surface(scope, {
		Background = "Secondary",
		Transparency = "SecondaryTransparency",
		Radius = radiusToken,
		Properties = {
			Name = name,
			Position = position,
			Size = size,
			AutomaticSize = automaticSize,
			Active = true,
			Visible = false,
			Parent = gui,
		},
	})
	local scale = Util.Create("UIScale", { Parent = frame })
	local function rescale()
		local height = gui.AbsoluteSize.Y
		scale.Scale = if height > 0 then math.clamp(height / 1080, 1, 2) else 1
	end
	self._maid:Add(gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(rescale))
	rescale()
	self:_MakeDraggable(frame)
	return frame
end

-- Drag a panel with the mouse or a finger; it stays on screen.
function Overlay._MakeDraggable(self: any, frame: GuiObject)
	self._maid:Add(frame.InputBegan:Connect(function(input: InputObject)
		local inputType = input.UserInputType
		if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then
			return
		end
		local gui = self._gui
		if gui == nil then
			return
		end
		-- Work in pixels from here on.
		local start = frame.AbsolutePosition
		frame.AnchorPoint = Vector2.zero
		frame.Position = UDim2.fromOffset(start.X, start.Y)
		self._library._input:BeginDrag(input, {
			Move = function(_position: Vector2, delta: Vector2)
				local screen = gui.AbsoluteSize
				local size = frame.AbsoluteSize
				local x = math.clamp(start.X + delta.X, 0, math.max(0, screen.X - size.X))
				local y = math.clamp(start.Y + delta.Y, 0, math.max(0, screen.Y - size.Y))
				frame.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
			end,
		})
	end))
end

--------------------------------------------------------------------------------
-- Watermark
--------------------------------------------------------------------------------

function Overlay._BuildWatermark(self: any): boolean
	if self._watermark then
		return true
	end
	local inset = GuiService:GetGuiInset()
	local frame = self:_Panel(
		"Watermark",
		"CornerRadius",
		UDim2.fromOffset(MARGIN, inset.Y + 10),
		UDim2.new(),
		Enum.AutomaticSize.XY
	)
	if frame == nil then
		return false
	end
	local scope: Theme.Scope = self._scope
	Util.Padding(frame, 6, 10, 6, 10)
	Util.List(frame, {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 8),
	})
	local dot = Util.Create("Frame", {
		Name = "Dot",
		Size = UDim2.fromOffset(6, 6),
		LayoutOrder = 1,
		Parent = frame,
	})
	Util.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = dot })
	scope:Bind(dot, "BackgroundColor3", "Accent")
	self._watermarkLabel = Widgets.Label(scope, {
		Text = self._watermarkText,
		Style = "Small",
		Weight = Enum.FontWeight.Medium,
		Properties = {
			Name = "Text",
			Size = UDim2.fromOffset(0, 14),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = 2,
			Parent = frame,
		},
	})
	self._watermark = frame
	return true
end

-- Sets the watermark text and shows it. Pass nil or "" to hide it.
function Overlay.SetWatermark(self: any, text: string?)
	if text ~= nil and type(text) ~= "string" then
		Log.warn("SetWatermark expects a string, got %s", typeof(text))
		return
	end
	self._watermarkText = text or ""
	if self._watermarkLabel then
		self._watermarkLabel.Text = self._watermarkText
	end
	self:SetWatermarkVisible(self._watermarkText ~= "")
end

function Overlay.SetWatermarkVisible(self: any, visible: boolean)
	self._watermarkVisible = visible == true
	if self._watermarkVisible and not self:_BuildWatermark() then
		return
	end
	if self._watermark then
		self._watermark.Visible = self._watermarkVisible
	end
end

function Overlay.IsWatermarkVisible(self: any): boolean
	return self._watermarkVisible
end

--------------------------------------------------------------------------------
-- Keybind list
--------------------------------------------------------------------------------

function Overlay._BuildList(self: any): boolean
	if self._list then
		return true
	end
	local frame = self:_Panel(
		"Keybinds",
		"SectionCornerRadius",
		UDim2.new(0, MARGIN, 0.42, 0),
		UDim2.fromOffset(LIST_WIDTH, 0),
		Enum.AutomaticSize.Y
	)
	if frame == nil then
		return false
	end
	local scope: Theme.Scope = self._scope
	Util.Padding(frame, 8, 10, 10, 10)
	Util.List(frame, { Padding = UDim.new(0, 4) })
	Widgets.Label(scope, {
		Text = "Keybinds",
		Weight = Enum.FontWeight.SemiBold,
		Properties = {
			Name = "Title",
			Size = UDim2.new(1, 0, 0, 18),
			LayoutOrder = -2,
			Parent = frame,
		},
	})
	local divider = Util.Create("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, 0, 0, 1),
		LayoutOrder = -1,
		Parent = frame,
	})
	scope:Bind(divider, "BackgroundColor3", "Divider")
	self._empty = Widgets.Label(scope, {
		Text = "No keys bound",
		Style = "Small",
		Color = "MutedText",
		Properties = {
			Name = "Empty",
			Size = UDim2.new(1, 0, 0, 18),
			LayoutOrder = 0,
			Parent = frame,
		},
	})
	self._list = frame
	self._maid:Add(scope:Observe(function()
		for keybind in self._rows do
			self:_UpdateRow(keybind)
		end
	end))
	return true
end

local function shouldList(keybind: any): boolean
	return not keybind._destroyed
		and keybind.Value ~= nil
		and not keybind.Disabled
		and keybind.Options.ShowInList ~= false
end

local function displayName(keybind: any): string
	local host = keybind._context.Host
	local name = if host and host.Name ~= "" then host.Name else keybind.Name
	return if name ~= "" then name else "Keybind"
end

local function stateText(keybind: any, active: boolean): string
	if keybind.Mode == "Hold" then
		return if active then "Held" else "Hold"
	elseif keybind.Mode == "Press" then
		return "Press"
	end
	return if active then "On" else "Off"
end

function Overlay._CreateRow(self: any, keybind: any, order: number): Row
	local scope: Theme.Scope = self._scope
	local frame = Util.Create("Frame", {
		Name = "Row",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
		LayoutOrder = order,
		Parent = self._list,
	})
	Util.List(frame, {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 8),
	})
	local chip = Widgets.Surface(scope, {
		Background = "Tertiary",
		Stroke = false,
		Properties = {
			Name = "Chip",
			Size = UDim2.fromOffset(0, 18),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = 1,
			Parent = frame,
		},
	})
	Util.Padding(chip, 0, 6, 0, 6)
	Util.Create("UISizeConstraint", { MinSize = Vector2.new(22, 18), Parent = chip })
	local key = Widgets.Label(scope, {
		Style = "Small",
		Weight = Enum.FontWeight.Medium,
		Color = false,
		Properties = {
			Name = "Key",
			Size = UDim2.fromScale(0, 1),
			AutomaticSize = Enum.AutomaticSize.X,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = chip,
		},
	})
	local name = Widgets.Label(scope, {
		Style = "Small",
		Color = false,
		Properties = {
			Name = "Name",
			Size = UDim2.new(0, 0, 1, 0),
			LayoutOrder = 2,
			Parent = frame,
		},
	})
	Util.Fill(name)
	local state = Widgets.Label(scope, {
		Style = "Small",
		Weight = Enum.FontWeight.Medium,
		Color = false,
		Properties = {
			Name = "State",
			Size = UDim2.fromScale(0, 1),
			AutomaticSize = Enum.AutomaticSize.X,
			TextXAlignment = Enum.TextXAlignment.Right,
			LayoutOrder = 3,
			Parent = frame,
		},
	})
	local row: Row = { Frame = frame, Key = key, Name = name, State = state }
	self._rows[keybind] = row
	return row
end

function Overlay._UpdateEmpty(self: any)
	if self._empty == nil then
		return
	end
	local any = false
	for _, row in self._rows do
		if row.Frame.Visible then
			any = true
			break
		end
	end
	self._empty.Visible = not any
end

function Overlay._UpdateRow(self: any, keybind: any)
	if self._list == nil then
		return
	end
	local row = self._rows[keybind]
	if not shouldList(keybind) then
		if row then
			row.Frame.Visible = false
		end
		self:_UpdateEmpty()
		return
	end
	if row == nil then
		row = self:_CreateRow(keybind, table.find(self._keybinds, keybind) or #self._keybinds)
	end
	local t = self._scope:View()
	local active = keybind:GetState()
	row.Key.Text = Util.KeyName(keybind.Value)
	row.Key.TextColor3 = if active then t.Accent else t.Text
	row.Name.Text = displayName(keybind)
	row.Name.TextColor3 = if active then t.Text else t.MutedText
	row.State.Text = stateText(keybind, active)
	row.State.TextColor3 = if active then t.Accent else t.MutedText
	row.Frame.Visible = true
	self:_UpdateEmpty()
end

function Overlay.SetKeybindListVisible(self: any, visible: boolean)
	self._listVisible = visible == true
	if self._listVisible then
		if not self:_BuildList() then
			return
		end
		for _, keybind in self._keybinds do
			self:_UpdateRow(keybind)
		end
		self:_UpdateEmpty()
	end
	if self._list then
		self._list.Visible = self._listVisible
	end
end

function Overlay.IsKeybindListVisible(self: any): boolean
	return self._listVisible
end

-- Keybinds report themselves here when created, changed and destroyed.
function Overlay._Track(self: any, keybind: any)
	table.insert(self._keybinds, keybind)
	if self._listVisible then
		self:_UpdateRow(keybind)
	end
end

function Overlay._Updated(self: any, keybind: any)
	if self._listVisible and table.find(self._keybinds, keybind) then
		self:_UpdateRow(keybind)
	end
end

function Overlay._Untrack(self: any, keybind: any)
	local index = table.find(self._keybinds, keybind)
	if index then
		table.remove(self._keybinds, index)
	end
	local row = self._rows[keybind]
	if row then
		self._rows[keybind] = nil
		row.Frame:Destroy()
		self:_UpdateEmpty()
	end
end

function Overlay.Destroy(self: any)
	self._maid:Destroy()
	self._scope:Destroy()
	table.clear(self._keybinds)
	table.clear(self._rows)
	self._gui = nil
	self._watermark = nil
	self._list = nil
end

return Overlay
end

-- Paragraph -------------------------------------------------------------------
definitions["Paragraph"] = function(...)
--[[
	Paragraph / information box

	    local Info = Section:AddParagraph({
	        Title = "Heads up",
	        Description = "Settings are saved per place.",
	        Kind = "Info",        -- optional: "Info" | "Success" | "Warning" | "Error"
	        RichText = false,
	        Boxed = true,         -- false renders plain text without a box
	    })
	    Info:SetDescription("Updated text")   -- or Info:SetValue("Updated text")
	    Info:SetTitle("New title")

	    Section:AddParagraph("Just a block of text.")   -- shorthand: the body

	The box grows with its text. A paragraph's value is its description text.
]]

local Icons = import("Icons")
local Log = import("Log")
local Theme = import("Theme")
local Util = import("Util")

local Base = import("Base")

local KINDS = { Info = "Info", Success = "Success", Warning = "Warning", Error = "Error" }
local KIND_ICONS = { Info = "Info", Success = "Check", Warning = "Alert", Error = "Close" }

local Paragraph = Base.extend("Paragraph", {
	RichText = { Type = "boolean", Default = false },
	Kind = {
		Type = "string",
		Validate = function(value)
			return KINDS[value] ~= nil, 'must be "Info", "Success", "Warning" or "Error"'
		end,
	},
	Boxed = { Type = "boolean", Default = true },
}, { Body = "Description", Text = "Description", Variant = "Kind", Style = "Kind" })
Paragraph.DefaultName = ""
Paragraph.ShorthandOption = "Description"

function Paragraph.new(context: any, options: any)
	local self: any = setmetatable({}, Paragraph)
	local resolved = self:_Init(context, options)
	self.Kind = resolved.Kind
	self._boxed = resolved.Boxed or resolved.Kind ~= nil
	local scope: Theme.Scope = self._scope

	local root = self:_CreateRoot()
	local box = Util.Create("Frame", {
		Name = "Box",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = root,
	})
	if self._boxed then
		local corner = Util.Create("UICorner", { Parent = box })
		scope:Bind(corner, "CornerRadius", function(t)
			return UDim.new(0, t.CornerRadius)
		end)
		self._stroke = Util.Create("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = box })
		scope:Bind(self._stroke, "Thickness", "StrokeThickness")
		Util.Padding(box, 10, 12, 10, 12)
	end
	Util.List(box, {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Top,
		Padding = UDim.new(0, 10),
	})
	self._box = box

	-- A tinted circular badge holding the kind's glyph.
	self._iconHolder = Util.Create("Frame", {
		Name = "IconHolder",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(20, 20),
		LayoutOrder = 0,
		Visible = false,
		ZIndex = 2,
		Parent = box,
	})
	Util.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = self._iconHolder })

	self:_BuildTextBlock(box, 1, Enum.FontWeight.SemiBold)
	self._nameLabel.Visible = self.Name ~= ""
	local description = self:_EnsureDescription()
	if description then
		description.Visible = (self.Description or "") ~= ""
	end
	self:_SetKindIcon()
	self._maid:Add(scope:Observe(function()
		self:_RenderBox()
	end))
	self:_Mount()
	return self
end

function Paragraph._SetKindIcon(self: any)
	if self._icon then
		self._icon.Frame:Destroy()
		self._icon = nil
	end
	local kind = self.Kind
	self._iconHolder.Visible = kind ~= nil
	if kind then
		self._icon = Icons.Create(KIND_ICONS[kind], {
			Size = 13,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			ZIndex = 2,
			Parent = self._iconHolder,
		})
	end
	self:_RenderBox()
end

function Paragraph._RenderBox(self: any)
	local t = self._scope:View()
	local accent = if self.Kind then t[KINDS[self.Kind]] else nil
	if self._boxed then
		local base = t.Tertiary
		self._box.BackgroundColor3 = if accent then base:Lerp(accent, 0.1) else base
		self._box.BackgroundTransparency = math.max(t.SurfaceTransparency, 0.35)
		self._stroke.Color = if accent then t.Border:Lerp(accent, 0.35) else t.Border
		self._stroke.Transparency = t.BorderTransparency
	end
	if self._icon then
		local color = if self.Disabled then t.DisabledText else accent or t.MutedText
		self._icon:SetColor(color)
		self._iconHolder.BackgroundColor3 = color
		self._iconHolder.BackgroundTransparency = 0.82
	end
end

function Paragraph._OnNameChanged(self: any, name: string)
	self._nameLabel.Visible = name ~= ""
end

function Paragraph.SetTitle(self: any, title: string)
	self:SetName(title or "")
end

function Paragraph.SetKind(self: any, kind: string?)
	if kind ~= nil and KINDS[kind] == nil then
		Log.warn('%s:SetKind: unknown kind "%s"', self:_Describe(), tostring(kind))
		return
	end
	self.Kind = kind
	self:_SetKindIcon()
end

function Paragraph.GetValue(self: any): string
	return self.Description or ""
end

function Paragraph.SetValue(self: any, text: any): boolean
	if type(text) ~= "string" then
		Log.warn("%s:SetValue expects a string", self:_Describe())
		return false
	end
	self:SetDescription(text)
	return true
end

-- Keeps the description label even when the text is empty.
function Paragraph.SetDescription(self: any, description: string?)
	self.Description = description or ""
	local label = self:_EnsureDescription()
	if label then
		label.Text = self.Description
		label.Visible = self.Description ~= ""
	end
end

return Paragraph
end

-- Popups ----------------------------------------------------------------------
definitions["Popups"] = function(...)
--[[
	Popups

	Manages floating panels (dropdown lists, colour pickers, context menus) for
	one window. Popups live in the window's overlay layer so they are never
	clipped by scrolling pages, and they follow their anchor element.

	Policy:
	  * One popup at a time: opening a popup closes the previous one.
	  * A press outside the popup and its anchor closes it; so does Escape.
	  * Popups flip above/below and clamp sideways to stay on screen.
	  * The window closes all popups on tab switch, scroll, drag and hide.
]]

local Workspace = game:GetService("Workspace")

local InputManager = import("InputManager")
local Maid = import("Maid")

local Popups = {}
Popups.__index = Popups

type Placement = "Below" | "Above" | "Right" | "Left"

type PopupSpec = {
	Frame: GuiObject,
	Anchor: GuiObject?,
	Placement: Placement?,
	Gap: number?,
	-- Match the anchor's width.
	MatchWidth: boolean?,
	-- Horizontal alignment for Below/Above placement: "Start" (left edges, the
	-- default) or "End" (right edges).
	Align: ("Start" | "End")?,
	-- Final height in layer units, used for on-screen checks while the popup
	-- is still animating open. Defaults to the frame's current size.
	Height: number?,
	-- Called when the popup closes for any reason. If omitted the frame is hidden.
	OnClose: (() -> ())?,
	-- Identity used by Close/IsOpen (defaults to the frame).
	Owner: any?,
}

type Entry = { Spec: PopupSpec, Maid: any, Owner: any }

local SCREEN_MARGIN = 8

function Popups.new(layer: GuiObject, input: any, getScale: () -> number)
	local self = setmetatable({
		_layer = layer,
		_input = input,
		_getScale = getScale,
		_entries = {} :: { Entry },
		_listeners = Maid.new(),
		_listening = false,
	}, Popups)
	return self
end

type Popups = typeof(Popups.new(...))

local function viewportSize(layer: GuiObject): Vector2
	local gui = layer:FindFirstAncestorWhichIsA("LayerCollector")
	if gui and gui:IsA("GuiBase2d") and gui.AbsoluteSize.X > 0 then
		return gui.AbsoluteSize
	end
	local camera = Workspace.CurrentCamera
	return if camera then camera.ViewportSize else Vector2.new(1920, 1080)
end

function Popups._Place(self: Popups, entry: Entry)
	local spec = entry.Spec
	local anchor = spec.Anchor
	if anchor == nil then
		return
	end
	local frame = spec.Frame
	local scale = math.max(self._getScale(), 0.01)
	local layerPosition = self._layer.AbsolutePosition
	local anchorPosition = (anchor.AbsolutePosition - layerPosition) / scale
	local anchorSize = anchor.AbsoluteSize / scale

	if spec.MatchWidth then
		frame.Size = UDim2.new(0, anchorSize.X, frame.Size.Y.Scale, frame.Size.Y.Offset)
	end

	local width = frame.Size.X.Offset
	local height: number = spec.Height
		or (if frame.Size.Y.Offset > 0 then frame.Size.Y.Offset else frame.AbsoluteSize.Y / scale)
	local gap = spec.Gap or 4
	local placement = spec.Placement or "Below"

	local x, y
	if placement == "Right" then
		x, y = anchorPosition.X + anchorSize.X + gap, anchorPosition.Y
	elseif placement == "Left" then
		x, y = anchorPosition.X - width - gap, anchorPosition.Y
	elseif placement == "Above" then
		x, y = anchorPosition.X, anchorPosition.Y - height - gap
	else
		x, y = anchorPosition.X, anchorPosition.Y + anchorSize.Y + gap
	end
	if (placement == "Below" or placement == "Above") and spec.Align == "End" then
		x = anchorPosition.X + anchorSize.X - width
	end

	local viewport = viewportSize(self._layer)
	local function screenY(localY: number): number
		return layerPosition.Y + localY * scale
	end
	if placement == "Below" and screenY(y + height) > viewport.Y - SCREEN_MARGIN then
		local above = anchorPosition.Y - height - gap
		if screenY(above) >= SCREEN_MARGIN then
			y = above
		end
	elseif placement == "Above" and screenY(y) < SCREEN_MARGIN then
		y = anchorPosition.Y + anchorSize.Y + gap
	elseif placement == "Right" or placement == "Left" then
		local overflow = screenY(y + height) - (viewport.Y - SCREEN_MARGIN)
		if overflow > 0 then
			y -= overflow / scale
		end
	end

	local minX = (SCREEN_MARGIN - layerPosition.X) / scale
	local maxX = (viewport.X - SCREEN_MARGIN - layerPosition.X) / scale - width
	x = math.clamp(x, minX, math.max(minX, maxX))
	local minY = (SCREEN_MARGIN - layerPosition.Y) / scale
	y = math.max(y, minY)

	frame.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
end

function Popups._Listen(self: Popups)
	if self._listening then
		return
	end
	self._listening = true
	self._listeners:Add(self._input:OnPointerDown(function(position: Vector2)
		for index = #self._entries, 1, -1 do
			local entry = self._entries[index]
			if entry == nil then
				continue
			end
			local spec = entry.Spec
			local inside = InputManager.Contains(spec.Frame, position)
				or (spec.Anchor ~= nil and InputManager.Contains(spec.Anchor, position))
			if not inside then
				self:_CloseEntry(entry)
			end
		end
	end))
	self._listeners:Add(self._input:OnKey({
		Began = function(input: InputObject)
			if input.KeyCode == Enum.KeyCode.Escape then
				local top = self._entries[#self._entries]
				if top then
					self:_CloseEntry(top)
				end
			end
		end,
	}))
end

function Popups._StopListening(self: Popups)
	if not self._listening then
		return
	end
	self._listening = false
	self._listeners:Clean()
end

-- Opens a popup (closing any other). Reopening an open popup just repositions it.
function Popups.Open(self: Popups, spec: PopupSpec)
	local owner = spec.Owner or spec.Frame
	for _, entry in self._entries do
		if entry.Owner == owner then
			entry.Spec = spec
			self:_Place(entry)
			return
		end
	end
	self:CloseAll()

	local entry: Entry = { Spec = spec, Maid = Maid.new(), Owner = owner }
	spec.Frame.Parent = self._layer
	spec.Frame.Visible = true

	local anchor = spec.Anchor
	if anchor then
		local function place()
			self:_Place(entry)
		end
		entry.Maid:Add(anchor:GetPropertyChangedSignal("AbsolutePosition"):Connect(place))
		entry.Maid:Add(anchor:GetPropertyChangedSignal("AbsoluteSize"):Connect(place))
		entry.Maid:Add(anchor.AncestryChanged:Connect(function(_, parent)
			if parent == nil then
				self:_CloseEntry(entry)
			end
		end))
	end

	table.insert(self._entries, entry)
	self:_Place(entry)
	self:_Listen()
end

-- Re-runs placement for an open popup (call after its size changes).
function Popups.Reposition(self: Popups, owner: any)
	for _, entry in self._entries do
		if entry.Owner == owner then
			self:_Place(entry)
		end
	end
end

function Popups._CloseEntry(self: Popups, entry: Entry)
	local index = table.find(self._entries, entry)
	if index == nil then
		return
	end
	table.remove(self._entries, index)
	entry.Maid:Clean()
	if #self._entries == 0 then
		self:_StopListening()
	end
	local onClose = entry.Spec.OnClose
	if onClose then
		onClose()
	else
		entry.Spec.Frame.Visible = false
	end
end

function Popups.Close(self: Popups, owner: any)
	for _, entry in table.clone(self._entries) do
		if entry.Owner == owner then
			self:_CloseEntry(entry)
		end
	end
end

function Popups.CloseAll(self: Popups)
	for index = #self._entries, 1, -1 do
		local entry = self._entries[index]
		if entry then
			self:_CloseEntry(entry)
		end
	end
end

function Popups.IsOpen(self: Popups, owner: any): boolean
	for _, entry in self._entries do
		if entry.Owner == owner then
			return true
		end
	end
	return false
end

function Popups.HasOpen(self: Popups): boolean
	return #self._entries > 0
end

function Popups.Destroy(self: Popups)
	self:CloseAll()
	self:_StopListening()
end

return Popups
end

-- Section ---------------------------------------------------------------------
definitions["Section"] = function(...)
--[[
	Section

	A card that groups components. Components are stacked by a UIListLayout and
	the card sizes itself automatically, so components can be added, removed,
	shown or hidden at any time without manual positioning. Sections can be
	collapsible and can be assigned to a column ("Left", "Right" or a number).

	Components are created through Section:Add(kind, options) or the typed
	shortcuts (AddToggle, AddSlider...). Custom component types registered with
	Lattice:RegisterComponent are available as Section:Add<Name>() too.
]]

local Animator = import("Animator")
local Icons = import("Icons")
local InputManager = import("InputManager")
local Log = import("Log")
local Maid = import("Maid")
local Options = import("Options")
local Signal = import("Signal")
local Theme = import("Theme")
local Util = import("Util")
local Widgets = import("Widgets")

local Section = {}

local SCHEMA: Options.Schema = {
	Name = { Type = "string" },
	Description = { Type = "string" },
	Side = { Type = "string|number" },
	Collapsible = { Type = "boolean", Default = false },
	Collapsed = { Type = "boolean", Default = false },
	Visible = { Type = "boolean", Default = true },
	Theme = { Type = "table" },
}

local ALIASES = { Title = "Name", Column = "Side" }

-- Method lookup with a fallback that turns AddFoo into Add("Foo") for
-- registered custom components.
Section.__index = function(self: any, key: any): any
	local method = rawget(Section, key)
	if method ~= nil then
		return method
	end
	if type(key) == "string" and string.sub(key, 1, 3) == "Add" and #key > 3 then
		local kind = string.sub(key, 4)
		local library = rawget(self, "_library")
		if library and library:_GetComponentClass(kind) then
			return function(section: any, options: any, callback: any)
				return section:Add(kind, options, callback)
			end
		end
		-- A typo such as AddTogle: fail with a helpful message instead of
		-- "attempt to call a nil value".
		local suggestion = library and Options.Suggest(kind, library._components)
		error(
			string.format(
				"[Lattice] %s is not a section method%s",
				key,
				if suggestion then string.format(' (did you mean "Add%s"?)', suggestion) else ""
			),
			2
		)
	end
	return nil
end

function Section.new(tab: any, rawOptions: any, index: number)
	local options = Options.Resolve("CreateSection", rawOptions, SCHEMA, ALIASES)
	local window = tab._window
	local scope = tab._scope:Extend()
	if options.Theme then
		scope:Set(options.Theme)
	end

	local self: any = setmetatable({
		Type = "Section",
		Name = options.Name,
		Description = options.Description,
		Visible = options.Visible,
		Collapsible = options.Collapsible,
		Components = {},
		Destroying = Signal.new("Section.Destroying"),
		_tab = tab,
		_window = window,
		_library = window._library,
		_scope = scope,
		_maid = Maid.new(),
		_index = index,
		_order = 0,
		_collapsed = false,
		_destroyed = false,
	}, Section)
	self._home = tab:_AssignHome(options.Side)

	self:_Build()
	if options.Collapsed then
		self:SetCollapsed(true, false)
	end
	return self
end

function Section._Build(self: any)
	local scope: Theme.Scope = self._scope
	local frame, _, _ = Widgets.Surface(scope, {
		Background = "Secondary",
		Transparency = "SecondaryTransparency",
		Radius = "SectionCornerRadius",
		Properties = {
			Name = "Section_" .. (self.Name or tostring(self._index)),
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = self._index,
			Visible = self.Visible,
			ZIndex = 2,
		},
	})
	self._maid:Add(frame)
	self._frame = frame

	local padding = Util.Create("UIPadding", { Parent = frame })
	scope:Bind(padding, "PaddingTop", function(t)
		return UDim.new(0, t.Padding)
	end)
	scope:Bind(padding, "PaddingBottom", function(t)
		return UDim.new(0, t.Padding)
	end)
	scope:Bind(padding, "PaddingLeft", function(t)
		return UDim.new(0, t.Padding)
	end)
	scope:Bind(padding, "PaddingRight", function(t)
		return UDim.new(0, t.Padding)
	end)
	local layout = Util.List(frame)
	scope:Bind(layout, "Padding", function(t)
		return UDim.new(0, t.Spacing + 2)
	end)

	self:_BuildHeader()

	local body = Util.Create("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		ZIndex = 2,
		Parent = frame,
	})
	self._bodyLayout = Util.List(body)
	scope:Bind(self._bodyLayout, "Padding", function(t)
		return UDim.new(0, t.Spacing)
	end)
	self._body = body
end

function Section._BuildHeader(self: any)
	local scope: Theme.Scope = self._scope
	local hasHeader = (self.Name ~= nil and self.Name ~= "")
		or (self.Description ~= nil and self.Description ~= "")
		or self.Collapsible
	if not hasHeader then
		return
	end

	local header = Util.Create(if self.Collapsible then "TextButton" else "Frame", {
		Name = "Header",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		ZIndex = 2,
		Parent = self._frame,
	})
	Util.List(header, {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 8),
	})
	self._header = header

	local textBlock = Util.Create("Frame", {
		Name = "Text",
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		ZIndex = 2,
		Parent = header,
	})
	Util.Fill(textBlock)
	Util.List(textBlock, { Padding = UDim.new(0, 2) })

	self._titleLabel = Widgets.Label(scope, {
		Text = self.Name or "",
		Weight = Enum.FontWeight.SemiBold,
		Wrapped = true,
		Properties = {
			Name = "Title",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Visible = self.Name ~= nil and self.Name ~= "",
			LayoutOrder = 1,
			ZIndex = 2,
			Parent = textBlock,
		},
	})
	self._descriptionLabel = Widgets.Label(scope, {
		Text = self.Description or "",
		Style = "Small",
		Color = "MutedText",
		Wrapped = true,
		Properties = {
			Name = "Description",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Visible = self.Description ~= nil and self.Description ~= "",
			LayoutOrder = 2,
			ZIndex = 2,
			Parent = textBlock,
		},
	})

	if self.Collapsible then
		local chevron = Icons.Create("ChevronDown", { Size = 16, LayoutOrder = 2, ZIndex = 2, Parent = header })
		self._chevron = chevron
		local hovered = false
		local function render()
			local t = scope:View()
			chevron:SetColor(if hovered then t.Text else t.MutedText)
		end
		self._maid:Add(scope:Observe(render))
		self._maid:Add(InputManager.TrackState(header, function(state)
			hovered = state == Enum.GuiState.Hover or state == Enum.GuiState.Press
			render()
		end))
		self._maid:Add(header.Activated:Connect(function()
			self:SetCollapsed(not self._collapsed)
		end))
	end
end

--------------------------------------------------------------------------------
-- Components
--------------------------------------------------------------------------------

function Section._NextOrder(self: any): number
	self._order += 10
	return self._order
end

function Section._Context(self: any): { [string]: any }
	local window = self._window
	local tab = self._tab
	return {
		Library = self._library,
		Window = window,
		Tab = tab,
		Section = self,
		Scope = self._scope,
		Container = self._body,
		Order = self:_NextOrder(),
		Input = window._input,
		Popups = window._popups,
		Tooltips = window._tooltips,
		Dialogs = window._dialogs,
		GetScale = function(): number
			return window:_GetScale()
		end,
		Path = tab.Name .. "/" .. (self.Name or ("Section" .. self._index)),
		Remove = function(component: any)
			self:_RemoveComponent(component)
		end,
	}
end

--[[
	Creates a component of a registered type:

	    Section:Add("Toggle", { Name = "Enabled" })
	    Section:Add("Button", "Run", function() ... end) -- name + callback shorthand
]]
function Section.Add(self: any, kind: string, options: any, callback: any): any
	if self._destroyed then
		Log.warn("Cannot add %s to a destroyed section", tostring(kind))
		return nil
	end
	local Class = self._library:_GetComponentClass(kind)
	if Class == nil then
		Log.warn('Unknown component type "%s"', tostring(kind))
		return nil
	end
	local resolved: any
	if type(options) == "string" and type(callback) == "table" then
		-- AddToggle("MyFlag", { Text = "My toggle", ... }): the string is the flag.
		resolved = table.clone(callback)
		callback = nil
		if resolved.Flag == nil then
			resolved.Flag = options
		end
		if resolved.Name == nil and resolved.Text == nil and resolved.Title == nil then
			resolved.Name = options
		end
	elseif type(options) == "string" then
		-- A bare string is the name, or the class's preferred field (a paragraph's body).
		resolved = { [Class.ShorthandOption or "Name"] = options }
	elseif type(options) == "table" then
		resolved = table.clone(options)
	elseif options == nil then
		resolved = {}
	else
		Log.warn("Add%s: options must be a table or a name string, got %s", kind, typeof(options))
		resolved = {}
	end
	if callback ~= nil and resolved.Callback == nil then
		resolved.Callback = callback
	end
	local component = Class.new(self:_Context(), resolved)
	table.insert(self.Components, component)
	return component
end

function Section.AddButton(self: any, options: any, callback: any): any
	return self:Add("Button", options, callback)
end

function Section.AddToggle(self: any, options: any, callback: any): any
	return self:Add("Toggle", options, callback)
end

function Section.AddSlider(self: any, options: any, callback: any): any
	return self:Add("Slider", options, callback)
end

function Section.AddDropdown(self: any, options: any, callback: any): any
	return self:Add("Dropdown", options, callback)
end

function Section.AddInput(self: any, options: any, callback: any): any
	return self:Add("Input", options, callback)
end

function Section.AddKeybind(self: any, options: any, callback: any): any
	return self:Add("Keybind", options, callback)
end

function Section.AddColorPicker(self: any, options: any, callback: any): any
	return self:Add("ColorPicker", options, callback)
end

function Section.AddLabel(self: any, options: any, callback: any): any
	return self:Add("Label", options, callback)
end

function Section.AddDivider(self: any, options: any): any
	return self:Add("Divider", options)
end

function Section.AddParagraph(self: any, options: any): any
	return self:Add("Paragraph", options)
end

function Section._RemoveComponent(self: any, component: any)
	local index = table.find(self.Components, component)
	if index then
		table.remove(self.Components, index)
	end
end

function Section.GetComponents(self: any): { any }
	return table.clone(self.Components)
end

-- Destroys every component in the section.
function Section.Clear(self: any)
	for _, component: any in table.clone(self.Components) do
		component:Destroy()
	end
end

