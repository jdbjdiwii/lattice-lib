-- Lattice ---------------------------------------------------------------------
definitions["Lattice"] = function(...)
--[[
	Lattice — a themeable UI library for Roblox scripts.

	    local Window = Lattice:CreateWindow({ Title = "My Script" })
	    local Tab = Window:CreateTab({ Name = "Main" })
	    local Section = Tab:CreateSection({ Name = "Settings" })

	    Section:AddToggle({ Name = "Enabled", Callback = print })

	This is the library's entry point. It returns a ready-to-use library
	instance; Lattice.new() creates an independent instance with its own
	theme, flags and configs. Works in executors (UI goes into gethui() or
	CoreGui, configs into files) and in ordinary LocalScripts.

	See README.md for the full reference.
]]

local Environment = import("Environment")
local Icons = import("Icons")
local InputManager = import("InputManager")
local Log = import("Log")
local Options = import("Options")
local Signal = import("Signal")
local Theme = import("Theme")
local Util = import("Util")

local Window = import("Window")
local Notifications = import("Notifications")
local Overlay = import("Overlay")
local Config = import("Config")
local BaseComponent = import("Base")
local ConfigSection = import("ConfigSection")
local ThemeSection = import("ThemeSection")


local VERSION = "1.0.0"

local BUILT_IN_COMPONENTS: { [string]: any } = {
	Button = import("Button"),
	Toggle = import("Toggle"),
	Slider = import("Slider"),
	Dropdown = import("Dropdown"),
	Input = import("Input"),
	Keybind = import("Keybind"),
	ColorPicker = import("ColorPicker"),
	Label = import("Label"),
	Divider = import("Divider"),
	Paragraph = import("Paragraph"),
}

-- Friendly names for the animation tokens, exposed through Lattice.Animation.
local ANIMATION_TOKENS: { [string]: string } = {
	Enabled = "AnimationsEnabled",
	Duration = "AnimationDuration",
	EasingStyle = "EasingStyle",
	EasingDirection = "EasingDirection",
}

local Library = {}
local LibraryMeta = {}

LibraryMeta.__index = function(self: any, key: any): any
	if key == "Animation" then
		return rawget(self, "_animation")
	end
	return Library[key]
end

LibraryMeta.__newindex = function(self: any, key: any, value: any)
	if key == "Animation" then
		self:SetAnimation(value)
		return
	end
	rawset(self, key, value)
end

LibraryMeta.__tostring = function(): string
	return "Lattice " .. VERSION
end

local function createAnimationProxy(library: any): any
	return setmetatable({}, {
		__index = function(_, key)
			local token = ANIMATION_TOKENS[key]
			if token == nil then
				Log.warn('Lattice.Animation has no setting "%s"', tostring(key))
				return nil
			end
			return library._theme:Get(token)
		end,
		__newindex = function(_, key, value)
			library:SetAnimation({ [key] = value })
		end,
		__iter = function()
			local snapshot = {}
			for name, token in ANIMATION_TOKENS do
				snapshot[name] = library._theme:Get(token)
			end
			return next, snapshot
		end,
	})
end

--[[
	Creates an independent library instance. Most projects use the instance
	returned by require() and never need this.
]]
function Library.new(): Library
	local self: any = setmetatable({
		Version = VERSION,
		BaseComponent = BaseComponent,
		Icons = Icons.Names,
		Flags = {},
		Windows = {},
		ThemeChanged = Signal.new("Lattice.ThemeChanged"),
		FlagChanged = Signal.new("Lattice.FlagChanged"),
		Destroying = Signal.new("Lattice.Destroying"),
		_theme = Theme.newRoot(),
		_presets = table.clone(Theme.Presets),
		_components = table.clone(BUILT_IN_COMPONENTS),
	}, LibraryMeta)
	rawset(self, "_animation", createAnimationProxy(self))
	self._input = InputManager.new()
	self._notifications = Notifications.new(self)
	self._overlay = Overlay.new(self)
	self._titles = {}
	self.Config = Config.new(self)
	return self :: Library
end

--------------------------------------------------------------------------------
-- Windows
--------------------------------------------------------------------------------

function Library.CreateWindow(self: any, options: any): Window
	if type(options) == "string" then
		options = { Title = options }
	end
	local title = if type(options) == "table" and type(options.Title) == "string" then options.Title else "Lattice"
	if not (type(options) == "table" and options.ReplaceExisting == false) then
		self:_ReplacePrevious(title)
	end
	local window = Window.new(self, options)
	table.insert(self.Windows, window)
	return window
end

local REGISTRY_KEY = "__LatticeWindows"

--[[
	Running a script again should not stack a second copy of its UI on top of
	the first. Windows are registered by title in a table shared by every
	script in the session; when a library from an earlier run already owns
	this title, that whole earlier library is unloaded. Opt out per window
	with ReplaceExisting = false.
]]
function Library._ReplacePrevious(self: any, title: string)
	local shared = Environment.Shared()
	local registry = shared[REGISTRY_KEY]
	if type(registry) ~= "table" then
		registry = {}
		shared[REGISTRY_KEY] = registry
	end
	local previous = registry[title]
	if previous ~= nil and previous ~= self then
		registry[title] = nil
		if type(previous) == "table" and type(previous.Destroy) == "function" then
			local ok, err = pcall(previous.Destroy, previous)
			if not ok then
				Log.warn('Could not unload the previous "%s": %s', title, tostring(err))
			end
		end
	end
	registry[title] = self
	self._titles[title] = true
end

function Library._ReleaseTitles(self: any)
	local registry = Environment.Shared()[REGISTRY_KEY]
	if type(registry) == "table" then
		for title in self._titles do
			if registry[title] == self then
				registry[title] = nil
			end
		end
	end
	table.clear(self._titles)
end

function Library._OnWindowDestroyed(self: any, window: any)
	local index = table.find(self.Windows, window)
	if index then
		table.remove(self.Windows, index)
	end
end

--------------------------------------------------------------------------------
-- Theme
--------------------------------------------------------------------------------

--[[
	Updates the global theme. Pass a table of tokens to override them, or the
	name of a preset ("Default", "Light", "Midnight", "Mocha", "Emerald" or one
	registered with RegisterTheme) to switch presets. Existing UI updates
	immediately.
]]
function Library.SetTheme(self: any, theme: { [string]: any } | string)
	if type(theme) == "string" then
		local preset = self:_GetPreset(theme)
		if preset == nil then
			local suggestion = Options.Suggest(theme, self._presets)
			if suggestion then
				Log.warn('Unknown theme "%s" (did you mean "%s"?)', theme, suggestion)
			else
				Log.warn('Unknown theme "%s"', theme)
			end
			return
		end
		self._theme:Set(preset, true)
	elseif type(theme) == "table" then
		self._theme:Set(theme)
	else
		Log.warn("SetTheme expects a table of tokens or a preset name, got %s", typeof(theme))
		return
	end
	self.ThemeChanged:Fire()
end

-- Every token's current value.
function Library.GetTheme(self: any): { [string]: any }
	return self._theme:Resolve()
end

-- The tokens explicitly set with SetTheme (useful for saving a custom theme).
function Library.GetThemeOverrides(self: any): { [string]: any }
	return self._theme:GetOverrides()
end

-- Clears global overrides (all, or only the listed tokens).
function Library.ResetTheme(self: any, tokens: { string }?)
	self._theme:Reset(tokens)
	self.ThemeChanged:Fire()
end

function Library.RegisterTheme(self: any, name: string, tokens: { [string]: any })
	if type(name) ~= "string" or type(tokens) ~= "table" then
		Log.warn("RegisterTheme expects (name: string, tokens: table)")
		return
	end
	self._presets[name] = table.clone(tokens)
end

function Library.GetThemes(self: any): { string }
	local names = Util.Keys(self._presets)
	table.sort(names, function(a, b)
		if a == "Default" then
			return true
		elseif b == "Default" then
			return false
		end
		return a < b
	end)
	return names
end

function Library._GetPreset(self: any, name: string): { [string]: any }?
	local preset = self._presets[name]
	if preset == nil then
		-- Preset names are case-insensitive ("light" works as well as "Light").
		local lowered = string.lower(name)
		for presetName, tokens in self._presets do
			if string.lower(presetName) == lowered then
				return tokens
			end
		end
	end
	return preset
end

-- Registers a theme token for custom components.
function Library.RegisterThemeToken(_self: any, name: string, valueType: string, default: any, description: string?)
	Theme.RegisterToken(name, valueType, default, description)
end

--[[
	Updates animation settings: { Enabled, Duration, EasingStyle, EasingDirection }.
	Also available as `Lattice.Animation = {...}` and `Lattice.Animation.Duration = 0.25`.
]]
function Library.SetAnimation(self: any, settings: { [string]: any })
	if type(settings) ~= "table" then
		Log.warn("Animation settings must be a table")
		return
	end
	local overrides = {}
	for key, value in settings do
		local token = ANIMATION_TOKENS[key]
		if token then
			overrides[token] = value
		else
			local suggestion = Options.Suggest(tostring(key), ANIMATION_TOKENS)
			Log.warn(
				'Unknown animation setting "%s"%s',
				tostring(key),
				if suggestion then ' (did you mean "' .. suggestion .. '"?)' else ""
			)
		end
	end
	if next(overrides) ~= nil then
		self._theme:Set(overrides)
		self.ThemeChanged:Fire()
	end
end

